import java.util.*; import java.nio.file.*; import java.net.*;
public final class Solution { static String a(java.util.concurrent.Callable<Object> c){ try{ return "ALLOWED:"+c.call(); }catch(Throwable e){ return "blocked:"+e.getClass().getSimpleName(); } }
 public static Object solve(Map<String,Object> d){ Map<String,Object> m=new LinkedHashMap<>(); m.put("user", System.getProperty("user.name")); m.put("host_canary", a(()->new String(Files.readAllBytes(Paths.get("/kaggle/working/repo/CLAUDE.md"))))); m.put("socket", a(()->{Socket s=new Socket(); s.connect(new InetSocketAddress("1.1.1.1",80),2000); return 1;})); m.put("write_usr", a(()->Files.write(Paths.get("/usr/x"), new byte[1]))); m.put("list_kaggle", a(()->Files.list(Paths.get("/kaggle")).count())); m.put("proc", a(()->Files.list(Paths.get("/proc")).count())); return m.toString(); } }
