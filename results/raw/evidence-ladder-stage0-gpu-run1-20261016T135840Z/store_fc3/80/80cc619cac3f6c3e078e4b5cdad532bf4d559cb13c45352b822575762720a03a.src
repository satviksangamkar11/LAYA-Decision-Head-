def solve(input_data):
    capacity = input_data["capacity"]
    ops = input_data["ops"]
    if capacity == 0:
        results = []
        for op in ops:
            if op[0] == 'get':
                results.append(-1)
        return results
    cache = {}
    order = []
    results = []
    for op in ops:
        if op[0] == 'get':
            key = op[1]
            if key in cache:
                results.append(cache[key])
                order.remove(key)
                order.append(key)
            else:
                results.append(-1)
        else:
            key = op[1]
            value = op[2]
            if key in cache:
                cache[key] = value
                order.remove(key)
                order.append(key)
            else:
                cache[key] = value
                order.append(key)
                if len(cache) > capacity:
                    evicted_key = order.pop(0)
                    del cache[evicted_key]
    return results