public class ShiftText {
    public static String shiftText(String text, int shift) {
        StringBuilder result = new StringBuilder();
        for (char c : text.toCharArray()) {
            if (Character.isUpperCase(c)) {
                int offset = c - 'A';
                int newOffset = (offset + shift) % 26;
                if (newOffset < 0) {
                    newOffset += 26;
                }
                newOffset %= 26;
                result.append((char) ('A' + newOffset));
            } else if (Character.isLowerCase(c)) {
                int offset = c - 'a';
                int newOffset = (offset + shift) % 26;
                if (newOffset < 0) {
                    newOffset += 26;
                }
                newOffset %= 26;
                result.append((char) ('a' + newOffset));
            } else {
                result.append(c);
            }
        }
        return result.toString();
    }

    public static void main(String[] args) {
        System.out.println(shiftText("Abc Zz!", 2));
        System.out.println(shiftText("xyz XYZ", -1));
        System.out.println(shiftText("123 äΩ", 26));
        System.out.println(shiftText("A", 1000));
    }
}