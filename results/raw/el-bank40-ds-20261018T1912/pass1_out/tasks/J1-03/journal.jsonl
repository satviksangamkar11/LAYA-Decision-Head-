{"data": {"id": "ee2605120591924393a13b4bd867653aebf39a82f9f74d762daff37aa77e8ab8", "lineage": "ee2605120591924393a13b4bd867653aebf39a82f9f74d762daff37aa77e8ab8", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        long n = ((Number) data.get(\"n\")).longValue();\n        if (n < 10) {\n            return 0;\n        }\n        int count = 0;\n        long current = n;\n        while (current >= 10) {\n            long product = 1;\n            String numStr = Long.toString(current);\n            for (int i = 0; i < numStr.length(); i++) {\n                char c = numStr.charAt(i);\n                int digit = c - '0';\n                product *= digit;\n            }\n            current = product;\n            count++;\n        }\n        return count;\n    }\n}"}, "kind": "candidate", "prev": "45317f5d3ac9bbecb7020bcdce413c787e15e7977cdcbf455508b6a11cc9be65", "seq": 6}
