{"data": {"id": "ce53c939a93ae75319cceeb298d6f316d62c025f7e07ce989b787f8480a16907", "lineage": "ce53c939a93ae75319cceeb298d6f316d62c025f7e07ce989b787f8480a16907", "origin": "sample:2", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        Number nVal = (Number) data.get(\"n\");\n        long n = nVal.longValue();\n        return countSteps(n);\n    }\n\n    private static int countSteps(long n) {\n        if (n < 10) {\n            return 0;\n        }\n        int steps = 0;\n        while (n >= 10) {\n            steps++;\n            n = productOfDigits(n);\n        }\n        return steps;\n    }\n\n    private static long productOfDigits(long num) {\n        long product = 1;\n        while (num > 0) {\n            int digit = (int) (num % 10);\n            product *= digit;\n            num /= 10;\n        }\n        return product;\n    }\n}"}, "kind": "candidate", "prev": "f52f6dcebe89e70ddcfda8f38996e1e308d2118d380d3ec845ad03ba0dae9549", "seq": 14}
