def solve(data):
    nums = data['nums']
    if not nums:
        return []
    result = []
    start = nums[0]
    end = nums[0]
    for i in range(1, len(nums)):
        if nums[i] == end + 1:
            end = nums[i]
        else:
            result.append([start, end])
            start = nums[i]
            end = nums[i]
    result.append([start, end])
    return result