{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 156, "char_start": 0, "quote": "Input {\"ip\": canonical dotted-decimal IPv4 address, \"prefix\": integer 0..32}. Return normalized network address as \"a.b.c.d/prefix\" after zeroing host bits.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 226, "char_start": 168, "quote": "Input:\n{\"ip\": \"10.17.2.9\", \"prefix\": 8}\nOutput:\n10.0.0.0/8", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 304, "char_start": 238, "quote": "Input:\n{\"ip\": \"192.168.2.15\", \"prefix\": 24}\nOutput:\n192.168.2.0/24", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 371, "char_start": 316, "quote": "Input:\n{\"ip\": \"1.2.3.4\", \"prefix\": 0}\nOutput:\n0.0.0.0/0", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 456, "char_start": 383, "quote": "Input:\n{\"ip\": \"255.255.255.255\", \"prefix\": 32}\nOutput:\n255.255.255.255/32", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "d21f41a1837be327a0d8968bab192999b7911182b8a9674bc13fddcc222305cd", "stop": null}, "kind": "requirements", "prev": "fd954f2874a9f228f590978a707a0df17b904065fefed0257b1e977f0da600de", "seq": 2}
