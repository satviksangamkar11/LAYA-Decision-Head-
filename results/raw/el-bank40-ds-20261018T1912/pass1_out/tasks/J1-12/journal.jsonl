{"data": {"id": "8c5d3ad4d11b66f7e0406d87d9157c759567fcc94d7de8dcd2f68b4dc09db25b", "lineage": "8c5d3ad4d11b66f7e0406d87d9157c759567fcc94d7de8dcd2f68b4dc09db25b", "origin": "sample:3", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static String solve(Map<String, Object> data) {\n        String ip = (String) data.get(\"ip\");\n        int prefix = ((Number) data.get(\"prefix\")).intValue();\n        \n        String[] parts = ip.split(\"\\\\.\");\n        int a = Integer.parseInt(parts[0]);\n        int b = Integer.parseInt(parts[1]);\n        int c = Integer.parseInt(parts[2]);\n        int d = Integer.parseInt(parts[3]);\n        \n        int ipInt = (a << 24) | (b << 16) | (c << 8) | d;\n        \n        int mask = 0xFFFFFFFF << (32 - prefix);\n        int network = ipInt & mask;\n        \n        int a1 = (network >> 24) & 0xFF;\n        int b1 = (network >> 16) & 0xFF;\n        int c1 = (network >> 8) & 0xFF;\n        int d1 = network & 0xFF;\n        \n        return String.format(\"%d.%d.%d.%d/%d\", a1, b1, c1, d1, prefix);\n    }\n}"}, "kind": "candidate", "prev": "270a5aac37b6e2ebedc485d6ecc577c4e4f0d1cc29a23959235243c7bdd31a37", "seq": 22}
