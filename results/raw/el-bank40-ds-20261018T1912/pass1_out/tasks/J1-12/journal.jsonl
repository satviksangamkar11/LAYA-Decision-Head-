{"data": {"id": "72543c618fabf180cac11775aab4f35e656cdce869a8a52b0acac89451f7a9ac", "lineage": "72543c618fabf180cac11775aab4f35e656cdce869a8a52b0acac89451f7a9ac", "origin": "sample:2", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String ipStr = (String) data.get(\"ip\");\n        int prefix = ((Number) data.get(\"prefix\")).intValue();\n        \n        String[] parts = ipStr.split(\"\\\\.\");\n        int[] octets = new int[4];\n        for (int i = 0; i < 4; i++) {\n            octets[i] = Integer.parseInt(parts[i]);\n        }\n        \n        int ipInt = (octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3];\n        \n        int mask = 0xFFFFFFFF << (32 - prefix);\n        int networkAddress = ipInt & mask;\n        \n        int b0 = (networkAddress >> 24) & 0xFF;\n        int b1 = (networkAddress >> 16) & 0xFF;\n        int b2 = (networkAddress >> 8) & 0xFF;\n        int b3 = networkAddress & 0xFF;\n        \n        return String.format(\"%d.%d.%d.%d/%d\", b0, b1, b2, b3, prefix);\n    }\n}"}, "kind": "candidate", "prev": "da67311531b94749abafe917a49e249d70f73d42d9e8ec7c8b086b1c333af911", "seq": 14}
