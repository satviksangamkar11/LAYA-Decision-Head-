{"data": {"id": "7a044efa0cab2290fe193e25ffda4e55922a0307029cf8dd697cf95943ee49a0", "lineage": "7a044efa0cab2290fe193e25ffda4e55922a0307029cf8dd697cf95943ee49a0", "origin": "sample:4", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String ipStr = (String) data.get(\"ip\");\n        int prefix = ((Number) data.get(\"prefix\")).intValue();\n        \n        String[] parts = ipStr.split(\"\\\\.\");\n        int ip1 = Integer.parseInt(parts[0]);\n        int ip2 = Integer.parseInt(parts[1]);\n        int ip3 = Integer.parseInt(parts[2]);\n        int ip4 = Integer.parseInt(parts[3]);\n        \n        int ipInt = (ip1 << 24) | (ip2 << 16) | (ip3 << 8) | ip4;\n        \n        int shift = 32 - prefix;\n        int mask = (0xFFFFFFFF >>> shift) << shift;\n        int networkInt = ipInt & mask;\n        \n        int a = (networkInt >> 24) & 0xFF;\n        int b = (networkInt >> 16) & 0xFF;\n        int c = (networkInt >> 8) & 0xFF;\n        int d = networkInt & 0xFF;\n        \n        return String.format(\"%d.%d.%d.%d/%d\", a, b, c, d, prefix);\n    }\n}"}, "kind": "candidate", "prev": "1c44240abd8b490868dc3859a094d078bf1e16bb3907885a09dfc5e9edef4ee6", "seq": 30}
