{"data": {"id": "f26c6dae7122a43a6bba70d061d335373b4cc52a860d824ed6f63750f5a256a1", "lineage": "f26c6dae7122a43a6bba70d061d335373b4cc52a860d824ed6f63750f5a256a1", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static String solve(Map<String, Object> data) {\n        String ipStr = (String) data.get(\"ip\");\n        int prefix = ((Number) data.get(\"prefix\")).intValue();\n\n        String[] parts = ipStr.split(\"\\\\.\");\n        int a = Integer.parseInt(parts[0]);\n        int b = Integer.parseInt(parts[1]);\n        int c = Integer.parseInt(parts[2]);\n        int d = Integer.parseInt(parts[3]);\n\n        int ipInt = (a << 24) | (b << 16) | (c << 8) | d;\n\n        int mask = (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF;\n        int networkInt = ipInt & mask;\n\n        int a1 = (networkInt >> 24) & 0xFF;\n        int b1 = (networkInt >> 16) & 0xFF;\n        int c1 = (networkInt >> 8) & 0xFF;\n        int d1 = networkInt & 0xFF;\n\n        return String.format(\"%d.%d.%d.%d/%d\", a1, b1, c1, d1, prefix);\n    }\n}"}, "kind": "candidate", "prev": "66c7405583535e52e05aa9ff273bfeed2682e37d0886806fd22e23f3da66f2f4", "seq": 6}
