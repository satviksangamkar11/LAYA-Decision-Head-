{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 313, "char_start": 0, "quote": "Input {\"row\": one valid CSV record without embedded newlines}. Return list of fields. Comma separates unquoted fields; double quotes protect commas, and inside quoted fields two adjacent double quotes represent one literal double quote. Preserve leading/trailing spaces and empty fields; empty input returns [\"\"].", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 356, "char_start": 325, "quote": "Input:\n{\"row\": \"\"}\nOutput:\n[\"\"]", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 415, "char_start": 368, "quote": "Input:\n{\"row\": \"a,b,c\"}\nOutput:\n[\"a\", \"b\", \"c\"]", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 475, "char_start": 427, "quote": "Input:\n{\"row\": \"\\\"a,b\\\",c\"}\nOutput:\n[\"a,b\", \"c\"]", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 550, "char_start": 487, "quote": "Input:\n{\"row\": \"\\\"ab\\\"\\\"cd\\\",,\\\"\\\"\"}\nOutput:\n[\"a