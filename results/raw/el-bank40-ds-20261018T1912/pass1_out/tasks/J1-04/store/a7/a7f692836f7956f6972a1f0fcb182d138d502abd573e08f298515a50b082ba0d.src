import java.util.*;

public final class Solution {
    public static Object solve(Map<String, Object> data) {
        int n = ((Number) data.get("n")).intValue();
        List<Map.Entry<Integer, String>> roman = List.of(
            Map.entry(1000, "M"),
            Map.entry(900, "CM"),
            Map.entry(500, "D"),
            Map.entry(400, "CD"),
            Map.entry(100, "C"),
            Map.entry(90, "XC"),
            Map.entry(50, "L"),
            Map.entry(40, "XL"),
            Map.entry(10, "X"),
            Map.entry(9, "IX"),
            Map.entry(5, "V"),
            Map.entry(4, "IV"),
            Map.entry(1, "I")
        );
        StringBuilder sb = new StringBuilder();
        for (Map.Entry<Integer, String> entry : roman) {
            int value = entry.getKey();
            while (n >= value) {
                sb.append(entry.getValue());
                n -= value;
            }
        }
        return sb.toString();
    }
}