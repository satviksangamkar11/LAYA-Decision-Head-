import java.util.*;

public final class Solution {
    public static Object solve(Map<String, Object> data) {
        List<List<?>> matrix = (List<List<?>>) data.get("matrix");
        if (matrix == null || matrix.isEmpty()) {
            return new ArrayList<>();
        }
        int numColumns = matrix.get(0).size();
        List<List<Integer>> transposed = new ArrayList<>();
        for (int j = 0; j < numColumns; j++) {
            List<Integer> newRow = new ArrayList<>();
            for (int i = 0; i < matrix.size(); i++) {
                Number num = (Number) matrix.get(i).get(j);
                newRow.add(num.intValue());
            }
            transposed.add(newRow);
        }
        return transposed;
    }
}