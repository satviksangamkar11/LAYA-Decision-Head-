{"data": {"id": "29ced95c2bec55f62d3310c6711e72ad46f72122c0aa5121b55ccb00277f69c3", "lineage": "29ced95c2bec55f62d3310c6711e72ad46f72122c0aa5121b55ccb00277f69c3", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String text = (String) data.get(\"text\");\n        Number shiftNum = (Number) data.get(\"shift\");\n        int shift = shiftNum.intValue();\n        StringBuilder sb = new StringBuilder();\n        for (char c : text.toCharArray()) {\n            if (Character.isLetter(c)) {\n                if (Character.isUpperCase(c)) {\n                    int base = 'A';\n                    int offset = (c - base + shift) % 26;\n                    if (offset < 0) offset += 26;\n                    sb.append((char) (base + offset));\n                } else {\n                    int base = 'a';\n                    int offset = (c - base + shift) % 26;\n                    if (offset < 0) offset += 26;\n                    sb.append((char) (base + offset));\n                }\n            } else {\n                sb.append(c);\n            }\n        }\n        return sb.toString();\n    }\n}"}, "kind": "candidate", "prev": "0af27424dea815afc2870939a5b73c24e1f39967e4365838e9cd8f3a7a399dcb", "seq": 6}
