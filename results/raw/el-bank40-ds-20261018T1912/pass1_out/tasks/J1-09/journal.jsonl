{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 186, "char_start": 0, "quote": "Input {\"text\": string, \"shift\": integer -1000..1000}. Shift only ASCII letters cyclically by shift; preserve letter case and leave digits, punctuation and all other characters unchanged.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 252, "char_start": 198, "quote": "Input:\n{\"shift\": 2, \"text\": \"Abc Zz!\"}\nOutput:\nCde Bb!", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 319, "char_start": 264, "quote": "Input:\n{\"shift\": -1, \"text\": \"xyz XYZ\"}\nOutput:\nwxy WXY", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 384, "char_start": 331, "quote": "Input:\n{\"shift\": 26, \"text\": \"123 äΩ\"}\nOutput:\n123 äΩ", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 441, "char_start": 396, "quote": "Input:\n{\"shift\": 1000, \"text\": \"A\"}\nOutput:\nM", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the