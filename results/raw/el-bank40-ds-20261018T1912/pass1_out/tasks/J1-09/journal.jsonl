{"data": {"id": "91a36f33c76803898b79f4412d72374388d3ac0f667dce35ac481622707aadbf", "lineage": "91a36f33c76803898b79f4412d72374388d3ac0f667dce35ac481622707aadbf", "origin": "sample:3", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String text = (String) data.get(\"text\");\n        int shift = ((Number) data.get(\"shift\")).intValue();\n        StringBuilder result = new StringBuilder();\n        for (char c : text.toCharArray()) {\n            if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) {\n                int base = (c >= 'A') ? 'A' : 'a';\n                int currentPos = c - base;\n                int effectiveShift = (shift % 26 + 26) % 26;\n                int newPos = (currentPos + effectiveShift) % 26;\n                result.append((char) (base + newPos));\n            } else {\n                result.append(c);\n            }\n        }\n        return result.toString();\n    }\n}"}, "kind": "candidate", "prev": "0e463fc5bd7648cde91592c24e72883d8f222664975e475a3248e7f101ebc4c6", "seq": 22}
