{"data": {"id": "b1ff64cdeaf48a8163ff693f1ba057911f6fe3e9cc995128d35182a27730e621", "lineage": "b1ff64cdeaf48a8163ff693f1ba057911f6fe3e9cc995128d35182a27730e621", "origin": "sample:2", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String text = (String) data.get(\"text\");\n        int shiftValue = ((Number) data.get(\"shift\")).intValue();\n        int shiftMod = shiftValue % 26;\n        if (shiftMod < 0) shiftMod += 26;\n\n        StringBuilder result = new StringBuilder();\n        for (char c : text.toCharArray()) {\n            if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) {\n                if (c >= 'A' && c <= 'Z') {\n                    int pos = c - 'A';\n                    int new_pos = (pos + shiftMod) % 26;\n                    result.append((char) ('A' + new_pos));\n                } else {\n                    int pos = c - 'a';\n                    int new_pos = (pos + shiftMod) % 26;\n                    result.append((char) ('a' + new_pos));\n                }\n            } else {\n                result.append(c);\n            }\n        }\n        return result.toString();\n    }\n}"}, "kind": "candidate", "prev": "70ed7b60bc667656592346162f6fe6fe800f32692d3f1b735e649840b9de76ce", "seq": 14}
