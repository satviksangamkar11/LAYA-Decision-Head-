{"data": {"id": "73f0461dbbfc561f9c18a353252744c60cd631d75b36956b7e8385a22ef26bf7", "lineage": "73f0461dbbfc561f9c18a353252744c60cd631d75b36956b7e8385a22ef26bf7", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        Object gridObj = data.get(\"grid\");\n        if (gridObj == null || gridObj instanceof List && ((List<?>) gridObj).isEmpty()) {\n            return 0;\n        }\n        List<List<Number>> grid = (List<List<Number>>) gridObj;\n\n        int rows = grid.size();\n        if (rows == 0) {\n            return 0;\n        }\n        int cols = grid.get(0).size();\n\n        int[][] dp = new int[rows][cols];\n\n        for (int i = 0; i < rows; i++) {\n            for (int j = 0; j < cols; j++) {\n                Number cell = grid.get(i).get(j);\n                int cellValue = cell.intValue();\n                if (cellValue == 1) {\n                    dp[i][j] = 0;\n                } else {\n                    if (i == 0 && j == 0) {\n                        dp[i][j] = 1;\n                    } else {\n                        int top = (i > 0) ? dp[i-1][j] : 0;\n                        int left = (j > 0) ? dp[i][j-1] : 0;\n                        dp[i][j] = top + left;\n                    }\n                }\n            }\n        }\n        return dp[rows-1][cols-1];\n    }\n}"}, "kind": "candidate", "prev": "3e50c0f4e5d6a4ac9d3624bb0d38515ebebc38a7e46850db2f88767aaa31a6ba", "seq": 6}
