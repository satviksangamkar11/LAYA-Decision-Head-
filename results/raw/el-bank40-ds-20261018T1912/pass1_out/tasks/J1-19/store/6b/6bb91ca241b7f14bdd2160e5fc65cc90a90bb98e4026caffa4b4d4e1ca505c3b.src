import java.util.*;

public final class Solution {
    public static Object solve(Map<String, Object> data) {
        Object gridObj = data.get("grid");
        if (gridObj == null || gridObj instanceof List && ((List<?>) gridObj).isEmpty()) {
            return 0;
        }
        List<?> gridList = (List<?>) gridObj;
        int n = gridList.size();
        if (n == 0) {
            return 0;
        }
        List<?> firstRow = (List<?>) gridList.get(0);
        int m = firstRow.size();
        if (m == 0) {
            return 0;
        }
        Number startCell = (Number) gridList.get(0).get(0);
        if (startCell.intValue() == 1) {
            return 0;
        }
        Number endCell = (Number) gridList.get(n - 1).get(m - 1);
        if (endCell.intValue() == 1) {
            return 0;
        }
        int[][] dp = new int[n][m];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                Number cell = (Number) gridList.get(i).get(j);
                if (cell.intValue() == 1) {
                    dp[i][j] = 0;
                } else {
                    if (i == 0 && j == 0) {
                        dp[i][j] = 1;
                    } else {
                        int up = (i > 0) ? dp[i - 1][j] : 0;
                        int left = (j > 0) ? dp[i][j - 1] : 0;
                        dp[i][j] = up + left;
                    }
                }
            }
        }
        return dp[n - 1][m - 1];
    }
}