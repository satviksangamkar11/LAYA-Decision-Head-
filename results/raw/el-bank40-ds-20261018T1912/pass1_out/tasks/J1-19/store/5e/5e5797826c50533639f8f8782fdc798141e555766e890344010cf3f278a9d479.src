import java.util.*;

public final class Solution {
    public static Object solve(Map<String, Object> data) {
        Object gridObj = data.get("grid");
        if (gridObj == null || gridObj instanceof List<?> && ((List<?>) gridObj).isEmpty()) {
            return 0;
        }
        List<List<?>> grid = (List<List<?>>) gridObj;
        int rows = grid.size();
        if (rows == 0) {
            return 0;
        }
        int cols = grid.get(0).size();
        
        Number start = (Number) grid.get(0).get(0);
        if (start.intValue() == 1) {
            return 0;
        }
        
        int[][] dp = new int[rows][cols];
        dp[0][0] = 1;
        
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                if (i == 0 && j == 0) {
                    continue;
                }
                Number cell = (Number) grid.get(i).get(j);
                if (cell.intValue() == 1) {
                    dp[i][j] = 0;
                } else {
                    int top = (i > 0) ? dp[i-1][j] : 0;
                    int left = (j > 0) ? dp[i][j-1] : 0;
                    dp[i][j] = top + left;
                }
            }
        }
        return dp[rows-1][cols-1];
    }
}