import java.util.*;

public final class Solution {
    public static Object solve(Map<String, Object> data) {
        List<List<?>> gridList = (List<List<?>>) data.get("grid");
        if (gridList == null || gridList.isEmpty()) {
            return 0;
        }
        int rows = gridList.size();
        int cols = gridList.get(0).size();
        
        Number startVal = (Number) gridList.get(0).get(0);
        if (startVal.intValue() == 1) {
            return 0;
        }
        
        Number endVal = (Number) gridList.get(rows - 1).get(cols - 1);
        if (endVal.intValue() == 1) {
            return 0;
        }
        
        int[][] dp = new int[rows][cols];
        dp[0][0] = 1;
        
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                if (i == 0 && j == 0) {
                    continue;
                }
                Number cellVal = (Number) gridList.get(i).get(j);
                if (cellVal.intValue() == 1) {
                    dp[i][j] = 0;
                } else {
                    int top = (i > 0) ? dp[i - 1][j] : 0;
                    int left = (j > 0) ? dp[i][j - 1] : 0;
                    dp[i][j] = top + left;
                }
            }
        }
        return dp[rows - 1][cols - 1];
    }
}