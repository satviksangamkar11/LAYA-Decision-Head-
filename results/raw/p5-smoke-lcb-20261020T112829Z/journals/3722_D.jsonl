{"data": {"id": "3fe7868e39a3a522913c800df8296f9f2235f7bb636d31dd05ab2d0fadb7010e", "lineage": "3fe7868e39a3a522913c800df8296f9f2235f7bb636d31dd05ab2d0fadb7010e", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        n = len(nums)\n        if n < k * m:\n            return -inf\n        \n        dp = [[0] * (m+1) for _ in range(n)]\n        prefix_sum = [0]\n        for num in nums:\n            prefix_sum.append(prefix_sum[-1] + num)\n        \n        # Calculate prefix sums for each subarray of length m starting from index i\n        for i in range(m):\n            dp[i][1] = prefix_sum[i+m] - prefix_sum[i]\n        \n        # Fill the DP table\n        for i in range(m, n):\n            for j in range(2, min(k+1, m+1)):\n                dp[i][j] = max(dp[i-m][j-1] + prefix_sum[i+j] - prefix_sum[i], dp[i-1][j])\n        \n        return max(dp[n-1])"}, "kind": "candidate", "prev": "7d9d7e4cd158a7233f9416d440f5087fc74ae51c1a91bb8693527f2ae0d4d09d", "seq": 11}
