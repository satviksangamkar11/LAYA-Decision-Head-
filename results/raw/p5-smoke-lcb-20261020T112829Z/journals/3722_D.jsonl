{"data": {"id": "b49de2edcaf639bfcab14e4eacbe9cd1809dedfec58aab6c3c98167e549d8f09", "lineage": "b49de2edcaf639bfcab14e4eacbe9cd1809dedfec58aab6c3c98167e549d8f09", "origin": "sample:3", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        n = len(nums)\n        dp = [[0 for _ in range(k+1)] for _ in range(n+1)]\n        \n        # Base case: empty subarray\n        for i in range(1, n+1):\n            dp[i][0] = nums[i-1]\n        \n        # Fill the DP table\n        for i in range(1, n+1):\n            for j in range(1, min(k, i//m)+1):\n                if i < m*j:\n                    dp[i][j] = dp[i-1][j]\n                else:\n                    dp[i][j] = max(dp[i-m*j][j-1] + sum(nums[i-j*m:i]), dp[i-1][j])\n        \n        return dp[n][k]"}, "kind": "candidate", "prev": "dda9dc7ab1f7142e4498f03927aaa78ca8cd1572130c644b90db7fa0d1652f30", "seq": 16}
