{"data": {"id": "8cfb5359b10c925b056438649c2399def887965bc8e16875487937523d4eb239", "lineage": "8cfb5359b10c925b056438649c2399def887965bc8e16875487937523d4eb239", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        # Initialize variables\n        n = len(nums)\n        dp = [[0] * (k+1) for _ in range(n)]\n        prefix_sum = [0] * (n+1)\n        \n        # Calculate prefix sums\n        for i in range(1, n+1):\n            prefix_sum[i] = prefix_sum[i-1] + nums[i-1]\n        \n        # Fill the DP table\n        for i in range(1, n+1):\n            for j in range(1, min(k+1, i//m)+1):\n                if i < m*j:\n                    dp[i][j] = float('-inf')\n                else:\n                    dp[i][j] = max(dp[i-m*j][j-1] + prefix_sum[i]-prefix_sum[i-m*j], dp[i-1][j])\n        \n        return dp[n][k]"}, "kind": "candidate", "prev": "b8c1965436eb61fd683dd21d6f1ed440a8b5e2a6fe80fa83d94f3458f938d25b", "seq": 21}
