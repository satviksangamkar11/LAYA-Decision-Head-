{"data": {"id": "bad93385192239ea90f18a01c1e37c57789669a5e2fc77b1e5b7c270dea68bf7", "lineage": "bad93385192239ea90f18a01c1e37c57789669a5e2fc77b1e5b7c270dea68bf7", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        left = [float('inf')] * n\n        right = [float('inf')] * n\n        \n        # Find the first occurrence of each number\n        num_to_index = defaultdict(list)\n        for i in range(n):\n            num_to_index[nums[i]].append(i)\n        \n        # Calculate the leftmost occurrence for each number\n        for num in num_to_index:\n            for i in range(len(num_to_index[num])):\n                if i > 0:\n                    left[num_to_index[num][i]] = min(left[num_to_index[num][i]], num_to_index[num][i-1])\n        \n        # Calculate the rightmost occurrence for each number\n        for num in num_to_index:\n            for i in range(len(num_to_index[num])-1, -1, -1):\n                if i < len(num_to_index[num])-1:\n                    right[num_to_index[num][i]] = min(right[num_to_index[num][i]], num_to_index[num][i+1])\n        \n        # Find the closest occurrences for each query\n        result = []\n        for q in queries:\n            if q == 0:\n                result.append(min(left[q], right[q]))\n            elif q == n-1:\n                result.append(min(left[q], right[q]))\n            else:\n                result.append(min(left[q], right[q]), min(left[(q+n-1)%n], right[(q+n-1)%n]))\n        \n        return result"}, "kind": "candidate", "prev": "14093b03d2d0a105c89fa89b46728228f09da217326e4e6e2393fb17c7573b4c", "seq": 11}
