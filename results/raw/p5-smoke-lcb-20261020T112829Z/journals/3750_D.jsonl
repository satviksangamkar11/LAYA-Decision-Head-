{"data": {"n": 4, "prompt_sha": ["6dd5d6eec1e21cf12efe388ea14c32aca6bcf095d86876fa87d8f5786900bd1c"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "9250020cdb469961570de4656cccf02fa0b03087b898148ae7cec1aca4cd4955", "seq": 5}
{"data": {"id": "d9decca610882f7dc913067eb17793c940427fc0f9273b47810b1ff358ea9c3a", "lineage": "d9decca610882f7dc913067eb17793c940427fc0f9273b47810b1ff358ea9c3a", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        ans = [-1] * len(queries)\n        pos = {}\n        \n        # Create a dictionary to store the last occurrence of each number\n        for i in range(n):\n            if nums[i] not in pos:\n                pos[nums[i]] = i\n            else:\n                pos[nums[i]] = min(pos[nums[i]], i)\n                \n        # Iterate through each query\n        for i, q in enumerate(queries):\n            if q in pos:\n                # Calculate the distance from the current position to the last occurrence of the number\n                ans[i] = abs(q - pos[q])\n            else:\n                # If the number is not found, calculate the distances to the two closest occurrences\n                if q + 1 < n:\n                    ans[i] = abs(q - pos[nums[q + 1]])\n                if q - 1 >= 0:\n                    ans[i] = min(ans[i], abs(q - pos[nums[q - 1]]))\n                    \n        return ans"}, "kind": "candidate", "prev": "b6bae59bf062233a5ea6686ed4fadf252476ec88729ca4c029292bd933cc3e6f", "seq": 6}
