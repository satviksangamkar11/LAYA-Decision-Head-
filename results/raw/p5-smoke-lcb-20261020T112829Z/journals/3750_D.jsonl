{"data": {"id": "afe62d264319e22325d0185281ec6f3592891a0932d6685dbb05abcbdc73625c", "lineage": "afe62d264319e22325d0185281ec6f3592891a0932d6685dbb05abcbdc73625c", "origin": "sample:4", "parent": null, "source": "from typing import List\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        ans = []\n        \n        # Find the first occurrence of each number in nums\n        first_occurrence = {}\n        for i, num in enumerate(nums):\n            if num not in first_occurrence:\n                first_occurrence[num] = i\n        \n        # Iterate through each query\n        for q in queries:\n            # Check if the query value exists in nums\n            if q in first_occurrence:\n                # Calculate the distance from the current query position to the first occurrence\n                distance = abs(q - first_occurrence[q])\n                \n                # Handle circular array case\n                if q > first_occurrence[q]:\n                    distance += n - first_occurrence[q]\n                \n                ans.append(distance)\n            else:\n                ans.append(-1)\n        \n        return ans"}, "kind": "candidate", "prev": "c2dbf989396022316cc1123455648491dae6fa10f408c04674ed76616ff7533a", "seq": 21}
