{"data": {"id": "7d2ccdee4f4ab61865aa4615346b2716b2233e4cbc1a8716d9257cd27b3ac1a1", "lineage": "7d2ccdee4f4ab61865aa4615346b2716b2233e4cbc1a8716d9257cd27b3ac1a1", "origin": "sample:1", "parent": null, "source": "from typing import *\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        n = len(nums)\n        dp = [[0 for _ in range(n+1)] for _ in range(k+1)]\n        cur_sum = 0\n        \n        # Calculate the prefix sums\n        for i in range(1, n+1):\n            cur_sum += nums[i-1]\n            dp[1][i] = cur_sum\n            \n        # Fill the DP table\n        for i in range(2, k+1):\n            for j in range(m, n+1):\n                dp[i][j] = max(dp[i][j-m], dp[i-1][j-m] + cur_sum - dp[i-1][j])\n                \n        return dp[k][n]"}, "kind": "candidate", "prev": "09a6495af5e833662796c0c7f94bc6d0035ee66ee07f656d512b30779d9f94af", "seq": 6}
