{"data": {"id": "3b82ad1509ede3e77ac0a44137105299fadf1e49e65797603a6348ff20373086", "lineage": "7d2ccdee4f4ab61865aa4615346b2716b2233e4cbc1a8716d9257cd27b3ac1a1", "origin": "repair:7d2ccdee4f4ab61865aa4615346b2716b2233e4cbc1a8716d9257cd27b3ac1a1", "parent": "7d2ccdee4f4ab61865aa4615346b2716b2233e4cbc1a8716d9257cd27b3ac1a1", "source": "from typing import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        n = len(nums)\n        dp = [[0 for _ in range(n+1)] for _ in range(k+1)]\n        cur_sum = 0\n        \n        # Calculate the prefix sums\n        for i in range(1, n+1):\n            cur_sum += nums[i-1]\n            dp[1][i] = cur_sum\n        \n        # Fill the DP table\n        for i in range(2, k+1):\n            for j in range(m, n+1):\n                # Check if the current subarray can be extended to the next window\n                if j - m >= 0:\n                    dp[i][j] = max(dp[i][j], dp[i-1][j-m] + cur_sum - dp[i-1][j])\n                else:\n                    dp[i][j] = dp[i-1][j]\n        \n        return dp[k][n]"}, "kind": "candidate", "prev": "e5df90d667e792c16202a2de66cc3bdef8b6a3cff6c7a00b7dfac50d12d0f7f5", "seq": 39}
