{"data": {"id": "bf29f41d112e25dd073a5996ec37effd9899361b236628678cc1a1600707e83f", "lineage": "3fe7868e39a3a522913c800df8296f9f2235f7bb636d31dd05ab2d0fadb7010e", "origin": "repair:3fe7868e39a3a522913c800df8296f9f2235f7bb636d31dd05ab2d0fadb7010e", "parent": "3fe7868e39a3a522913c800df8296f9f2235f7bb636d31dd05ab2d0fadb7010e", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        n = len(nums)\n        if n < k * m:\n            return -inf\n        \n        dp = [[0] * (m+1) for _ in range(n)]\n        prefix_sum = [0]\n        for num in nums:\n            prefix_sum.append(prefix_sum[-1] + num)\n        \n        # Calculate prefix sums for each subarray of length m starting from index i\n        for i in range(min(n, m)):\n            dp[i][1] = prefix_sum[i+m] - prefix_sum[i]\n        \n        # Fill the DP table\n        for i in range(m, n):\n            for j in range(2, min(k+1, m+1)):\n                dp[i][j] = max(dp[i-m][j-1] + prefix_sum[i+j] - prefix_sum[i], dp[i-1][j])\n        \n        return max(dp[n-1])"}, "kind": "candidate", "prev": "c5c2caf86f135b752d4d5ac6f98af07f4839fe2afa2683d50eca027b3055bbcd", "seq": 29}
