{"data": {"evidence": {"artifact_hash": "bad93385192239ea90f18a01c1e37c57789669a5e2fc77b1e5b7c270dea68bf7", "candidate_id": "bad93385192239ea90f18a01c1e37c57789669a5e2fc77b1e5b7c270dea68bf7", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0006", "independence": "independent", "produced_at": "t6", "receipt_hash": "e4c799422fdb3aa93d574e978721a594a23e6a9a507b88a848f272f528c84f87", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "388b1b8eda39e18398a0eebbbaa27332316b4acf278a2faead3e1d691a09a8cb", "seq": 14}
