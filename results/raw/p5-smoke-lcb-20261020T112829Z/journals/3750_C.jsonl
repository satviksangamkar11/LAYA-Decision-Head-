{"data": {"id": "fdaab74cb339c8c17b7f0e60fb9295be88a5579cfa4f330c3bc1146576aa33ba", "lineage": "fdaab74cb339c8c17b7f0e60fb9295be88a5579cfa4f330c3bc1146576aa33ba", "origin": "sample:3", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        ans = [-1] * len(queries)\n        index_map = {}\n        \n        # Create a map to store the last occurrence of each number\n        for i in range(n):\n            if nums[i] not in index_map:\n                index_map[nums[i]] = i\n        \n        # Iterate through each query\n        for i in range(len(queries)):\n            num = queries[i]\n            \n            # Find the first occurrence of the number before or after the current position\n            left = index_map.get(num, -1)\n            right = index_map.get(num + n, -1)\n            \n            # Calculate the minimum distance\n            if left != -1 and right != -1:\n                ans[i] = min(abs(left - i), abs(right - i))\n            elif left != -1:\n                ans[i] = abs(left - i)\n            elif right != -1:\n                ans[i] = abs(right - i)\n        \n        return ans"}, "kind": "candidate", "prev": "caf5aa77c60b4b13e6e25c15a352e1b9ca68121a404b130b8090bec395a3fa6e", "seq": 16}
