{"data": {"id": "169e19e97b060877f6507c41e40f992ef95156b420582db3eefbab571a0fe287", "lineage": "169e19e97b060877f6507c41e40f992ef95156b420582db3eefbab571a0fe287", "origin": "sample:4", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        left, right = 0, 0\n        current_k = k\n        max_distance = 0\n        \n        for i in range(len(s)):\n            if s[i] == 'N':\n                right += 1\n            elif s[i] == 'S':\n                right -= 1\n            elif s[i] == 'E':\n                right += 1\n            else:\n                right -= 1\n                \n            current_k -= 1\n            \n            if current_k < 0:\n                while left <= i and current_k < 0:\n                    if s[left] == 'N':\n                        left += 1\n                    elif s[left] == 'S':\n                        left -= 1\n                    elif s[left] == 'E':\n                        left += 1\n                    else:\n                        left -= 1\n                    \n                    current_k += 1\n            \n            max_distance = max(max_distance, right)\n        \n        return max_distance"}, "kind": "candidate", "prev": "1d78034add1f39f65efff4e17808ed3ed90b6b5e668c9b5a7c5110f2ce517f0e", "seq": 21}
