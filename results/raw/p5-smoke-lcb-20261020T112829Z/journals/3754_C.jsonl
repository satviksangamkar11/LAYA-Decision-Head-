{"data": {"answer_label": "BLOCKED", "candidate_id": "40b5521b42e401bc5805be04a3e4c0a6bc59c760b6d20ebd78d986706460ca2c", "fails": 2, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED"}, "trusted_passes": 0, "validated_passes": 0}, "kind": "label", "prev": "d8adde5c84914b525430fee2cf50f5a7d31cda0dd0083a503f5db65a451998a9", "seq": 15}
{"data": {"id": "38ce451e515d780124621e737ceb6fabbe584c1451c70f261bff40317a8d90ac", "lineage": "38ce451e515d780124621e737ceb6fabbe584c1451c70f261bff40317a8d90ac", "origin": "sample:3", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[-1 for _ in range(n+1)] for _ in range(k+1)]\n        \n        # Initialize base case\n        dp[0][0] = 0\n        \n        # Fill the DP table\n        for i in range(1, k+1):\n            for j in range(1, n+1):\n                if s[j-1] == 'N':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j-1])\n                elif s[j-1] == 'S':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j+1])\n                elif s[j-1] == 'E':\n                    dp[i][j] = max(dp[i][j], dp[i][j-1])\n                elif s[j-1] == 'W':\n                    dp[i][j] = max(dp[i][j], dp[i][j+1])\n                else:\n                    dp[i][j] = dp[i][j-1]\n        \n        return dp[k][n]"}, "kind": "candidate", "prev": "062866ca2ed4ddb292ac7530696b5a6d6913d618f42911d5f6d96bfbfe0f5a3e", "seq": 16}
