{"data": {"id": "4c397f479126699bcdc2d9ebeb688c5172fdd31d73a1afe882c0127c5cb9d2ee", "lineage": "69836e1e3777a65bcb6e4f3ba137e8b01d2207a22aadb6e9c33bbfab638a35d6", "origin": "repair:69836e1e3777a65bcb6e4f3ba137e8b01d2207a22aadb6e9c33bbfab638a35d6", "parent": "69836e1e3777a65bcb6e4f3ba137e8b01d2207a22aadb6e9c33bbfab638a35d6", "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            if s[i] == 'N':\n                prefix_sum[i+1] = prefix_sum[i] + 1\n            elif s[i] == 'S':\n                prefix_sum[i+1] = prefix_sum[i] - 1\n        \n        ans = 0\n        left = 0\n        right = 0\n        total_moves = 0\n        \n        while right < n:\n            # Update total moves\n            if s[right] == 'N':\n                total_moves += 1\n            elif s[right] == 'S':\n                total_moves -= 1\n            \n            # Shrink the window if total moves exceed k\n            while total_moves > k:\n                if s[left] == 'N':\n                    total_moves -= 1\n                elif s[left] == 'S':\n                    total_moves += 1\n                left += 1\n            \n            # Calculate the maximum distance\n            ans = max(ans, right - left + 1)\n            right += 1\n        \n        return ans"}, "kind": "candidate", "prev": "07dcaa8ca4bac66aaa615655a651772972d8482be65359c52d3b0e3dbea66ca8", "seq": 29}
