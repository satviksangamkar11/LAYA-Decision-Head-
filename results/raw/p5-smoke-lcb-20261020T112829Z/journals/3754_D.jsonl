{"data": {"evidence": {"artifact_hash": "40b5521b42e401bc5805be04a3e4c0a6bc59c760b6d20ebd78d986706460ca2c", "candidate_id": "40b5521b42e401bc5805be04a3e4c0a6bc59c760b6d20ebd78d986706460ca2c", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0006", "independence": "independent", "produced_at": "t6", "receipt_hash": "703ec9b4f9a94be84eecf9dc7ca6c6e4b0899c1ce251ea61639e0a9433b4810a", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "a064714b40fc68f9d03d4277da927b7fbef8443b96dee2e86b9a30309a0f57f6", "seq": 14}
{"data": {"answer_label": "BLOCKED", "candidate_id": "40b5521b42e401bc5805be04a3e4c0a6bc59c760b6d20ebd78d986706460ca2c", "fails": 2, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED"}, "trusted_passes": 0, "validated_passes": 0}, "kind": "label", "prev": "0dc0af1a98f83c267a1e30c91f7ed342a8e7208270e1f913102985c329c52418", "seq": 15}
{"data": {"id": "38ce451e515d780124621e737ceb6fabbe584c1451c70f261bff40317a8d90ac", "lineage": "38ce451e515d780124621e737ceb6fabbe584c1451c70f261bff40317a8d90ac", "origin": "sample:3", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[-1 for _ in range(n+1)] for _ in range(k+1)]\n        \n        # Initialize base case\n        dp[0][0] = 0\n        \n        # Fill the DP table\n        for i in range(1, k+1):\n            for j in range(1, n+1):\n                if s[j-1] == 'N':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j-1])\n                elif s[j-1] == 'S':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j+1])\n                elif s[j-1] == 'E':\n                    dp[i][j] = max(dp[i][j], dp[i][j-1])\n                elif s[j-1] == 'W':\n                    dp[i][j] = max(dp[i][j], dp[i][j+1])\n                else:\n                    dp[i][j] = dp[i][j-1]\n        \n        return dp[k][n]"}, "kind": "candidate", "prev": "defff3fa012422c07178c41c55d2f82bc499c66c70ccd6a6b4d09e3269771622", "seq": 16}
