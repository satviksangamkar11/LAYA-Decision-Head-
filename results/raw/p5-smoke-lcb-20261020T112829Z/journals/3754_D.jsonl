{"data": {"id": "69836e1e3777a65bcb6e4f3ba137e8b01d2207a22aadb6e9c33bbfab638a35d6", "lineage": "69836e1e3777a65bcb6e4f3ba137e8b01d2207a22aadb6e9c33bbfab638a35d6", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            if s[i] == 'N':\n                prefix_sum[i+1] = prefix_sum[i] + 1\n            elif s[i] == 'S':\n                prefix_sum[i+1] = prefix_sum[i] - 1\n        \n        ans = 0\n        left = 0\n        right = 0\n        while right < n:\n            while right < n and prefix_sum[right] - prefix_sum[left] > k:\n                left += 1\n            \n            ans = max(ans, right - left)\n            right += 1\n        \n        return ans"}, "kind": "candidate", "prev": "db334a6f3b13a2c96fc50be07a7207c781f0e6e02af7a5081f78b251fb5cdb08", "seq": 6}
