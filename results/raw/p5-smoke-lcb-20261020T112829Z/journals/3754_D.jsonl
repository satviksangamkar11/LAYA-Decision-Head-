{"data": {"id": "40b5521b42e401bc5805be04a3e4c0a6bc59c760b6d20ebd78d986706460ca2c", "lineage": "40b5521b42e401bc5805be04a3e4c0a6bc59c760b6d20ebd78d986706460ca2c", "origin": "sample:2", "parent": null, "source": "from collections import Counter\n\nclass Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        count = Counter()\n        left, right = 0, 0\n        max_distance = 0\n        \n        for right in range(n):\n            count[s[right]] += 1\n            \n            # Check if we have more than k moves remaining\n            if right - left + 1 > k:\n                count[s[left]] -= 1\n                left += 1\n            \n            # Calculate the current Manhattan distance\n            current_distance = right - left\n            max_distance = max(max_distance, current_distance)\n        \n        return max_distance"}, "kind": "candidate", "prev": "699499ff434ceab570f8e6513620d5633219b1d7076d99bc663e7e1ead9004c1", "seq": 11}
