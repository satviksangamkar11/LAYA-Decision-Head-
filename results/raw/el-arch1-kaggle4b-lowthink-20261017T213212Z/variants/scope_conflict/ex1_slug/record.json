  "test_cmd": "python3 test_slug.py",
  "protected": [
   "test_slug.py"
  ],
  "max_steps": 2,
  "scope": [
   "slug.py"
  ],
  "files": {
   "slug.py": "import re\r\n\r\n\r\ndef slugify(text):\r\n    text = text.strip().lower()\r\n    return re.sub(r\"[^a-z0-9]+\", \"-\", text)\r\n",
   "test_slug.py": "from slug import slugify\r\n\r\nassert slugify(\"Hello, World!\") == \"hello-world\", slugify(\"Hello, World!\")\r\nassert slugify(\"  A--B  \") == \"a-b\", slugify(\"  A--B  \")\r\nassert slugify(\"\") == \"\"\r\nprint(\"all tests passed\")\r\n"
  }
 },
