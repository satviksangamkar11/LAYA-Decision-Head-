{"data": {"answer_label": "SUPPORTED", "candidate_id": "6f75130d2eca81ce72fc023e9a0046a6b02777294312a530bd3e79f04e5ee9ee", "fails": 0, "rows": {"R1": "SUPPORTED", "R2": "SUPPORTED", "R3": "VERIFIED", "R4": "VERIFIED", "R5": "VERIFIED", "R6": "VERIFIED"}, "trusted_passes": 4, "validated_passes": 2}, "kind": "label", "prev": "fde319e7b17042e521fba9eeafc40ba760c9290c3cd3311d4c1c14e3359c0bc9", "seq": 21}
{"data": {"id": "89f40bfe6032854b2e2432f47be56e63e91fddc50c0caff657d35705466aebd7", "lineage": "89f40bfe6032854b2e2432f47be56e63e91fddc50c0caff657d35705466aebd7", "origin": "sample:3", "parent": null, "source": "def solve(data):\n    pattern = data[\"pattern\"]\n    text = data[\"text\"]\n    \n    # Initialize the DP table\n    m = len(pattern)\n    n = len(text)\n    dp = [[False] * (n+1) for _ in range(m+1)]\n    \n    # Base case: Empty pattern matches empty text\n    dp[0][0] = True\n    \n    # Fill the DP table\n    for i in range(1, m+1):\n        if pattern[i-1] == '*':\n            dp[i][0] = dp[i-1][0]\n        else:\n            break\n    \n    for j in range(1, n+1):\n        for i in range(1, m+1):\n            if pattern[i-1] == text[j-1]:\n                dp[i][j] = dp[i-1][j-1]\n            elif pattern[i-1] == '?':\n                dp[i][j] = dp[i-1][j-1]\n            elif pattern[i-1] == '*':\n                dp[i][j] = dp[i-1][j] or dp[i][j-1]\n    \n    return dp[m][n]\n\n# Test cases\nprint(solve({\"pattern\": \"*\", \"text\": \"\"}))  # true\nprint(solve({\"pattern\": \"a?\", \"text\": \"ab\"}))  # true\nprint(solve({\"pattern\": \"a*f\", \"text\": \"abcdef\"}))  # true\nprint(solve({\"pattern\": \"a*d\", \"text\": \"abc\"}))  # false"}, "kind": "candidate", "prev": "1602a0fe6c5b17c97b1c4566b1b8e8bdd8a3fad5c7583c6f9bf5f8cc5f04a25e", "seq": 22}
