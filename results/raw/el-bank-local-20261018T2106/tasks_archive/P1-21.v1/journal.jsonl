{"data": {"answer_label": "SUPPORTED", "candidate_id": "89f40bfe6032854b2e2432f47be56e63e91fddc50c0caff657d35705466aebd7", "fails": 0, "rows": {"R1": "SUPPORTED", "R2": "SUPPORTED", "R3": "VERIFIED", "R4": "VERIFIED", "R5": "VERIFIED", "R6": "VERIFIED"}, "trusted_passes": 4, "validated_passes": 2}, "kind": "label", "prev": "91eb25c4960e7ef7e6558e03371fe796d29b594b649e1a9ad9ffd2edc4c14221", "seq": 29}
{"data": {"id": "1ab7a778f592712d578b11409b39e2e476ff6d6994ce335cc2b9005ce6e17f97", "lineage": "1ab7a778f592712d578b11409b39e2e476ff6d6994ce335cc2b9005ce6e17f97", "origin": "sample:4", "parent": null, "source": "import json\n\ndef solve(data):\n    pattern = data['pattern']\n    text = data['text']\n\n    def match(i, j):\n        if i == len(pattern) and j == len(text):\n            return True\n        if i < len(pattern) and j == len(text):\n            return False\n        if pattern[i] == '?' or pattern[i] == text[j]:\n            return match(i+1, j+1)\n        if pattern[i] == '*':\n            return match(i+1, j) or (j < len(text) and match(i, j+1))\n        return False\n\n    return match(0, 0)\n\n# Test cases\ntest_cases = [\n    {\"input\": {\"pattern\": \"*\", \"text\": \"\"}, \"expected\": True},\n    {\"input\": {\"pattern\": \"a?\", \"text\": \"ab\"}, \"expected\": True},\n    {\"input\": {\"pattern\": \"a*f\", \"text\": \"abcdef\"}, \"expected\": True},\n    {\"input\": {\"pattern\": \"a*d\", \"text\": \"abc\"}, \"expected\": False},\n]\n\nfor tc in test_cases:\n    result = solve(tc[\"input\"])\n    assert result == tc[\"expected\"], f\"Failed for {tc}: expected {tc['expected']}, got {result}\"\nprint(\"All tests passed!\")"}, "kind": "candidate", "prev": "58fc43d5c29fc22c89be36d1f0928ae99a67c3490b3572d6879a7d98f5193504", "seq": 30}
