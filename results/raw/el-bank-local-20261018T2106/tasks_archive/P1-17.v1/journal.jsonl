{"data": {"id": "59b13353f46fb1f0577bcff7a32b50b8b7dd31026d5b76358f421ac92a6ccadb", "lineage": "59b13353f46fb1f0577bcff7a32b50b8b7dd31026d5b76358f421ac92a6ccadb", "origin": "sample:1", "parent": null, "source": "from collections import defaultdict\nimport heapq\n\ndef solve(data):\n    n = data[\"n\"]\n    edges = data[\"edges\"]\n    source = data[\"source\"]\n    target = data[\"target\"]\n\n    # Build adjacency list representation of the graph\n    graph = defaultdict(list)\n    for u, v in edges:\n        graph[u].append(v)\n\n    # Initialize distance array with infinity\n    dist = [float('inf')] * n\n    dist[source] = 0\n\n    # Priority queue to store nodes to visit\n    pq = [(0, source)]\n\n    while pq:\n        current_dist, current_node = heapq.heappop(pq)\n\n        if current_node == target:\n            return current_dist\n\n        for neighbor in graph[current_node]:\n            new_dist = current_dist + 1\n            if new_dist < dist[neighbor]:\n                dist[neighbor] = new_dist\n                heapq.heappush(pq, (new_dist, neighbor))\n\n    return -1"}, "kind": "candidate", "prev": "0ac3ac556a0919b0948b04c14a873c6ebdbcc3d8d4b152dbcfff2f99688fba64", "seq": 6}
