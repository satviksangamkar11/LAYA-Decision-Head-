{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 114, "char_start": 0, "quote": "Input {\"nums\": int list}. Return length of a strictly increasing subsequence, not necessarily contiguous; [] -> 0.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 155, "char_start": 126, "quote": "Input:\n{\"nums\": []}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 203, "char_start": 167, "quote": "Input:\n{\"nums\": [7, 7, 7]}\nOutput:\n1", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 270, "char_start": 215, "quote": "Input:\n{\"nums\": [10, 9, 2, 5, 3, 7, 101, 18]}\nOutput:\n4", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 323, "char_start": 282, "quote": "Input:\n{\"nums\": [-2, -1, 0, 1]}\nOutput:\n4", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "07f014638c0d18f823948c14b221c181402272ac579e52b6555d9b5302abd461", "stop": null}, "ki