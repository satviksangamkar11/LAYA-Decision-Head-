{"data": {"evidence": {"artifact_hash": "7fb2a1a82a57e7d2f1a2c344c6ac7af46f1150f5054832d9d607bc99996af60c", "candidate_id": "7fb2a1a82a57e7d2f1a2c344c6ac7af46f1150f5054832d9d607bc99996af60c", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-845f3092080a", "evidence_id": "E0012", "independence": "user_provided", "produced_at": "t12", "receipt_hash": "5957aee2fd9e3587081fe1285a12e91d4e8633c237a2507699dbbd85e52b5080", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "request_example", "status": "pass"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "pass"}}, "kind": "evidence", "prev": "c292f41a256efd439282d73ce7f23b9bfb66eff982d7678d13f0096d3d34065c", "seq": 20}
