{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 140, "char_start": 0, "quote": "Input {\"n\": positive integer, \"edges\": [u,v] directed edges, \"source\": node, \"target\": node}. Nodes 0..n-1. Return minimum edge count or -1.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 216, "char_start": 152, "quote": "Input:\n{\"edges\": [], \"n\": 1, \"source\": 0, \"target\": 0}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 306, "char_start": 228, "quote": "Input:\n{\"edges\": [[0, 1], [1, 2]], \"n\": 3, \"source\": 0, \"target\": 2}\nOutput:\n2", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 389, "char_start": 318, "quote": "Input:\n{\"edges\": [[1, 0]], \"n\": 3, \"source\": 0, \"target\": 1}\nOutput:\n-1", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 487, "char_start": 401, "quote": "Input:\n{\"edges\": [[0, 1], [1, 2], [0, 2]], \"n\": 4, \"source\": 0, \"target\": 2}\nOutput:\n1", "type": "request_span"}, "status": "active", "text":