{"data": {"answer_label": "BLOCKED", "candidate_id": "10217768d3995b01c8a35a785e866461476f18222f492633fbebb6f902b4377a", "fails": 3, "rows": {"R1": "SUPPORTED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED", "R5": "VERIFIED", "R6": "FAILED"}, "trusted_passes": 1, "validated_passes": 1}, "kind": "label", "prev": "2829078395474d6ca9e1ee96b0fd42a032e454200f2ad11aef0cc5700f2805f9", "seq": 29}
{"data": {"id": "7c80d947a3bb1149887f34c9e670b462137cd0ea9755092cebf24a59c89df226", "lineage": "7c80d947a3bb1149887f34c9e670b462137cd0ea9755092cebf24a59c89df226", "origin": "sample:4", "parent": null, "source": "from typing import List\n\ndef solve(data):\n    n = data['n']\n    edges = data['edges']\n    source = data['source']\n    target = data['target']\n\n    # Edge cases: empty graph or single vertex\n    if not edges or n == 1:\n        return 0 if source == target else -1\n\n    # Brute-force approach: try all possible paths from source to target\n    def dfs(node, visited):\n        if node == target:\n            return 0\n        visited.add(node)\n        min_path = float('inf')\n        for neighbor in range(n):\n            if neighbor != node and neighbor not in visited:\n                path_length = dfs(neighbor, visited)\n                if path_length != float('inf') and path_length + 1 < min_path:\n                    min_path = path_length + 1\n        visited.remove(node)\n        return min_path if min_path != float('inf') else float('inf')\n\n    min_distance = dfs(source, set())\n    return min_distance if min_distance != float('inf') else -1\n\n# Test cases\ntest_cases = [\n    {\"edges\": [], \"n\": 1, \"source\": 0, \"target\": 0},\n    {\"edges\": [[0, 1], [1, 2]], \"n\": 3, \"source\": 0, \"target\": 2},\n    {\"edges\": [[1, 0]], \"n\": 3, \"source\": 0, \"target\": 1},\n    {\"edges\": [[0, 1], [1, 2], [0, 2]], \"n\": 4, \"source\": 0, \"target\": 2}\n]\n\nfor test_case in test_cases:\n    result = solve(test_case)\n    assert result == test_case['expected_output'], f\"Test failed for input {test_case}. Expected {test_case['expected_output']}, got {result}\"\nprint(\"All tests passed!\")"}, "kind": "candidate", "prev": "6749fb0f7bed75e5367f876d009134a4e56a378223d623b71415a63b234c83d5", "seq": 30}
