{"data": {"id": "10217768d3995b01c8a35a785e866461476f18222f492633fbebb6f902b4377a", "lineage": "10217768d3995b01c8a35a785e866461476f18222f492633fbebb6f902b4377a", "origin": "sample:3", "parent": null, "source": "def solve(data):\n    edges = data[\"edges\"]\n    n = data[\"n\"]\n    source = data[\"source\"]\n    target = data[\"target\"]\n\n    # Check if the graph has no edges\n    if len(edges) == 0:\n        return -1\n\n    # Check if there is only one node\n    if n == 1:\n        return 0\n\n    # Check if the source and target are the same node\n    if source == target:\n        return 1\n\n    # Initialize the visited set and the edge count\n    visited = set()\n    edge_count = 0\n\n    def dfs(node):\n        nonlocal edge_count\n        if node == target:\n            return True\n        if node in visited:\n            return False\n        visited.add(node)\n        for neighbor in range(n):\n            if neighbor != node and (neighbor, node) in edges:\n                if dfs(neighbor):\n                    edge_count += 1\n                    return True\n        return False\n\n    # Perform DFS starting from the source\n    if not dfs(source):\n        return -1\n\n    return edge_count"}, "kind": "candidate", "prev": "df14637f2013c5b033589655b63cd3b9a116871a62ffa3fc6c17c00657b939db", "seq": 22}
