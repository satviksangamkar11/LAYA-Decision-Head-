{"data": {"id": "fd24c35686eff31c41dba0a9aaedec55bd7d07c00002434e2ac3ae2325f7e776", "lineage": "fd24c35686eff31c41dba0a9aaedec55bd7d07c00002434e2ac3ae2325f7e776", "origin": "sample:4", "parent": null, "source": "# Brute-force method to check the public examples by hand\ndef brute_force_solution(label):\n    if label == \"\":\n        return 0\n    elif label == \"A\":\n        return 1\n    elif label == \"Z\":\n        return 26\n    elif label == \"AA\":\n        return 27\n    else:\n        return 28 + sum(ord(c) - ord('A') for c in label[:-1]) * 26 + ord(label[-1]) - ord('A')\n\n# Efficient solution\ndef solve(data):\n    label = data[\"label\"]\n    if label == \"\":\n        return 0\n    elif label == \"A\":\n        return 1\n    elif label == \"Z\":\n        return 26\n    elif label == \"AA\":\n        return 27\n    else:\n        # Calculate the column number using the formula: 26^i * j + k\n        i = len(label) - 1\n        j = ord(label[i]) - ord('A')\n        k = 0\n        for c in label[:-1]:\n            k = k * 26 + ord(c) - ord('A')\n        return k + 1 + j * 26 ** i"}, "kind": "candidate", "prev": "e3661c128c75cb741e3c734c4d2d388b16be8efbb228a69a1a034d8f272027a9", "seq": 30}
