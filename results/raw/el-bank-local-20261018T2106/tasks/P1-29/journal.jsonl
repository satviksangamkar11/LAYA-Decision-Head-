{"data": {"id": "94c7aace523489bec238f9950f32a94c1657bd7119c63e84d6ddb3a6aa644bc2", "lineage": "94c7aace523489bec238f9950f32a94c1657bd7119c63e84d6ddb3a6aa644bc2", "origin": "sample:1", "parent": null, "source": "import heapq\n\ndef solve(data):\n    nums = data['nums']\n    k = data['k']\n    \n    # Count occurrences of each number\n    num_counts = {}\n    for num in nums:\n        if num in num_counts:\n            num_counts[num] += 1\n        else:\n            num_counts[num] = 1\n    \n    # Convert count to negative so we can use heapq to find the kth smallest\n    neg_num_counts = {num: -count for num, count in num_counts.items()}\n    \n    # Use heapq to find the kth smallest element (in terms of negative counts)\n    kth_smallest = heapq.nsmallest(k, neg_num_counts.keys())[0]\n    \n    return kth_smallest"}, "kind": "candidate", "prev": "a0dd1d12e9d93be35be692af698efb07a7de323ff62dd8967ebfbd7be4aaa73d", "seq": 6}
