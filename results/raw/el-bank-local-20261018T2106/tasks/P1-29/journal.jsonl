{"data": {"id": "344b252617a5f90f82da5c166db0151d716e1e8bcf811c9b8ff66203c6dc6acf", "lineage": "344b252617a5f90f82da5c166db0151d716e1e8bcf811c9b8ff66203c6dc6acf", "origin": "sample:2", "parent": null, "source": "import heapq\n\ndef solve(data):\n    nums = data['nums']\n    k = data['k']\n    \n    # Use a min heap to keep track of the top k elements\n    min_heap = []\n    \n    for num in nums:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heappop(min_heap)\n            heapq.heappush(min_heap, num)\n    \n    return min_heap[0]"}, "kind": "candidate", "prev": "59fde5b28f2cc9962c80b87aa4a8190d82f21af801c0cfeff4247d885199cd8f", "seq": 14}
