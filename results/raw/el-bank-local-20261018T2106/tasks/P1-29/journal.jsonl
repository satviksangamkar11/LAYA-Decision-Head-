{"data": {"id": "1f688385d1127828356c7178f0cdff48e386ad28cc2e6297176de175255c9051", "lineage": "1f688385d1127828356c7178f0cdff48e386ad28cc2e6297176de175255c9051", "origin": "sample:3", "parent": null, "source": "import heapq\n\ndef solve(data):\n    k = data['k']\n    nums = data['nums']\n\n    # Use a min-heap with size k to keep track of the k largest elements\n    min_heap = []\n    for num in nums:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heappop(min_heap)\n            heapq.heappush(min_heap, num)\n\n    # The kth largest element is at the root of the heap\n    return min_heap[0]"}, "kind": "candidate", "prev": "05214cddaf4db7b5fad3e461d322c3036d05ff4d2372516c04f5b5c7601954c0", "seq": 22}
