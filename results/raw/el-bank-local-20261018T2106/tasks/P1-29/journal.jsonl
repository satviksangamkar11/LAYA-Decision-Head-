{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 127, "char_start": 0, "quote": "Input {\"nums\": nonempty int list, \"k\": int between 1 and len(nums)}. Return kth largest element counting duplicate occurrences.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 177, "char_start": 139, "quote": "Input:\n{\"k\": 1, \"nums\": [1]}\nOutput:\n1", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 233, "char_start": 189, "quote": "Input:\n{\"k\": 2, \"nums\": [5, 5, 1]}\nOutput:\n5", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 292, "char_start": 245, "quote": "Input:\n{\"k\": 3, \"nums\": [-1, -4, 0]}\nOutput:\n-4", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 351, "char_start": 304, "quote": "Input:\n{\"k\": 3, \"nums\": [8, 2, 9, 4]}\nOutput:\n4", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "e80eb5c414e8e5865f9a864744beb33c3c85e3191eddb4a