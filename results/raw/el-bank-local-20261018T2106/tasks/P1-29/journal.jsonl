{"data": {"id": "60506800ad904212ccd4494528ef92604000b1ff5a2fd63d79c8cc6f34c7277a", "lineage": "60506800ad904212ccd4494528ef92604000b1ff5a2fd63d79c8cc6f34c7277a", "origin": "sample:4", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> int:\n    nums = data['nums']\n    k = data['k']\n\n    # Edge case: empty array or k > length of array\n    if not nums or k > len(nums):\n        return None\n\n    # Count occurrences of each number\n    num_counts = {}\n    for num in nums:\n        if num in num_counts:\n            num_counts[num] += 1\n        else:\n            num_counts[num] = 1\n\n    # Find the kth largest element considering duplicates\n    max_heap = []\n    for num, count in num_counts.items():\n        if len(max_heap) < k:\n            heapq.heappush(max_heap, (-count, num))\n        elif count > -max_heap[0][0]:\n            heapq.heapreplace(max_heap, (-count, num))\n\n    # If there are fewer than k unique numbers, return the smallest number among them\n    if len(max_heap) < k:\n        return min(num_counts.keys())\n\n    # Otherwise, return the top element of the heap (which is the kth largest)\n    return -max_heap[0][0]"}, "kind": "candidate", "prev": "3527c5aa750fa744ee5e05eebe2a1aba7a08cdc4db65bfd294bb1e3e915cda6d", "seq": 30}
