{"data": {"id": "ef7900c7bcd6bccce28b46948c465019b468bc502015265ca0874f86d944d0a9", "lineage": "ef7900c7bcd6bccce28b46948c465019b468bc502015265ca0874f86d944d0a9", "origin": "sample:3", "parent": null, "source": "from collections import defaultdict\n\ndef solve(data):\n    n = data['n']\n    edges = data['edges']\n\n    # Check if there is a cycle in the graph\n    graph = defaultdict(list)\n    for u, v in edges:\n        graph[u].append(v)\n\n    visited = set()\n    stack = []\n    has_cycle = False\n\n    def dfs(node):\n        nonlocal has_cycle\n        if node in visited:\n            has_cycle = True\n            return\n        visited.add(node)\n        stack.append(node)\n        for neighbor in graph[node]:\n            dfs(neighbor)\n        if has_cycle:\n            return\n        stack.pop()\n\n    for i in range(n):\n        if i not in visited:\n            dfs(i)\n\n    if has_cycle:\n        return []\n\n    # Construct the topological order\n    topological_order = []\n    while stack:\n        topological_order.append(stack.pop())\n\n    return topological_order"}, "kind": "candidate", "prev": "739c9e179eba7605ca8102408c5ad02f162ac9ad05b008c9df023d73cd529230", "seq": 22}
