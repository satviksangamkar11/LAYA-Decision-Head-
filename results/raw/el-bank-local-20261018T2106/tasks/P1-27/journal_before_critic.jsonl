{"data": {"n": 4, "prompt_sha": ["2405665b8d36f178351e35687c956c9cb7b299e50c2ca69fe54c8259e20fb597", "a8a1f708d7ff7ecffa159c0ed47cc0fccf47aa73ecf86eecaf3bdabf8deee706"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["qwen_sample_v2", "qwen_sample_v2b"]}, "kind": "generation_request", "prev": "fa2e54993ace468d891d4010c098a1e60c6b5b6db7dd0de688ad33e10ce6e60e", "seq": 5}
{"data": {"id": "41f4bdc93de10bf604aa21b314361fd15fa8e33351ce141215ed6241d1a73c7a", "lineage": "41f4bdc93de10bf604aa21b314361fd15fa8e33351ce141215ed6241d1a73c7a", "origin": "sample:1", "parent": null, "source": "from collections import defaultdict\n\ndef solve(data):\n    n = data['n']\n    edges = data['edges']\n\n    # Build the graph\n    graph = defaultdict(list)\n    for u, v in edges:\n        graph[u].append(v)\n\n    # Topological sort using Kahn's algorithm\n    indegree = [0] * n\n    queue = []\n    topo_order = []\n\n    # Calculate in-degree of each vertex\n    for u in range(n):\n        for v in graph[u]:\n            indegree[v] += 1\n\n    # Add vertices with zero in-degree to the queue\n    for i in range(n):\n        if indegree[i] == 0:\n            queue.append(i)\n\n    # Perform topological sorting\n    while queue:\n        u = queue.pop(0)\n        topo_order.append(u)\n\n        # Decrease in-degree of adjacent vertices\n        for v in graph[u]:\n            indegree[v] -= 1\n            if indegree[v] == 0:\n                queue.append(v)\n\n    # If there is a cycle, return []\n    if len(topo_order) != n:\n        return []\n\n    return topo_order"}, "kind": "candidate", "prev": "d87b8f33b6ddbd1459ea6b3095857689b4147a4b5d368f6f8798e188d515b62f", "seq": 6}
