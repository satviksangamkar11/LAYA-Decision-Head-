{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 250, "char_start": 0, "quote": "Input {\"n\": nonnegative int, \"edges\": directed prerequisite edges [u,v]}. Return lexicographically smallest topological ordering of all nodes 0..n-1, or [] on a cycle. Duplicate edges allowed. Order is numeric by node id (node 10 comes after node 9).", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 301, "char_start": 262, "quote": "Input:\n{\"edges\": [], \"n\": 0}\nOutput:\n[]", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 384, "char_start": 313, "quote": "Input:\n{\"edges\": [[0, 2], [1, 2], [2, 3]], \"n\": 4}\nOutput:\n[0, 1, 2, 3]", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 449, "char_start": 396, "quote": "Input:\n{\"edges\": [[0, 1], [1, 0]], \"n\": 2}\nOutput:\n[]", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 521, "char_start": 461, "quote": "Input:\n{\"edges\": [[0, 2], [0, 2]], \"n\": 3}\nOutput:\n[0, 1, 2]", "type": "request_span"}, "status": "ac