{"data": {"id": "f80efb6145eb76358a831b70f57b61e08a46c68b1dfadf7f5e6d4ca29d902c8a", "lineage": "f80efb6145eb76358a831b70f57b61e08a46c68b1dfadf7f5e6d4ca29d902c8a", "origin": "sample:2", "parent": null, "source": "from collections import defaultdict\n\ndef solve(data):\n    n = data['n']\n    edges = data['edges']\n\n    # Create an adjacency list representation of the graph\n    adj_list = defaultdict(list)\n    for u, v in edges:\n        adj_list[u].append(v)\n\n    # Topological sort using Kahn's algorithm\n    indegree = [0] * n\n    for u in range(n):\n        for v in adj_list[u]:\n            indegree[v] += 1\n\n    queue = []\n    for i in range(n):\n        if indegree[i] == 0:\n            queue.append(i)\n\n    result = []\n    while queue:\n        u = queue.pop(0)\n        result.append(u)\n        for v in adj_list[u]:\n            indegree[v] -= 1\n            if indegree[v] == 0:\n                queue.append(v)\n\n    if len(result) != n:\n        return []\n\n    return result"}, "kind": "candidate", "prev": "619566e5f21b3f5409c9ab716efe552c554a9a5bc6fdbcc91fd699258543eec2", "seq": 14}
