{"data": {"id": "519f448816477f9ef49e12f95f70c5a8a88e5aa0222e108680f7f5beb4826449", "lineage": "519f448816477f9ef49e12f95f70c5a8a88e5aa0222e108680f7f5beb4826449", "origin": "sample:2", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> int:\n    nums = data[\"nums\"]\n    \n    # Handle edge cases where all numbers are negative or zero\n    if len(nums) == 0:\n        return 0\n    \n    max_product = min_product = result = nums[0]\n    \n    for num in nums[1:]:\n        # Swap max_product and min_product when necessary to handle negative numbers\n        if num < 0:\n            max_product, min_product = min_product, max_product\n        \n        # Update max_product and min_product\n        max_product = max(num, max_product * num)\n        min_product = min(num, min_product * num)\n        \n        # Update result with the maximum product found so far\n        result = max(result, max_product)\n    \n    return result"}, "kind": "candidate", "prev": "f979f9b95818c41001ec05f25ea360a9bc604cfc92193f1a6ad110ce613e85ee", "seq": 14}
