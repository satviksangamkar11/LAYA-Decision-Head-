{"data": {"id": "810deb1b34df247d6375526c80b9da5d99a5e19c65aee34d9b4ace7501b73adc", "lineage": "810deb1b34df247d6375526c80b9da5d99a5e19c65aee34d9b4ace7501b73adc", "origin": "sample:3", "parent": null, "source": "import json\n\ndef solve(data):\n    nums = data['nums']\n    \n    if not nums:\n        return 1\n    \n    max_product = min_product = result = nums[0]\n    \n    for num in nums[1:]:\n        if num > 0:\n            max_product, min_product = max(num, max_product * num), min(num, min_product * num)\n        else:\n            max_product, min_product = min(num, max_product * num), max(num, min_product * num)\n        \n        result = max(result, max_product)\n    \n    return result\n\n# Example usage\nprint(solve({\"nums\": [-1]}))  # Output: -1\nprint(solve({\"nums\": [2, 3, -2, 4]}))  # Output: 6\nprint(solve({\"nums\": [-2, 0, -1]}))  # Output: 0\nprint(solve({\"nums\": [-2, 3, -4]}))  # Output: 24"}, "kind": "candidate", "prev": "d0bee1c4adfb354091eb087b85b9748996d45d09236e46a39552ee4a63ab77ce", "seq": 22}
