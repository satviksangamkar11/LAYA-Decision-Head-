{"data": {"id": "6aaed2f4738bd3feee18cb4daf9931a6997b9d6a025828a395163c07ad314734", "lineage": "6aaed2f4738bd3feee18cb4daf9931a6997b9d6a025828a395163c07ad314734", "origin": "sample:1", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> List[int]:\n    temps = data['temps']\n    n = len(temps)\n    result = [0] * n\n    \n    # Initialize stack with indices of temperatures\n    stack = []\n    \n    for i in range(n):\n        while stack and temps[i] > temps[stack[-1]]:\n            j = stack.pop()\n            result[j] = i - j\n        stack.append(i)\n    \n    return result"}, "kind": "candidate", "prev": "d222f1915b8161afcf224324472293002e3b3f249bcf96bdd18519de3521c73a", "seq": 6}
