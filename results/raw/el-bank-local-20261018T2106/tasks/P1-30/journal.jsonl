{"data": {"id": "5910f9c2a5625d91a4c20d26a381168631dbd85d04f30605f91ab9197ff8ebcd", "lineage": "5910f9c2a5625d91a4c20d26a381168631dbd85d04f30605f91ab9197ff8ebcd", "origin": "sample:4", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> List[int]:\n    temps = data['temps']\n    \n    # Edge cases: empty or minimal inputs\n    if not temps:\n        return []\n    \n    # Initialize the result array with zeros\n    res = [0] * len(temps)\n    \n    # Iterate through the temperatures from right to left\n    for i in range(len(temps) - 2, -1, -1):\n        # If the current temperature is less than the next temperature\n        if temps[i] < temps[i + 1]:\n            # Set the result for this position to 1\n            res[i] = 1\n    \n    # Check for strictly warmer temperatures to the right\n    stack = []\n    for i in range(len(temps)):\n        while stack and temps[stack[-1]] < temps[i]:\n            index = stack.pop()\n            res[index] = i - index\n        stack.append(i)\n    \n    return res"}, "kind": "candidate", "prev": "0143427e20c32f978ab58a8cf8ffd4ef3ec68561484ba49cd8663cbcd9163924", "seq": 30}
