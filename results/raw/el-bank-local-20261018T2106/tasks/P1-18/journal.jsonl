{"data": {"id": "8a70e8d1c48e466fe08df791340ea8fb2a2d2017d3a5128c4134129838b7e551", "lineage": "8a70e8d1c48e466fe08df791340ea8fb2a2d2017d3a5128c4134129838b7e551", "origin": "sample:1", "parent": null, "source": "from typing import List\n\ndef solve(data):\n    coins = data[\"coins\"]\n    amount = data[\"amount\"]\n\n    if amount == 0:\n        return 0\n\n    dp = [float('inf')] * (amount + 1)\n    dp[0] = 0\n\n    for coin in coins:\n        for i in range(coin, amount + 1):\n            dp[i] = min(dp[i], dp[i - coin] + 1)\n\n    return dp[-1] if dp[-1] != float('inf') else -1"}, "kind": "candidate", "prev": "64a5468564f49d4255275b75605e975459b40d27498b2a4fad07b98879b85966", "seq": 6}
