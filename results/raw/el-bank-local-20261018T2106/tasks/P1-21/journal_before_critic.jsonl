{"data": {"answer_label": "SUPPORTED", "candidate_id": "6f75130d2eca81ce72fc023e9a0046a6b02777294312a530bd3e79f04e5ee9ee", "fails": 0, "rows": {"R1": "SUPPORTED", "R2": "SUPPORTED", "R3": "VERIFIED", "R4": "VERIFIED", "R5": "VERIFIED", "R6": "VERIFIED"}, "trusted_passes": 4, "validated_passes": 2}, "kind": "label", "prev": "a0067ff88e8e868e543c6e6015037babe2c9e74757b9787fdb2bc575a9c0862b", "seq": 21}
{"data": {"id": "89f40bfe6032854b2e2432f47be56e63e91fddc50c0caff657d35705466aebd7", "lineage": "89f40bfe6032854b2e2432f47be56e63e91fddc50c0caff657d35705466aebd7", "origin": "sample:3", "parent": null, "source": "def solve(data):\n    pattern = data[\"pattern\"]\n    text = data[\"text\"]\n    \n    # Initialize the DP table\n    m = len(pattern)\n    n = len(text)\n    dp = [[False] * (n+1) for _ in range(m+1)]\n    \n    # Base case: Empty pattern matches empty text\n    dp[0][0] = True\n    \n    # Fill the DP table\n    for i in range(1, m+1):\n        if pattern[i-1] == '*':\n            dp[i][0] = dp[i-1][0]\n        else:\n            break\n    \n    for j in range(1, n+1):\n        for i in range(1, m+1):\n            if pattern[i-1] == text[j-1]:\n                dp[i][j] = dp[i-1][j-1]\n            elif pattern[i-1] == '?':\n                dp[i][j] = dp[i-1][j-1]\n            elif pattern[i-1] == '*':\n                dp[i][j] = dp[i-1][j] or dp[i][j-1]\n    \n    return dp[m][n]\n\n# Test cases\nprint(solve({\"pattern\": \"*\", \"text\": \"\"}))  # true\nprint(solve({\"pattern\": \"a?\", \"text\": \"ab\"}))  # true\nprint(solve({\"pattern\": \"a*f\", \"text\": \"abcdef\"}))  # true\nprint(solve({\"pattern\": \"a*d\", \"text\": \"abc\"}))  # false"}, "kind": "candidate", "prev": "cbe39bb54a6d94eccecbb4c8ac618e44ce457157798d2d942c9cd2c69cb8bbca", "seq": 22}
