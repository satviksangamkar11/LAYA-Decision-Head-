{"data": {"id": "5e37947ee7db4c1b767900b1f011117cc911b047daa69f076f649f934ed73da9", "lineage": "5e37947ee7db4c1b767900b1f011117cc911b047daa69f076f649f934ed73da9", "origin": "sample:1", "parent": null, "source": "class LRUCache:\n    def __init__(self, capacity):\n        self.cache = {}\n        self.capacity = capacity\n        self.mru = []\n    \n    def put(self, key, value):\n        if key not in self.cache:\n            if len(self.cache) >= self.capacity:\n                del self.cache[self.mru.pop(0)]\n            self.mru.append(key)\n        self.cache[key] = value\n    \n    def get(self, key):\n        if key in self.cache:\n            self.mru.remove(key)\n            self.mru.append(key)\n            return self.cache[key]\n        else:\n            return -1\n\ndef solve(data):\n    cache = LRUCache(data['capacity'])\n    for op, key, value in data['ops']:\n        if op == 'put':\n            cache.put(key, value)\n        elif op == 'get':\n            result = cache.get(key)\n            return [result]\n    return []\n\n# Test cases\nprint(solve({\"capacity\": 0, \"ops\": [[\"put\", 1, 2], [\"get\", 1]]}))  # [-1]\nprint(solve({\"capacity\": 1, \"ops\": [[\"put\", 1, 4], [\"put\", 2, 5], [\"get\", 1], [\"get\", 2]]}))  # [-1, 5]\nprint(solve({\"capacity\": 2, \"ops\": [[\"put\", 1, 1], [\"put\", 2, 2], [\"get\", 1], [\"put\", 3, 3], [\"get\", 2]]}))  # [1, -1]\nprint(solve({\"capacity\": 2, \"ops\": []}))  # []"}, "kind": "candidate", "prev": "9ea2ef80c74cfd4f2f298d4dc4a3a6765908ea8a113f90ed216d3a948033d8d6", "seq": 6}
