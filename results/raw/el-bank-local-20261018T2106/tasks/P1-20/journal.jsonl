{"data": {"id": "153842a158bd99f718b5a1bc8c1ec34fb876e600a89e3f6dcbaeed99a7f7e49d", "lineage": "153842a158bd99f718b5a1bc8c1ec34fb876e600a89e3f6dcbaeed99a7f7e49d", "origin": "sample:4", "parent": null, "source": "from collections import OrderedDict\n\ndef solve(data):\n    capacity = data['capacity']\n    ops = data['ops']\n\n    if capacity == 0:\n        return []\n\n    cache = OrderedDict()\n    results = []\n\n    for op_type, key, value in ops:\n        if op_type == 'put':\n            if key not in cache:\n                cache[key] = value\n            else:\n                cache.move_to_end(key)\n            if len(cache) > capacity:\n                cache.popitem(last=False)\n        elif op_type == 'get':\n            if key in cache:\n                cache.move_to_end(key)\n                results.append(cache[key])\n            else:\n                results.append(-1)\n\n    return results"}, "kind": "candidate", "prev": "0eec9a8a511071611b780e1fe0d2eb974db2b996a37373cf916909629b79b2a1", "seq": 30}
