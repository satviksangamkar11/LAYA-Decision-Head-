{"data": {"id": "1c82e8052a3a7e40f1edf3c7c37e6be8ebf2af1d0719acd9d67da2c9a5c34f23", "lineage": "1c82e8052a3a7e40f1edf3c7c37e6be8ebf2af1d0719acd9d67da2c9a5c34f23", "origin": "sample:2", "parent": null, "source": "from collections import OrderedDict\n\ndef solve(data):\n    capacity = data[\"capacity\"]\n    ops = data[\"ops\"]\n    \n    if capacity == 0:\n        return []\n    \n    cache = OrderedDict()\n    result = []\n    \n    for op, key, value in ops:\n        if op == \"put\":\n            if key in cache:\n                del cache[key]\n            cache[key] = value\n            if len(cache) > capacity:\n                cache.popitem(last=False)\n        elif op == \"get\":\n            result.append(cache.get(key, -1))\n    \n    return result"}, "kind": "candidate", "prev": "e680f251b548ee1d2e570c0e94ca7dc38c885654106f70da22cd0019abed09bf", "seq": 14}
