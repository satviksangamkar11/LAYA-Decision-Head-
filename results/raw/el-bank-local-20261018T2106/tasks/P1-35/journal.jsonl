{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 115, "char_start": 0, "quote": "Input {\"heights\": list of nonnegative ints}. Return total water units trapped between histogram bars of unit width.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 159, "char_start": 127, "quote": "Input:\n{\"heights\": []}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 237, "char_start": 171, "quote": "Input:\n{\"heights\": [0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]}\nOutput:\n6", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 297, "char_start": 249, "quote": "Input:\n{\"heights\": [4, 2, 0, 3, 2, 5]}\nOutput:\n9", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 348, "char_start": 309, "quote": "Input:\n{\"heights\": [1, 2, 3]}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "86c070e6efe2c2bdcf631ef3f83e7f64d0407bf56db446eeb87dfcc1fbb6