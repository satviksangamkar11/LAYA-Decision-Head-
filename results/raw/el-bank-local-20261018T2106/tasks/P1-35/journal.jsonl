{"data": {"id": "14c7ec590ac0a99b923025956fe06faa11aa5cd82c8c2fb86dd78b1c236b2878", "lineage": "14c7ec590ac0a99b923025956fe06faa11aa5cd82c8c2fb86dd78b1c236b2878", "origin": "sample:4", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> int:\n    heights = data['heights']\n    \n    if not heights:\n        return 0\n    \n    # Initialize left and right pointers and max heights\n    left, right = 0, len(heights) - 1\n    max_left_height, max_right_height = heights[left], heights[right]\n    trapped_water = 0\n    \n    while left < right:\n        if max_left_height <= max_right_height:\n            # Move the left pointer to the right\n            left += 1\n            max_left_height = max(max_left_height, heights[left])\n            trapped_water += max_left_height - heights[left]\n        else:\n            # Move the right pointer to the left\n            right -= 1\n            max_right_height = max(max_right_height, heights[right])\n            trapped_water += max_right_height - heights[right]\n    \n    return trapped_water"}, "kind": "candidate", "prev": "e6aabefa098737f709cd3cb46709d6470689604c25eb4d89e02c5afa78857488", "seq": 30}
