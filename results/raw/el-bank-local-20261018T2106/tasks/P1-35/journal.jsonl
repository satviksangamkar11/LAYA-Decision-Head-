{"data": {"id": "859a8564768e939dd6cf32a9aec7bc241b2ae1ccbcaa12c09d8a54cae907f4e5", "lineage": "859a8564768e939dd6cf32a9aec7bc241b2ae1ccbcaa12c09d8a54cae907f4e5", "origin": "sample:3", "parent": null, "source": "def solve(data):\n    heights = data['heights']\n    \n    # Edge case: empty input\n    if not heights:\n        return 0\n    \n    n = len(heights)\n    left_max = [0] * n\n    right_max = [0] * n\n    \n    # First pass: find the maximum height from the left side\n    current_max = 0\n    for i in range(n):\n        current_max = max(current_max, heights[i])\n        left_max[i] = current_max\n    \n    # Second pass: find the maximum height from the right side\n    current_max = 0\n    for i in range(n-1, -1, -1):\n        current_max = max(current_max, heights[i])\n        right_max[i] = current_max\n    \n    # Calculate the total water trapped\n    total_water = sum(min(left_max[i], right_max[i]) - heights[i] for i in range(n))\n    \n    return total_water"}, "kind": "candidate", "prev": "832b1317dc414bf17d071ad72e18cbc96b598744dc985f11ed51e02adca51513", "seq": 22}
