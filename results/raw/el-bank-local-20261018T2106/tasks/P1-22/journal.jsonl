{"data": {"id": "4488d8a69759d3df3b8dd3647f19173c6aceb04467efb6e78f28a7a21de5ee54", "lineage": "4488d8a69759d3df3b8dd3647f19173c6aceb04467efb6e78f28a7a21de5ee54", "origin": "sample:3", "parent": null, "source": "from typing import List, Dict\n\ndef solve(data: Dict[str, List[List[int]]) -> int:\n    if not data['intervals']:\n        return 0\n    \n    # Step 1: Sort intervals by end time\n    intervals = sorted(data['intervals'], key=lambda x: x[1])\n    \n    # Step 2: Initialize variables\n    count = 0\n    current_end = float('-inf')\n    \n    # Step 3: Iterate through sorted intervals\n    for interval in intervals:\n        if interval[0] >= current_end:\n            count += 1\n            current_end = interval[1]\n    \n    return count\n\n# Example usage\nprint(solve({\"intervals\": []}))  # Output: 0\nprint(solve({\"intervals\": [[1, 2], [2, 3], [1, 3]]}))  # Output: 2\nprint(solve({\"intervals\": [[0, 10], [1, 2], [2, 3]]}))  # Output: 2\nprint(solve({\"intervals\": [[-3, -1], [0, 2]]}))  # Output: 2"}, "kind": "candidate", "prev": "a549ff546baa63e85604c4232bac1912367ab56e201b71a50684d2b5faa2976b", "seq": 22}
