{"data": {"id": "1e2dbb7b0b083abee435193f1df6e051fa42ae7ba5fac6d66143e2cc1d0d0494", "lineage": "1e2dbb7b0b083abee435193f1df6e051fa42ae7ba5fac6d66143e2cc1d0d0494", "origin": "sample:1", "parent": null, "source": "from typing import List, Tuple\n\ndef solve(data: dict) -> int:\n    intervals = data[\"intervals\"]\n    if not intervals:\n        return 0\n    \n    # Sort intervals based on their start times\n    intervals.sort(key=lambda x: x[0])\n    \n    max_disjoint_count = 0\n    current_end = float('-inf')\n    \n    for interval in intervals:\n        start, end = interval\n        # If the start time of the current interval is greater than or equal to the current end,\n        # it means there is no overlap between the two intervals.\n        if start >= current_end:\n            max_disjoint_count += 1\n            current_end = end\n    \n    return max_disjoint_count"}, "kind": "candidate", "prev": "2e0cdd321050c929eb3e33cb75f3cd8d241a881043b720af67d906b4db20f763", "seq": 6}
