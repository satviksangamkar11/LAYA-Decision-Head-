{"data": {"id": "bca42bd4de475ed286cc269bf63b46f21b39b2c7ae9a78e6920b5c6cf40725ad", "lineage": "bca42bd4de475ed286cc269bf63b46f21b39b2c7ae9a78e6920b5c6cf40725ad", "origin": "sample:4", "parent": null, "source": "# Brute-force approach: O(n)\ndef solve(data):\n    nums = data['nums']\n    target = data['target']\n    if not nums:\n        return -1\n    \n    for i, num in enumerate(nums):\n        if num == target:\n            return i\n    return -1\n\n# Efficient solution using binary search: O(log n)\ndef solve(data):\n    nums = data['nums']\n    target = data['target']\n    if not nums:\n        return -1\n    \n    left, right = 0, len(nums) - 1\n    \n    while left <= right:\n        mid = (left + right) // 2\n        \n        if nums[mid] == target:\n            return mid\n        \n        # Determine which side of the array is sorted\n        if nums[left] <= nums[mid]:\n            # Left side is sorted\n            if nums[left] <= target < nums[mid]:\n                right = mid - 1\n            else:\n                left = mid + 1\n        else:\n            # Right side is sorted\n            if nums[mid] < target <= nums[right]:\n                left = mid + 1\n            else:\n                right = mid - 1\n    \n    return -1\n\n# Test cases\ntest_cases = [\n    {\"nums\": [], \"target\": 3, \"expected\": -1},\n    {\"nums\": [4, 5, 1, 2, 3], \"target\": 2, \"expected\": 3},\n    {\"nums\": [1, 2, 3], \"target\": 7, \"expected\": -1},\n    {\"nums\": [1], \"target\": 1, \"expected\": 0}\n]\n\nfor test_case in test_cases:\n    result = solve(test_case)\n    assert result == test_case[\"expected\"], f\"Test failed for input {test_case}. Expected {test_case['expected']}, got {result}\"\nprint(\"All tests passed!\")"}, "kind": "candidate", "prev": "34b6eea4c5cb42390d563da907712ee88bd7cc5b0cebbe84dcd8980db03a836b", "seq": 23}
