{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 117, "char_start": 0, "quote": "Input {\"nums\": rotated strictly increasing integer list, \"target\": int}. Return target index or -1; empty list -> -1.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 172, "char_start": 129, "quote": "Input:\n{\"nums\": [], \"target\": 3}\nOutput:\n-1", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 239, "char_start": 184, "quote": "Input:\n{\"nums\": [4, 5, 1, 2, 3], \"target\": 2}\nOutput:\n3", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 301, "char_start": 251, "quote": "Input:\n{\"nums\": [1, 2, 3], \"target\": 7}\nOutput:\n-1", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 356, "char_start": 313, "quote": "Input:\n{\"nums\": [1], \"target\": 1}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "7f9d0fde7cd93d131fc2f57b4ea8afd99f99bd4e18