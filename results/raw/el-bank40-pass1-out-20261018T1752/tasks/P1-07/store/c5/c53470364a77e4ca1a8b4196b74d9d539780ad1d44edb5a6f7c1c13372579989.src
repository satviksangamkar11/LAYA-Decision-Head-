def solve(data):
    nums = data["nums"]
    if not nums:
        return []
    result = []
    start = nums[0]
    for i in range(1, len(nums)):
        if nums[i] == nums[i-1] + 1:
            continue
        else:
            result.append([start, nums[i-1]])
            start = nums[i]
    result.append([start, nums[-1]])
    return result