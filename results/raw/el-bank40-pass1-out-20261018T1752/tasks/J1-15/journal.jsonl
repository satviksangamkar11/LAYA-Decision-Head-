{"data": {"id": "880b07490cd9aa7a3118dec45bd755b0ea6ce625dbe9659851fa6f0c329105c5", "lineage": "880b07490cd9aa7a3118dec45bd755b0ea6ce625dbe9659851fa6f0c329105c5", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        List<?> coeffs = (List<?>) data.get(\"coeff\");\n        Number xNum = (Number) data.get(\"x\");\n        \n        if (coeffs == null || coeffs.isEmpty()) {\n            return 0;\n        }\n        \n        long x = xNum.longValue();\n        long result = ((Number) coeffs.get(0)).longValue();\n        \n        for (int i = 1; i < coeffs.size(); i++) {\n            Number nextCoeff = (Number) coeffs.get(i);\n            result = result * x + nextCoeff.longValue();\n        }\n        \n        return result;\n    }\n}"}, "kind": "candidate", "prev": "ed73b93112741cb0a91a8f8318d35985f6096fee539426e0d60faa0a1f08fe3c", "seq": 6}
