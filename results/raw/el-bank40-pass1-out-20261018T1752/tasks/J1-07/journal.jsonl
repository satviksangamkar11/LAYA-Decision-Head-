{"data": {"id": "541b0f118d6ac28d0507e9aa0a01d97849114a222544fe4bfc9e73eb460127ea", "lineage": "541b0f118d6ac28d0507e9aa0a01d97849114a222544fe4bfc9e73eb460127ea", "origin": "sample:3", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        List<List<Number>> matrix = (List<List<Number>>) data.get(\"matrix\");\n        if (matrix == null || matrix.isEmpty()) {\n            return new ArrayList<>();\n        }\n        int rows = matrix.size();\n        int cols = matrix.get(0).size();\n        List<List<Integer>> result = new ArrayList<>();\n        for (int j = 0; j < cols; j++) {\n            List<Integer> newRow = new ArrayList<>();\n            for (int i = 0; i < rows; i++) {\n                Number num = matrix.get(i).get(j);\n                newRow.add(num.intValue());\n            }\n            result.add(newRow);\n        }\n        return result;\n    }\n}"}, "kind": "candidate", "prev": "ac63bd3d4e35b9609ecde57dea50e2021791e9d9077765354d9e6746919e645c", "seq": 22}
