{"data": {"id": "eaad19920c0231c6d409738e711ebe9d0a9e938ce25db6ca44a3f62b6b55ef32", "lineage": "eaad19920c0231c6d409738e711ebe9d0a9e938ce25db6ca44a3f62b6b55ef32", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        List<?> matrix = (List<?>) data.get(\"matrix\");\n        if (matrix == null || matrix.isEmpty()) {\n            return new ArrayList<>();\n        }\n        int numColumns = matrix.get(0).size();\n        List<List<Integer>> transpose = new ArrayList<>();\n        for (int j = 0; j < numColumns; j++) {\n            List<Integer> column = new ArrayList<>();\n            for (int i = 0; i < matrix.size(); i++) {\n                Object element = matrix.get(i).get(j);\n                int value = ((Number) element).intValue();\n                column.add(value);\n            }\n            transpose.add(column);\n        }\n        return transpose;\n    }\n}"}, "kind": "candidate", "prev": "fdb85f24d07b12645ba98a55b95769ad22b25e18e6e4305e7ea571d6b2b2f68d", "seq": 6}
