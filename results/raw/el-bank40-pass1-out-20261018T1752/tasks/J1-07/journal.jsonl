{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 176, "char_start": 0, "quote": "Input {\"matrix\": rectangular list of integer lists}. Return its transpose. Input [] returns []; nonempty matrices may contain zero columns. Output lists are in row-major order.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 220, "char_start": 188, "quote": "Input:\n{\"matrix\": []}\nOutput:\n[]", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 292, "char_start": 232, "quote": "Input:\n{\"matrix\": [[1, 2], [3, 4]]}\nOutput:\n[[1, 3], [2, 4]]", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 358, "char_start": 304, "quote": "Input:\n{\"matrix\": [[1, 2, 3]]}\nOutput:\n[[1], [2], [3]]", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 408, "char_start": 370, "quote": "Input:\n{\"matrix\": [[], []]}\nOutput:\n[]", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "bf