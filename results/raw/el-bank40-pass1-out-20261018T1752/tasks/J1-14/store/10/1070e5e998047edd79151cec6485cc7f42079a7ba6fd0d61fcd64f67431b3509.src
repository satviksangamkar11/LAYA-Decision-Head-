import java.util.*;

public final class Solution {
    public static Object solve(Map<String, Object> data) {
        Object matrixObj = data.get("matrix");
        if (matrixObj == null || matrixObj instanceof List<?> && ((List<?>) matrixObj).isEmpty()) {
            return new ArrayList<>();
        }
        List<List<?>> matrix = (List<List<?>>) matrixObj;
        int N = matrix.size();
        List<List<Integer>> result = new ArrayList<>();
        for (int j = 0; j < N; j++) {
            List<Integer> newRow = new ArrayList<>();
            for (int i = 0; i < N; i++) {
                Number num = (Number) matrix.get(i).get(j);
                newRow.add(num.intValue());
            }
            Collections.reverse(newRow);
            result.add(newRow);
        }
        return result;
    }
}