{"data": {"id": "fbfb8c693ea31ab7cc874952c525d8224067072fe740a2ac2dbb5def57c9ee66", "lineage": "fbfb8c693ea31ab7cc874952c525d8224067072fe740a2ac2dbb5def57c9ee66", "origin": "sample:3", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String timeStr = (String) data.get(\"time\");\n        String[] parts = timeStr.split(\":\");\n        int h = Integer.parseInt(parts[0]);\n        int m = Integer.parseInt(parts[1]);\n\n        String period = (h < 12) ? \"AM\" : \"PM\";\n        int h1 = h;\n        if (h == 0) {\n            h1 = 12;\n        } else if (h > 12) {\n            h1 = h - 12;\n        }\n\n        String formattedH = String.format(\"%02d\", h1);\n        String formattedM = String.format(\"%02d\", m);\n\n        return formattedH + \":\" + formattedM + \" \" + period;\n    }\n}"}, "kind": "candidate", "prev": "76421f4270700794271c335982907e1c313ab07a0581b8e6d33d95ec58b8aaee", "seq": 22}
