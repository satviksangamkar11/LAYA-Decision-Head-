{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 139, "char_start": 0, "quote": "Input {\"time\": string HH:MM} where HH is 00..23 and MM is 00..59. Return string \"hh:mm AM\" or \"hh:mm PM\"; hh is always two digits (01..12).", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 192, "char_start": 151, "quote": "Input:\n{\"time\": \"00:00\"}\nOutput:\n12:00 AM", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 245, "char_start": 204, "quote": "Input:\n{\"time\": \"12:00\"}\nOutput:\n12:00 PM", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 298, "char_start": 257, "quote": "Input:\n{\"time\": \"23:59\"}\nOutput:\n11:59 PM", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 351, "char_start": 310, "quote": "Input:\n{\"time\": \"09:07\"}\nOutput:\n09:07 AM", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "a6fda79296aed4d2983d8ca2990b1376ec2375764767849