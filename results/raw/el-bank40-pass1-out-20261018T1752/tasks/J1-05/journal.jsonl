{"data": {"id": "aad37de234f49fa7fd6c2d5f3dced934e6e1025541064f1f2dd0d6736698e79a", "lineage": "aad37de234f49fa7fd6c2d5f3dced934e6e1025541064f1f2dd0d6736698e79a", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String timeStr = (String) data.get(\"time\");\n        String[] parts = timeStr.split(\":\");\n        int h = Integer.parseInt(parts[0]);\n        int m = Integer.parseInt(parts[1]);\n        \n        String period;\n        if (h == 0) {\n            h = 12;\n            period = \"AM\";\n        } else if (h == 12) {\n            period = \"PM\";\n        } else if (h < 12) {\n            period = \"AM\";\n        } else {\n            h -= 12;\n            period = \"PM\";\n        }\n        \n        String hourFormatted = String.format(\"%02d\", h);\n        String minuteFormatted = String.format(\"%02d\", m);\n        return hourFormatted + \":\" + minuteFormatted + \" \" + period;\n    }\n}"}, "kind": "candidate", "prev": "955e9af2c3f4c3241fe7600737889b70fe1820494839e406dde24cc87f3fba92", "seq": 6}
