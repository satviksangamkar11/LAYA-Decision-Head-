{"data": {"id": "277e5d1bf8577356d9d474d710aa583e91363e0cfa50755da4cb3726cc06fb28", "lineage": "277e5d1bf8577356d9d474d710aa583e91363e0cfa50755da4cb3726cc06fb28", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        Object matrixObj = data.get(\"matrix\");\n        if (matrixObj == null) {\n            return new ArrayList<>();\n        }\n        List<List<?>> matrixList = (List<List<?>>) matrixObj;\n        if (matrixList == null || matrixList.isEmpty()) {\n            return new ArrayList<>();\n        }\n        \n        int rows = matrixList.size();\n        int cols = matrixList.get(0).size();\n        int top = 0;\n        int bottom = rows - 1;\n        int left = 0;\n        int right = cols - 1;\n        List<Integer> result = new ArrayList<>();\n        \n        while (top <= bottom && left <= right) {\n            for (int i = left; i <= right; i++) {\n                Number num = (Number) matrixList.get(top).get(i);\n                result.add(num.intValue());\n            }\n            top++;\n            \n            for (int i = top; i <= bottom; i++) {\n                Number num = (Number) matrixList.get(i).get(right);\n                result.add(num.intValue());\n            }\n            right--;\n            \n            if (top <= bottom) {\n                for (int i = right; i >= left; i--) {\n                    Number num = (Number) matrixList.get(bottom).get(i);\n                    result.add(num.intValue());\n                }\n                bottom--;\n            }\n            \n            if (left <= right) {\n                for (int i = bottom; i >= top; i--) {\n                    Number num = (Number) matrixList.get(i).get(left);\n                    result.add(num.intValue());\n                }\n                left++;\n            }\n        }\n        return result;\n    }\n}"}, "kind": "candidate", "prev": "ec5348436b361d5eaf494db54727d29d9b8356ec42b1e620678def14020beb4d", "seq": 6}
