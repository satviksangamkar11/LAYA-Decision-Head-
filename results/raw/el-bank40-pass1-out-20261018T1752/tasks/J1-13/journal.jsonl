{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 215, "char_start": 0, "quote": "Input {\"matrix\": rectangular list of integer rows}. Return entries visited clockwise from top-left: top row, right column, bottom row reversed, left column upward, repeating. Empty matrix or zero columns returns [].", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 259, "char_start": 227, "quote": "Input:\n{\"matrix\": []}\nOutput:\n[]", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 339, "char_start": 271, "quote": "Input:\n{\"matrix\": [[1, 2, 3], [4, 5, 6]]}\nOutput:\n[1, 2, 3, 6, 5, 4]", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 403, "char_start": 351, "quote": "Input:\n{\"matrix\": [[3], [2], [1]]}\nOutput:\n[3, 2, 1]", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 503, "char_start": 415, "quote": "Input:\n{\"matrix\": [[1, 2, 3], [4, 5, 6], [7, 8, 9]]}\nOutput:\n[1, 2, 3, 6, 9, 8, 7, 4, 5]", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "41c2098bbee2ce92174c7ad3aeea478741060e6647923fc23eea11d5543c09b3", "stop": null}, "kind": "requirements", "prev": "bb3c17858aa8766c3bdda9430783378e957d0e1e5ce6f5316a68bc652d5b0cea", "seq": 2}
