{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language java, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 206, "char_start": 0, "quote": "Input {\"text\": lowercase ASCII string, \"k\": integer 1..5}. Repeatedly remove a group whenever k consecutive equal letters appear; after removal, newly adjacent groups may also vanish. Return remaining text.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 254, "char_start": 218, "quote": "Input:\n{\"k\": 3, \"text\": \"\"}\nOutput:\n", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 318, "char_start": 266, "quote": "Input:\n{\"k\": 3, \"text\": \"deeedbbcccbdaa\"}\nOutput:\naa", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 372, "char_start": 330, "quote": "Input:\n{\"k\": 2, \"text\": \"aaaaa\"}\nOutput:\na", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 425, "char_start": 384, "quote": "Input:\n{\"k\": 1, \"text\": \"abbba\"}\nOutput:\n", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.",