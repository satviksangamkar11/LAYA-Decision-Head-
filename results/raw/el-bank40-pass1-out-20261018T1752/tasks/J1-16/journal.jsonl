{"data": {"id": "78221207765ae08d45d90a2645c51c071be2729d080b97c3d1b87c7b458dc744", "lineage": "78221207765ae08d45d90a2645c51c071be2729d080b97c3d1b87c7b458dc744", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    public static Object solve(Map<String, Object> data) {\n        String text = (String) data.get(\"text\");\n        int k = ((Number) data.get(\"k\")).intValue();\n        \n        List<Character> stack = new ArrayList<>();\n        \n        for (char c : text.toCharArray()) {\n            stack.add(c);\n            \n            while (stack.size() >= k) {\n                char last = stack.get(stack.size() - 1);\n                boolean allSame = true;\n                for (int i = 1; i < k; i++) {\n                    if (stack.get(stack.size() - i) != last) {\n                        allSame = false;\n                        break;\n                    }\n                }\n                if (allSame) {\n                    for (int i = 0; i < k; i++) {\n                        stack.remove(stack.size() - 1);\n                    }\n                } else {\n                    break;\n                }\n            }\n        }\n        \n        return stack.stream().map(Object::toString).collect(Collectors.joining());\n    }\n}"}, "kind": "candidate", "prev": "985d74f3754ebc7f336b86fa2edcc867d1f383631eb592be45c635042e8ede66", "seq": 6}
