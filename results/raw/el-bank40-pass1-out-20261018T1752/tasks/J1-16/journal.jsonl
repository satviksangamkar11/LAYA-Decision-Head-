{"data": {"id": "4d5654497b3d084a35b10141790f9cc57e0f3ceccd2fa731797c4b8a90ff2abf", "lineage": "4d5654497b3d084a35b10141790f9cc57e0f3ceccd2fa731797c4b8a90ff2abf", "origin": "sample:3", "parent": null, "source": "import java.util.*;\n\npublic final class Solution {\n    static class Pair {\n        char c;\n        int count;\n        Pair(char c, int count) {\n            this.c = c;\n            this.count = count;\n        }\n    }\n    \n    public static Object solve(Map<String, Object> data) {\n        int k = ((Number) data.get(\"k\")).intValue();\n        String text = (String) data.get(\"text\");\n        \n        Stack<Pair> stack = new Stack<>();\n        \n        for (char c : text.toCharArray()) {\n            if (!stack.isEmpty() && stack.peek().c == c) {\n                stack.peek().count++;\n                if (stack.peek().count == k) {\n                    stack.pop();\n                }\n            } else {\n                stack.push(new Pair(c, 1));\n            }\n        }\n        \n        StringBuilder sb = new StringBuilder();\n        for (Pair p : stack) {\n            sb.append(p.c).repeat(p.count);\n        }\n        return sb.toString();\n    }\n}"}, "kind": "candidate", "prev": "ede9704222e32cd3e041a5539aac639a6d6246f2a1fea638c048b2a2be5ae7f4", "seq": 15}
