def solve(data):
    text = data['text']
    brackets = [c for c in text if c in '()[]{}']
    stack = []
    for c in brackets:
        if c in '([{':
            stack.append(c)
        else:
            if not stack:
                return False
            top = stack.pop()
            if (top == '(' and c != ')') or (top == '[' and c != ']') or (top == '{' and c != '}'):
                return False
    return len(stack) == 0