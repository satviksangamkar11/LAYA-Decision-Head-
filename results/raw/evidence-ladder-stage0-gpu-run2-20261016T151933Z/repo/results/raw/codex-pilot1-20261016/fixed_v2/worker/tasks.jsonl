{"task_id": "P1-05", "difficulty": "easy", "title": "Word frequencies", "prompt": "Input {\"text\": string}. Words are maximal ASCII-letter [A-Za-z]+ spans; lowercase them and return JSON object mapping words to counts. Ignore punctuation/digits.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"text": ""}, "expected": {}}, {"input": {"text": "Hello, HELLO! 123world"}, "expected": {"hello": 2, "world": 1}}], "public_tests": [{"input": {"text": ""}, "expected": {}}, {"input": {"text": "Hello, HELLO! 123world"}, "expected": {"hello": 2, "world": 1}}, {"input": {"text": "a1b-a"}, "expected": {"a": 2, "b": 1}}, {"input": {"text": "two\nTWO words"}, "expected": {"two": 2, "words": 1}}], "public_count": 4, "protected_count": 40}
{"task_id": "P1-06", "difficulty": "easy", "title": "Merge sorted arrays", "prompt": "Input {\"a\": sorted integer list, \"b\": sorted integer list}. Return one nondecreasing merged list, retaining duplicates.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"a": [], "b": []}, "expected": []}, {"input": {"a": [1, 3], "b": [2, 4]}, "expected": [1, 2, 3, 4]}], "public_tests": [{"input": {"a": [], "b": []}, "expected": []}, {"input": {"a": [1, 3], "b": [2, 4]}, "expected": [1, 2, 3, 4]}, {"input": {"a": [1, 1], "b": [1]}, "expected": [1, 1, 1]}, {"input": {"a": [-9, 0], "b": [-4, 5]}, "expected": [-9, -4, 0, 5]}], "public_count": 4, "protected_count": 40}
