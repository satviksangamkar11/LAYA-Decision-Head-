{"task_id": "P1-33", "difficulty": "hard", "title": "Word break feasibility", "prompt": "Input {\"text\": string, \"words\": list of nonempty strings}. Return whether text can be segmented into zero or more dictionary words, reusable unlimited times; empty text -> true.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"text": "", "words": []}, "expected": true}, {"input": {"text": "leetcode", "words": ["leet", "code"]}, "expected": true}], "public_tests": [{"input": {"text": "", "words": []}, "expected": true}, {"input": {"text": "leetcode", "words": ["leet", "code"]}, "expected": true}, {"input": {"text": "catsandog", "words": ["cats", "dog", "sand", "and", "cat"]}, "expected": false}, {"input": {"text": "aaaa", "words": ["a", "aa"]}, "expected": true}], "public_count": 4, "protected_count": 40}
{"task_id": "P1-34", "difficulty": "hard", "title": "Simplified full regular expression match", "prompt": "Input {\"text\": string, \"pattern\": valid restricted regex}. Pattern supports . (any one char) and * (zero+ of preceding token). Match the ENTIRE text. Pattern never begins with * or contains consecutive *.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"text": "", "pattern": ""}, "expected": true}, {"input": {"text": "aa", "pattern": "a*"}, "expected": true}], "public_tests": [{"input": {"text": "", "pattern": ""}, "expected": true}, {"input": {"text": "aa", "pattern": "a*"}, "expected": true}, {"input": {"text": "ab", "pattern": ".*"}, "expected": true}, {"input": {"text": "mississippi", "pattern": "mis*is*p*."}, "expected": false}], "public_count": 4, "protected_count": 40}
