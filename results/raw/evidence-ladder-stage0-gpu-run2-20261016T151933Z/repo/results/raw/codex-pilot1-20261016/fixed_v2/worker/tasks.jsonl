{"task_id": "P1-20", "difficulty": "medium", "title": "LRU cache simulation", "prompt": "Input {\"capacity\": nonnegative int, \"ops\": list of [\"put\",key,value] or [\"get\",key] with integer keys/values}. Output the results of get commands; missing -> -1. Updating and successful get mark most recently used. Capacity zero stores nothing.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"capacity": 0, "ops": [["put", 1, 2], ["get", 1]]}, "expected": [-1]}, {"input": {"capacity": 1, "ops": [["put", 1, 4], ["put", 2, 5], ["get", 1], ["get", 2]]}, "expected": [-1, 5]}], "public_tests": [{"input": {"capacity": 0, "ops": [["put", 1, 2], ["get", 1]]}, "expected": [-1]}, {"input": {"capacity": 1, "ops": [["put", 1, 4], ["put", 2, 5], ["get", 1], ["get", 2]]}, "expected": [-1, 5]}, {"input": {"capacity": 2, "ops": [["put", 1, 1], ["put", 2, 2], ["get", 1], ["put", 3, 3], ["get", 2]]}, "expected": [1, -1]}, {"input": {"capacity": 2, "ops": []}, "expected": []}], "public_count": 4, "protected_count": 40}
