{"task_id": "P1-36", "difficulty": "hard", "title": "Dijkstra all-node distances", "prompt": "Input {\"n\": positive int, \"edges\": [u,v,weight] directed with NONNEGATIVE int weight, \"source\": node}. Return list of shortest distances from source, using JSON null for unreachable nodes.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"n": 1, "edges": [], "source": 0}, "expected": [0]}, {"input": {"n": 3, "edges": [[0, 1, 2], [1, 2, 3], [0, 2, 10]], "source": 0}, "expected": [0, 2, 5]}], "public_tests": [{"input": {"n": 1, "edges": [], "source": 0}, "expected": [0]}, {"input": {"n": 3, "edges": [[0, 1, 2], [1, 2, 3], [0, 2, 10]], "source": 0}, "expected": [0, 2, 5]}, {"input": {"n": 3, "edges": [[1, 2, 1]], "source": 0}, "expected": [0, null, null]}, {"input": {"n": 2, "edges": [[0, 1, 0]], "source": 0}, "expected": [0, 0]}], "public_count": 4, "protected_count": 40}
{"task_id": "P1-37", "difficulty": "hard", "title": "Minimum-cost right/down grid", "prompt": "Input {\"grid\": rectangular matrix of nonnegative cell costs and -1 obstacles}. Move only right or down from top-left to bottom-right. Path cost includes endpoints. Return minimum cost, or null if no path/empty grid.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"grid": []}, "expected": null}, {"input": {"grid": [[2]]}, "expected": 2}], "public_tests": [{"input": {"grid": []}, "expected": null}, {"input": {"grid": [[2]]}, "expected": 2}, {"input": {"grid": [[0, 2], [1, 3]]}, "expected": 4}, {"input": {"grid": [[-1, 1], [1, 2]]}, "expected": null}], "public_count": 4, "protected_count": 40}
{"task_id": "P1-38", "difficulty": "hard", "title": "Equal subset partition", "prompt": "Input {\"nums\": list of nonnegative integers}. Return whether nums can be split into two disjoint subsets with equal sums; empty list -> true.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"nums": []}, "expected": true}, {"input": {"nums": [1, 5, 11, 5]}, "expected": true}], "public_tests": [{"input": {"nums": []}, "expected": true}, {"input": {"nums": [1, 5, 11, 5]}, "expected": true}, {"input": {"nums": [1, 2, 3, 5]}, "expected": false}, {"input": {"nums": [0, 0, 0]}, "expected": true}], "public_count": 4, "protected_count": 40}
{"task_id": "P1-39", "difficulty": "hard", "title": "Maximum product of nonempty subarray", "prompt": "Input {\"nums\": NONEMPTY integer list}. Return maximum product of a contiguous, nonempty subarray, allowing negatives and zero.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"nums": [-1]}, "expected": -1}, {"input": {"nums": [2, 3, -2, 4]}, "expected": 6}], "public_tests": [{"input": {"nums": [-1]}, "expected": -1}, {"input": {"nums": [2, 3, -2, 4]}, "expected": 6}, {"input": {"nums": [-2, 0, -1]}, "expected": 0}, {"input": {"nums": [-2, 3, -4]}, "expected": 24}], "public_count": 4, "protected_count": 40}
{"task_id": "P1-40", "difficulty": "hard", "title": "Strongly connected components", "prompt": "Input {\"n\": nonnegative int, \"edges\": directed [u,v] pairs}. Return number of strongly connected components among nodes 0..n-1; isolated nodes each count one.", "function_signature": "def solve(data):", "language": "python", "origin": "original-development-task", "difficulty_basis": "curator heuristic; not calibrated", "examples": [{"input": {"n": 0, "edges": []}, "expected": 0}, {"input": {"n": 1, "edges": []}, "expected": 1}], "public_tests": [{"input": {"n": 0, "edges": []}, "expected": 0}, {"input": {"n": 1, "edges": []}, "expected": 1}, {"input": {"n": 3, "edges": [[0, 1], [1, 0], [1, 2]]}, "expected": 2}, {"input": {"n": 4, "edges": [[0, 1], [1, 2], [2, 0], [3, 3]]}, "expected": 2}], "public_count": 4, "protected_count": 40}
