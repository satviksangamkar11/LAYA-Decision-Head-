{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 405, "char_start": 0, "quote": "The function slugify in slug.py returns slugs with leading or trailing hyphens.\n\nImplement the CORRECT behaviour as `solve(data)`: `data` is a dict with the keys `text` (the arguments of `slugify(text)`), and solve must return what the corrected `slugify` returns.\n\nCurrent implementation (buggy):\nimport re\n\n\ndef slugify(text):\n    text = text.strip().lower()\n    return re.sub(r\"[^a-z0-9]+\", \"-\", text)\n", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 469, "char_start": 417, "quote": "Input:\n{\"text\": \"Hello, World!\"}\nOutput:\nhello-world", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 520, "char_start": 481, "quote": "Input:\n{\"text\": \"  A--B  \"}\nOutput:\na-b", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 560, "char_start": 532, "quote": "Input:\n{\"text\": \"\"}\nOutput:\n", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "23f533f50ac33a6b8aca4e4d3c5672880f7e158db93df9eb83432774b9d9e250", "stop": null}, "kind": "requirements", "prev": "28c32fc3288d44806a0443a6fe42ccb3862c7d75aee70a2138f793a40d1e5534", "seq": 2}
