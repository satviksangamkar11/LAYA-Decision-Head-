{"data": {"id": "81cc15b25b3b9b260de311301d240e0891da8b0f6015474288742a8fc6846599", "lineage": "81cc15b25b3b9b260de311301d240e0891da8b0f6015474288742a8fc6846599", "origin": "sample:1", "parent": null, "source": "import java.util.*;\n\nclass Solution {\n    public static Object solve(Map<String,Object> data) {\n        int n = ((Number)data.get(\"n\")).intValue();\n        int k = ((Number)data.get(\"k\")).intValue();\n        \n        List<Integer> people = new ArrayList<>();\n        for(int i=1;i<=n;i++){\n            people.add(i);\n        }\n        \n        int index = 0;\n        while(people.size() > 1){\n            index = (index + k - 1) % people.size();\n            people.remove(index);\n        }\n        \n        return people.get(0);\n    }\n}"}, "kind": "candidate", "prev": "0cffc2f93e5a20b58540064426787e3f424a693f9018ac0b71ae377c774a58ba", "seq": 6}
