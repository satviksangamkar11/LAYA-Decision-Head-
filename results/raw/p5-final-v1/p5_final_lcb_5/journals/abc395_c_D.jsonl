{"data": {"id": "588c8d7fb25410f6ccfd5efa4974e90d4f5b14080bb8bc72adb815792e974b2e", "lineage": "588c8d7fb25410f6ccfd5efa4974e90d4f5b14080bb8bc72adb815792e974b2e", "origin": "sample:4", "parent": null, "source": "def find_shortest_repeated_subarray(N, A):\n    # Create a dictionary to store the last occurrence index of each element\n    last_occurrence = {}\n    \n    # Initialize variables to keep track of the minimum length of the repeating subarray\n    min_length = float('inf')\n    current_start = 0\n    \n    for i in range(N):\n        if A[i] in last_occurrence:\n            # Calculate the length of the current subarray\n            current_length = i - last_occurrence[A[i]]\n            # Update the minimum length if necessary\n            if current_length < min_length:\n                min_length = current_length\n                # Update the start index of the subarray\n                current_start = last_occurrence[A[i]] + 1\n        \n        # Update the last occurrence index of the current element\n        last_occurrence[A[i]] = i\n    \n    # Check if any subarray was found\n    if min_length == float('inf'):\n        return -1\n    else:\n        return min_length\n\n# Example usage\nN = int(input())\nA = list(map(int, input().split()))\nprint(find_shortest_repeated_subarray(N, A))"}, "kind": "candidate", "prev": "fbb876df4a3108787bd1d95caeccc5194b3a08fc8f19197f76c3940fbba9dfef", "seq": 25}
