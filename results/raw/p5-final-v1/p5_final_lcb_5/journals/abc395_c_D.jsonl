{"data": {"id": "8747bf50fe8dd4242689d0b72a14d978daf0683e0cb855c2586a28d52b9b3ac0", "lineage": "8747bf50fe8dd4242689d0b72a14d978daf0683e0cb855c2586a28d52b9b3ac0", "origin": "sample:3", "parent": null, "source": "def find_shortest_repeated_subarray(N, A):\n    seen = {}\n    start = end = 0\n    min_length = float('inf')\n    \n    while end < N:\n        if A[end] in seen:\n            # Calculate the length of the current subarray\n            length = end - start + 1\n            \n            # Update the minimum length if the current subarray is shorter\n            if length < min_length:\n                min_length = length\n            \n            # Move the start pointer to the next position after the last occurrence of the repeated element\n            start = seen[A[end]] + 1\n        \n        # Add the current element to the seen dictionary\n        seen[A[end]] = end\n        \n        # Move the end pointer to the next position\n        end += 1\n    \n    # Check if a subarray was found\n    if min_length == float('inf'):\n        return -1\n    else:\n        return min_length\n\n# Read input\nN = int(input())\nA = list(map(int, input().split()))\n\n# Find the shortest repeated subarray\nresult = find_shortest_repeated_subarray(N, A)\nprint(result)"}, "kind": "candidate", "prev": "2e8b35a1cae95c00dfdbf8909207bd3be796725ae79b6ebef73ca4766b078e3a", "seq": 18}
