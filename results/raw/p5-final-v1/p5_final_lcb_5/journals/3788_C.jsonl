{"data": {"id": "3e4a07cc12b2b68e11f812db862308ae88d8af5a330ece35b3d95ccc6c8825bd", "lineage": "3e4a07cc12b2b68e11f812db862308ae88d8af5a330ece35b3d95ccc6c8825bd", "origin": "sample:3", "parent": null, "source": "from typing import *\nclass Solution:\n    def maxSum(self, nums: List[int]) -> int:\n        seen = set()\n        max_sum = float('-inf')\n        current_sum = 0\n        \n        for num in nums:\n            if num not in seen:\n                current_sum += num\n                seen.add(num)\n                max_sum = max(max_sum, current_sum)\n            else:\n                current_sum -= num\n                seen.remove(num)\n                \n        return max_sum"}, "kind": "candidate", "prev": "8ca49af7b37754ea8e9356f2db0071a9b92fee6e419424da1361ea9594a156b6", "seq": 18}
