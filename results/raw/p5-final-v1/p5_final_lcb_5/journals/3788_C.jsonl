{"data": {"id": "632147f37ee60472f2480db22f5eaa75ab8cd99e1def083245a39f1ac085ba00", "lineage": "632147f37ee60472f2480db22f5eaa75ab8cd99e1def083245a39f1ac085ba00", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int]) -> int:\n        # Initialize variables\n        max_sum = float('-inf')\n        current_sum = 0\n        \n        # Iterate through each number in the list\n        for num in nums:\n            # Update the current sum by adding the current number\n            current_sum += num\n            \n            # If the current sum becomes negative, reset it to zero\n            if current_sum < 0:\n                current_sum = 0\n            \n            # Update the maximum sum found so far\n            max_sum = max(max_sum, current_sum)\n        \n        return max_sum"}, "kind": "candidate", "prev": "5774695c2e7dc94f57ea6109b4b59abee4068e6962feeb622251171eed2ba500", "seq": 6}
