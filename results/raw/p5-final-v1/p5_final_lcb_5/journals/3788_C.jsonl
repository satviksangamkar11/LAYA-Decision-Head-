{"data": {"id": "6e12aae5aa368b326880003271f0a583607a842e3f466a87e517fc45b9a5670b", "lineage": "6e12aae5aa368b326880003271f0a583607a842e3f466a87e517fc45b9a5670b", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int]) -> int:\n        if not nums:\n            return 0\n        \n        # Use a dictionary to keep track of the last occurrence of each number\n        last_occurrence = {}\n        current_sum = 0\n        max_sum = float('-inf')\n        \n        for i, num in enumerate(nums):\n            if num in last_occurrence:\n                # If the current number has been seen before, start a new subarray from the next index after its last occurrence\n                current_sum = i - last_occurrence[num] - 1\n            \n            current_sum += num\n            max_sum = max(max_sum, current_sum)\n            \n            last_occurrence[num] = i\n        \n        return max_sum"}, "kind": "candidate", "prev": "b1ee17915f28485ebd8532c4a2b950ec7f125c5505539e93ace329d2a3a73390", "seq": 25}
