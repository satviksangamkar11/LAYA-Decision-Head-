{"data": {"id": "27dae5c1ad7e7b2fcbd256008415fbb50f9848cd9599d1750bc83573fa9f4fb3", "lineage": "27dae5c1ad7e7b2fcbd256008415fbb50f9848cd9599d1750bc83573fa9f4fb3", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def hasSpecialSubstring(self, s: str, k: int) -> bool:\n        n = len(s)\n        if n < k:\n            return False\n        \n        for i in range(n - k + 1):\n            char_set = set()\n            for j in range(i, i + k):\n                if s[j] in char_set:\n                    break\n                char_set.add(s[j])\n            else:\n                return True\n        \n        return False"}, "kind": "candidate", "prev": "ea2234c3d2829f068374deb4e6a9f7118edb3057432746e8d68d23ad2019ecc5", "seq": 6}
