{"data": {"id": "568f677827b11f9aaf633d6b0ddced96320809a97c38b6670a79c9d78cd9f29f", "lineage": "568f677827b11f9aaf633d6b0ddced96320809a97c38b6670a79c9d78cd9f29f", "origin": "sample:3", "parent": null, "source": "from collections import Counter\n\nclass Solution:\n    def hasSpecialSubstring(self, s: str, k: int) -> bool:\n        n = len(s)\n        count = Counter()\n        \n        for i in range(n - k + 1):\n            sub = s[i:i+k]\n            char_count = Counter(sub)\n            \n            if len(char_count) == 1 and char_count[s[i]] > 1:\n                return True\n        \n        return False"}, "kind": "candidate", "prev": "8be26a0b51a549ea61a1644fe81b76aebbf1aeea47eb87557a05086b87533e0e", "seq": 16}
