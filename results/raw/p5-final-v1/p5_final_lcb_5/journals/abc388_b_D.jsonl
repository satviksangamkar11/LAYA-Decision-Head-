{"data": {"id": "68be71712a66d66815358471a2d48737f0ae78635d8798fa88354df42f768869", "lineage": "68be71712a66d66815358471a2d48737f0ae78635d8798fa88354df42f768869", "origin": "sample:3", "parent": null, "source": "def main():\n    import sys\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    N, D = data[0], data[1]\n    snakes = []\n    \n    for _ in range(N):\n        snakes.append((data[_ * 2], data[_ * 2 + 1]))\n    \n    # Sort snakes based on their weight in descending order\n    snakes.sort(key=lambda x: x[0] * x[1], reverse=True)\n    \n    # Calculate the weight of the heaviest snake when every snake's length has increased by k\n    result = []\n    for k in range(1, D + 1):\n        new_snakes = [(s[0] * (k + 1), s[1]) for s in snakes]\n        new_snakes.sort(key=lambda x: x[0] * x[1], reverse=True)\n        result.append(new_snakes[0][0])\n    \n    # Print the results\n    for w in result:\n        print(w)\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "08544f61e33aaa2f717ac614efb5a44d9b9308ea2747b3ddffc6b55352881429", "seq": 16}
