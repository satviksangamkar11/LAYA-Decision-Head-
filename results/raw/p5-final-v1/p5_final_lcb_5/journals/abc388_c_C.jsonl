{"data": {"id": "dde14fd0aae388a775842af9eb8c3407f67913ea5fc35c10abcafdf66912e2a5", "lineage": "dde14fd0aae388a775842af9eb8c3407f67913ea5fc35c10abcafdf66912e2a5", "origin": "sample:1", "parent": null, "source": "def count_kagamimochis(N, A):\n    # Initialize a dictionary to store the frequency of each size\n    size_count = {}\n    \n    # Count the frequency of each size\n    for size in A:\n        if size in size_count:\n            size_count[size] += 1\n        else:\n            size_count[size] = 1\n    \n    # Calculate the number of kagamimochis\n    num_kagamimochis = 0\n    \n    # Iterate through each size\n    for size in size_count:\n        # If the size is less than or equal to half of another size, it can be used to form a kagamimochi\n        for other_size in size_count:\n            if size <= other_size / 2:\n                num_kagamimochis += size_count[size] * size_count[other_size]\n    \n    return num_kagamimochis\n\n# Read input\nN = int(input())\nA = list(map(int, input().split()))\n\n# Print the result\nprint(count_kagamimochis(N, A))"}, "kind": "candidate", "prev": "eeb49cac6268667caaf98c864903ba925f0427bb0b75ca869921e6516434abd0", "seq": 6}
