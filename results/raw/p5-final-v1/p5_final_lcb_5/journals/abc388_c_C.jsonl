{"data": {"id": "77f3cee77e422b02141427e6ea45a6e9f2fe0659af346aff6d8a72677b5cf8f3", "lineage": "77f3cee77e422b02141427e6ea45a6e9f2fe0659af346aff6d8a72677b5cf8f3", "origin": "sample:4", "parent": null, "source": "def count_kagamimochis(N, A):\n    A.sort()\n    counts = [0] * (max(A) + 1)\n    \n    for a in A:\n        counts[a] += 1\n    \n    result = 0\n    for i in range(1, len(counts)):\n        for j in range(i, len(counts)):\n            if counts[i] > 0 and counts[j] > 0:\n                result += counts[i] * counts[j]\n    \n    return result\n\n# Example usage\nN = int(input())\nA = list(map(int, input().split()))\nprint(count_kagamimochis(N, A))"}, "kind": "candidate", "prev": "57067df9e5c6b89bbed53c89316e47e79492beb8ff73adb87db3e7a9f6657c08", "seq": 27}
