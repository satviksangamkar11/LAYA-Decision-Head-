{"data": {"id": "3e4a07cc12b2b68e11f812db862308ae88d8af5a330ece35b3d95ccc6c8825bd", "lineage": "3e4a07cc12b2b68e11f812db862308ae88d8af5a330ece35b3d95ccc6c8825bd", "origin": "sample:3", "parent": null, "source": "from typing import *\nclass Solution:\n    def maxSum(self, nums: List[int]) -> int:\n        seen = set()\n        max_sum = float('-inf')\n        current_sum = 0\n        \n        for num in nums:\n            if num not in seen:\n                current_sum += num\n                seen.add(num)\n                max_sum = max(max_sum, current_sum)\n            else:\n                current_sum -= num\n                seen.remove(num)\n                \n        return max_sum"}, "kind": "candidate", "prev": "f8af686d05018a3a1445fe669e9b9a3405438f9f9dde0bd604c28e9eba0ecff4", "seq": 18}
