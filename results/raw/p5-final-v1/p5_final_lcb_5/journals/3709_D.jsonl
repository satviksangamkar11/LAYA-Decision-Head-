{"data": {"id": "27dae5c1ad7e7b2fcbd256008415fbb50f9848cd9599d1750bc83573fa9f4fb3", "lineage": "27dae5c1ad7e7b2fcbd256008415fbb50f9848cd9599d1750bc83573fa9f4fb3", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def hasSpecialSubstring(self, s: str, k: int) -> bool:\n        n = len(s)\n        if n < k:\n            return False\n        \n        for i in range(n - k + 1):\n            char_set = set()\n            for j in range(i, i + k):\n                if s[j] in char_set:\n                    break\n                char_set.add(s[j])\n            else:\n                return True\n        \n        return False"}, "kind": "candidate", "prev": "abcefcd82ca59e28a8551edfb8716e41cb9b04a296665809b10194411f11443f", "seq": 6}
