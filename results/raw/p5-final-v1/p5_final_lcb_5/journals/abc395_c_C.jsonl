{"data": {"id": "8c316a67655851dd42c40848ff29a3e51036f5ca68a940b705f1b0763b7061b2", "lineage": "8c316a67655851dd42c40848ff29a3e51036f5ca68a940b705f1b0763b7061b2", "origin": "sample:2", "parent": null, "source": "import sys\nfrom collections import Counter\n\ndef find_shortest_repeated_subarray(N, A):\n    # Dictionary to store the last occurrence index of each element\n    last_occurrence = {}\n    \n    # Initialize variables to keep track of the shortest repeating subarray found\n    min_length = float('inf')\n    start_index = 0\n    \n    for i in range(N):\n        if A[i] in last_occurrence:\n            # Calculate the length of the current subarray\n            current_length = i - last_occurrence[A[i]]\n            \n            # Update the minimum length if the current subarray is shorter\n            if current_length < min_length:\n                min_length = current_length\n                start_index = last_occurrence[A[i]] + 1\n        \n        # Update the last occurrence index of the current element\n        last_occurrence[A[i]] = i\n    \n    # If no repeating subarray was found, return -1\n    if min_length == float('inf'):\n        return -1\n    \n    return min_length\n\n# Read input\ninput_data = sys.stdin.read().strip()\ndata = list(map(int, input_data.split()))\n\n# Extract N and A from the input data\nN = data[0]\nA = data[1:]\n\n# Find the shortest repeating subarray\nresult = find_shortest_repeated_subarray(N, A)\n\n# Write the result to stdout\nprint(result)"}, "kind": "candidate", "prev": "d7cf78ae14ce9267f033297dfb5e882db2db6ff4633071532120764f446002fa", "seq": 12}
