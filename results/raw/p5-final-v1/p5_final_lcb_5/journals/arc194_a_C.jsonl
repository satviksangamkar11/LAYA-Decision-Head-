{"data": {"id": "a34e3e8127cd149d93ac4c2dd9bf331d294e5463f037660b1bc68343056a6120", "lineage": "a34e3e8127cd149d93ac4c2dd9bf331d294e5463f037660b1bc68343056a6120", "origin": "sample:4", "parent": null, "source": "def max_sum_of_subsequence(N, A):\n    # Sort the array in ascending order\n    A.sort()\n    \n    # Initialize variables to store the maximum sum of subsequences\n    max_sum = 0\n    \n    # Iterate through the sorted array\n    for i in range(N):\n        # Calculate the sum of the subsequence starting from the current element\n        current_sum = sum(A[i:])\n        \n        # Update the maximum sum if the current sum is greater\n        if current_sum > max_sum:\n            max_sum = current_sum\n    \n    return max_sum\n\n# Read the input values\nN = int(input())\nA = list(map(int, input().split()))\n\n# Print the result\nprint(max_sum_of_subsequence(N, A))"}, "kind": "candidate", "prev": "443ec3a57f21697a18461781126304155f713e3df9813d01c7befa6801f91353", "seq": 24}
