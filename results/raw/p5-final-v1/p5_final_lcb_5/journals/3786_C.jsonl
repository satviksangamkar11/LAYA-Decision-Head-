{"data": {"id": "31c31f501c4df1fa44ab65ccf638cd3d4ac0e36fedafc971823cbc745bf75faf", "lineage": "88a9cc28cb48c429fcdc0bdeb3b1fa122c0790dda0ad260fcbaf2524cb9d408f", "origin": "repair:88a9cc28cb48c429fcdc0bdeb3b1fa122c0790dda0ad260fcbaf2524cb9d408f", "parent": "88a9cc28cb48c429fcdc0bdeb3b1fa122c0790dda0ad260fcbaf2524cb9d408f", "source": "class Solution:\n    def longestPalindromicSubsequence(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[0] * (k + 1) for _ in range(n)]\n        \n        for i in range(n):\n            dp[i][0] = 1\n        \n        for i in range(1, n):\n            for j in range(1, k + 1):\n                if s[i - 1] == s[n - i]:\n                    dp[i][j] = dp[i - 1][j - 1] + 2\n                else:\n                    # Adjust for wrap-around\n                    next_char = chr((ord(s[i - 1]) - ord('a') + 1) % 26 + ord('a'))\n                    prev_char = chr((ord(s[i - 1]) - ord('a') - 1) % 26 + ord('a'))\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 2] + (next_char != s[i - 1]), dp[i][j - 2] + (prev_char != s[i - 1]))\n        \n        return dp[n - 1][k]"}, "kind": "candidate", "prev": "737e334df167f53ab853b8b5cd3789060c1c91b002b5d5efdd55d9af87509304", "seq": 38}
