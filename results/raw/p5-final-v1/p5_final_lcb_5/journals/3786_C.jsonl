{"data": {"id": "da365a8ccb8478d0856c8ff1a4f872c93f3c9a4f1c9f5952666f4c4c18cfebb7", "lineage": "da365a8ccb8478d0856c8ff1a4f872c93f3c9a4f1c9f5952666f4c4c18cfebb7", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def longestPalindromicSubsequence(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n        \n        # Fill the dp table\n        for i in range(1, n + 1):\n            for j in range(1, n + 1):\n                if s[i - 1] == s[n - j]:\n                    dp[i][j] = dp[i - 1][j - 1] + 1\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n        \n        return dp[n][n]"}, "kind": "candidate", "prev": "0687c8b2b786d8a08bc4272ba28a71544de1faea774f7004e342121a4f7dcb03", "seq": 21}
