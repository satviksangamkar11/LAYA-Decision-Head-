{"data": {"id": "2af7c1a9080f1a37a9506ac6502c552b059df157c060caf4aa8c21a897ae6ab5", "lineage": "2af7c1a9080f1a37a9506ac6502c552b059df157c060caf4aa8c21a897ae6ab5", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def longestPalindromicSubsequence(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n        \n        for i in range(1, n + 1):\n            for j in range(i, n + 1):\n                if s[i - 1] == s[n - j]:\n                    dp[i][j] = dp[i - 1][j - 1] + 2\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n        \n        return dp[n][n]"}, "kind": "candidate", "prev": "dbdafcbee013ad2340257868c2785c8ccd46e55c687325cb857c1efcfe2498af", "seq": 6}
