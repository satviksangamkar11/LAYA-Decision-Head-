{"data": {"id": "6a3e205c3fed53e9f9d02ea9ed994f112de8b40dda729c3888cc6ee53886febe", "lineage": "2af7c1a9080f1a37a9506ac6502c552b059df157c060caf4aa8c21a897ae6ab5", "origin": "repair:2af7c1a9080f1a37a9506ac6502c552b059df157c060caf4aa8c21a897ae6ab5", "parent": "2af7c1a9080f1a37a9506ac6502c552b059df157c060caf4aa8c21a897ae6ab5", "source": "class Solution:\n    def longestPalindromicSubsequence(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[[0] * (k + 1) for _ in range(n)] for _ in range(n)]\n        \n        for l in range(1, n + 1):\n            for i in range(n - l + 1):\n                j = i + l - 1\n                if l == 1:\n                    dp[i][j][0] = 1\n                elif s[i] == s[j]:\n                    dp[i][j][0] = dp[i + 1][j - 1][0] + 2\n                else:\n                    dp[i][j][0] = max(dp[i + 1][j][0], dp[i][j - 1][0])\n                \n                for rep in range(1, min(k + 1, l)):\n                    if s[i] != s[j]:\n                        dp[i][j][rep] = dp[i + 1][j][rep - 1] + 2\n                    else:\n                        dp[i][j][rep] = dp[i + 1][j - 1][rep] + 2\n                \n        return dp[0][n - 1][k]"}, "kind": "candidate", "prev": "3e168bd9f077373cb2da8836a906fec81e12e90ca3c5af4ad5d8b12dbc23f588", "seq": 29}
