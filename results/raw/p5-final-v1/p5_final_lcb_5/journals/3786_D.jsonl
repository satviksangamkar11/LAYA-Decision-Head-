{"data": {"id": "88a9cc28cb48c429fcdc0bdeb3b1fa122c0790dda0ad260fcbaf2524cb9d408f", "lineage": "88a9cc28cb48c429fcdc0bdeb3b1fa122c0790dda0ad260fcbaf2524cb9d408f", "origin": "sample:2", "parent": null, "source": "class Solution:\n    def longestPalindromicSubsequence(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[0] * (k + 1) for _ in range(n)]\n        \n        for i in range(n):\n            dp[i][0] = 1\n        \n        for i in range(1, n):\n            for j in range(1, k + 1):\n                if s[i - 1] == s[n - i]:\n                    dp[i][j] = dp[i - 1][j - 1] + 2\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n        \n        return dp[n - 1][k]"}, "kind": "candidate", "prev": "b3ccb875a8e77e22a6a8036ca3296b7d101fe98139c69dc13afc3d25c82c90c6", "seq": 11}
