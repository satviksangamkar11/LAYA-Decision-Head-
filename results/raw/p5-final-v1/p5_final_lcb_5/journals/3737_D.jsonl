{"data": {"id": "bdc5f9593a46a05c512ef9afd2904b143daaa7d2fbc91afbf108ddb0d90d6649", "lineage": "9ffdddc665e036401d45c729537dfa5aab08530567deea892253d53c46ef1ebb", "origin": "repair:9ffdddc665e036401d45c729537dfa5aab08530567deea892253d53c46ef1ebb", "parent": "9ffdddc665e036401d45c729537dfa5aab08530567deea892253d53c46ef1ebb", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minCost(self, n: int, cost: List[List[int]]) -> int:\n        # Initialize arrays to store the minimum cost for each state\n        dp = [[float('inf')] * 3 for _ in range(n)]\n        \n        # Base case: The first house can be painted any color\n        dp[0][0], dp[0][1], dp[0][2] = cost[0]\n        \n        # Fill the DP table for the rest of the houses\n        for i in range(1, n):\n            # Update the cost for each color based on the previous states\n            # Ensure no two adjacent houses are painted the same color\n            dp[i][0] = min(dp[i-1][1], dp[i-1][2]) + cost[i][0]\n            dp[i][1] = min(dp[i-1][0], dp[i-1][2]) + cost[i][1]\n            dp[i][2] = min(dp[i-1][0], dp[i-1][1]) + cost[i][2]\n            \n            # Ensure houses at equidistant positions are not painted the same color\n            if i > 1 and i < n - 1:\n                dp[i][0] = min(dp[i][0], dp[i-2][1] + cost[i][0])\n                dp[i][1] = min(dp[i][1], dp[i-2][0] + cost[i][1])\n                dp[i][2] = min(dp[i][2], dp[i-2][0] + cost[i][2])\n        \n        # Find the minimum cost to paint the last house\n        return min(dp[-1])"}, "kind": "candidate", "prev": "90463aae15b905d1a191b30b14c4f016f4a6c073d08f69cd37ae4da38191e050", "seq": 39}
