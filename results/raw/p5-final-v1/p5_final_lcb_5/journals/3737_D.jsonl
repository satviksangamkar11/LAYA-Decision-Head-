{"data": {"id": "0a012d2256ecde98b000423e28d7b49b82cd0edf2181bacb6ab4839cb7fedc8d", "lineage": "0a012d2256ecde98b000423e28d7b49b82cd0edf2181bacb6ab4839cb7fedc8d", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport math\n\nclass Solution:\n    def minCost(self, n: int, cost: List[List[int]]) -> int:\n        dp = [[[math.inf]*3 for _ in range(3)] for _ in range(n)]\n        dp[0] = cost[0]\n        for i in range(1, n):\n            for j in range(3):\n                for k in range(3):\n                    if j != k:\n                        dp[i][j][k] = min(dp[i-1][j][l] + dp[i-1][k][m] for l in range(3) for m in range(3))\n        return min(min(dp[n-1]))  "}, "kind": "candidate", "prev": "94d5972ce48c8e11819c341ace9c9bc9cb639a74986a4d01da1269d9aa45639e", "seq": 16}
