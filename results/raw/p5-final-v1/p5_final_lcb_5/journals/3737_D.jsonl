{"data": {"id": "82ce79e6c882d8cadddbc9e8d68b94d50bed5eac13ea225f0338582a77e8dd9c", "lineage": "2669b20d6560185b4230d79411bc9377921156939ef9f8dcfd6fd361b0fd2f66", "origin": "repair:2669b20d6560185b4230d79411bc9377921156939ef9f8dcfd6fd361b0fd2f66", "parent": "2669b20d6560185b4230d79411bc9377921156939ef9f8dcfd6fd361b0fd2f66", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minCost(self, n: int, cost: List[List[int]]) -> int:\n        dp = [[float('inf')]*3 for _ in range(n)]\n        \n        # Initialize the first row\n        for j in range(3):\n            dp[0][j] = cost[0][j]\n        \n        # Fill the DP table\n        for i in range(1, n):\n            for j in range(3):\n                for k in range(3):\n                    if j != k:\n                        dp[i][j] = min(dp[i][j], dp[i-1][k] + cost[i][j])\n        \n        # Handle the case where the distance between the first and last houses is not equal to n/2\n        if n % 2 != 0:\n            mid = n // 2\n            for j in range(3):\n                dp[mid][j] += dp[mid-1][0] + dp[mid-1][1] + dp[mid-1][2]\n        \n        # The result is the minimum cost of painting the last house\n        return min(dp[-1])"}, "kind": "candidate", "prev": "7f75f5e17054683a80d23a0250b7c4707681db8ffbe2bdbc6adfa7043fad0a75", "seq": 29}
