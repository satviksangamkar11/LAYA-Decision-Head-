{"data": {"id": "3dc5e13438d3db50f23c9c11a208a7893dbc7470d93200ff54510af87fb295f6", "lineage": "3dc5e13438d3db50f23c9c11a208a7893dbc7470d93200ff54510af87fb295f6", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minCost(self, n: int, cost: List[List[int]]) -> int:\n        # Initialize arrays to store the minimum cost for each position\n        dp1 = [float('inf')] * n\n        dp2 = [float('inf')] * n\n        \n        # Base cases\n        dp1[0] = cost[0][0]\n        dp2[0] = cost[0][1]\n        \n        # Fill dp arrays based on the constraints\n        for i in range(1, n):\n            dp1[i] = min(dp2[i-1], dp2[i-2]) + cost[i][0]\n            dp2[i] = min(dp1[i-1], dp1[i-2]) + cost[i][1]\n        \n        # The result is the minimum of the last two values in dp arrays\n        return min(dp1[-1], dp2[-1])"}, "kind": "candidate", "prev": "734ac71b0ffc1e4cdb3326e14daad9fb7f0988cb93c45d92441585cac6979609", "seq": 11}
