{"data": {"id": "85f35f96d9fcbc92435df7e5dcdfa2dd45cef5e5847bdb18117de4daf10f41e5", "lineage": "85f35f96d9fcbc92435df7e5dcdfa2dd45cef5e5847bdb18117de4daf10f41e5", "origin": "sample:2", "parent": null, "source": "from typing import *\nimport heapq\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        m, n = len(grid), len(grid[0])\n        heap = []\n        \n        for i in range(m):\n            cur_sum = 0\n            for j in range(n):\n                cur_sum += grid[i][j]\n                \n                if len(heap) < k:\n                    heapq.heappush(heap, -cur_sum)\n                elif cur_sum > -heap[0]:\n                    heapq.heappop(heap)\n                    heapq.heappush(heap, -cur_sum)\n            \n            # If there are more elements than k, remove the smallest one\n            while len(heap) > k:\n                heapq.heappop(heap)\n        \n        return -sum(heap)"}, "kind": "candidate", "prev": "df05850ae0fa7f07e3ca17850679cf0e72e55831d68e3bfd8707476facfc50f5", "seq": 11}
