{"data": {"id": "6e47ab777b1a2b95929175a6ad9dc8846870d626cf9c2fead9d5613d2d977147", "lineage": "6e47ab777b1a2b95929175a6ad9dc8846870d626cf9c2fead9d5613d2d977147", "origin": "sample:4", "parent": null, "source": "from typing import *\nimport heapq\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        n, m = len(grid), len(grid[0])\n        dp = [[[0] * (k+1) for _ in range(m)] for _ in range(n)]\n        pq = []\n        \n        # Initialize the DP table\n        for i in range(n):\n            for j in range(m):\n                if i == 0:\n                    dp[i][j][limits[i]] = grid[i][j]\n                else:\n                    dp[i][j][limits[i]] = dp[i-1][j][limits[i]]\n                \n                heapq.heappush(pq, (-grid[i][j], i, j))\n                if len(pq) > limits[i]:\n                    _, x, y = heapq.heappop(pq)\n                    dp[i][y][limits[i]] -= grid[x][y]\n        \n        return -sum(dp[-1][-1][:k])"}, "kind": "candidate", "prev": "a570a9cb66079ad4d320250473b9b18579585947945df4a5eaa8f534eace18b8", "seq": 21}
