{"data": {"evidence": {"artifact_hash": "d71ce88944c167bfc26d9adda2813c6876f2fd46c69dcc9e0ab85023861672bc", "candidate_id": "d71ce88944c167bfc26d9adda2813c6876f2fd46c69dcc9e0ab85023861672bc", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0009", "independence": "independent", "produced_at": "t9", "receipt_hash": "9cd3f5ae644dd3da18754fa0a8319cc906357c911b002d5ef7e9c8afbad97d9f", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "88239681831c149e3a90b527fd074c3053b059b34877591a9d07337beedd2c1f", "seq": 19}
