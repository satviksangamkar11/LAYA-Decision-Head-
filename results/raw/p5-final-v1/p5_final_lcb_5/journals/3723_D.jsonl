{"data": {"id": "4d7c1684bf9ad50063f7baf0cd52914a67dd74e4d3b7dedc78131cbcb45549f9", "lineage": "4d7c1684bf9ad50063f7baf0cd52914a67dd74e4d3b7dedc78131cbcb45549f9", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def sumOfGoodNumbers(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        count = 0\n        \n        for i in range(n):\n            left_max = max(nums[max(0, i-k):i])\n            right_min = min(nums[i+1:min(i+k+1, n)])\n            \n            if nums[i] > left_max and nums[i] > right_min:\n                count += nums[i]\n                \n        return count"}, "kind": "candidate", "prev": "9cfa5fb562e21d62ed2485f724e3d4e5ef4eccb20898cafe6a4de3145e28f864", "seq": 12}
