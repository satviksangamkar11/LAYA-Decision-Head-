{"data": {"n": 4, "prompt_sha": ["cb8153db27ec141950b0d3e2c27e78b6daa9a1c24a1b47add2e941c263274471"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "384dc37894d7a940f6b2c8ee809928de349a7951aab83560c1b9b660105271fa", "seq": 5}
{"data": {"id": "18dd7cbca62714789b3b254108a17af880925467798d0523808defb68e927802", "lineage": "18dd7cbca62714789b3b254108a17af880925467798d0523808defb68e927802", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def sumOfGoodNumbers(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        res = 0\n        \n        for i in range(n):\n            good = True\n            \n            # Check if there's an index i-k\n            if i - k >= 0:\n                good &= nums[i] > nums[i - k]\n            \n            # Check if there's an index i+k\n            if i + k < n:\n                good &= nums[i] > nums[i + k]\n            \n            if good:\n                res += nums[i]\n                \n        return res"}, "kind": "candidate", "prev": "858df3e2bcfdebd2c34df20f2a7ff70c45601e250af6b9d1cb48931e1138e2ed", "seq": 6}
