{"data": {"id": "bfbed0de47a59c8f2098360ec7d19c0dcc2ab00fb9bc03211c55b0246527f406", "lineage": "bfbed0de47a59c8f2098360ec7d19c0dcc2ab00fb9bc03211c55b0246527f406", "origin": "sample:1", "parent": null, "source": "def main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    \n    n = int(data[0])\n    p = list(map(int, data[1:n+1]))\n    q = list(map(int, data[n+1:]))\n\n    # Initialize the result list\n    result = []\n\n    # Iterate through the list of people\n    for i in range(n):\n        # Find the person who is staring at the current person\n        for j in range(n):\n            if p[j] == i + 1:\n                # Append the bib number of the person staring at the current person\n                result.append(q[j])\n                break\n\n    # Print the result\n    print(' '.join(map(str, result)))\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "c159c5cd05cca19306ba439b703354841cd5f240e49f027527ccffe7bb0b50c3", "seq": 6}
