{"data": {"n": 4, "prompt_sha": ["a284a8b4e6134c680ef4c0c943766c1f868bbb194b4340ec85be08aa45290ace"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "452ac6c4227ff3d28ccbace4db796ca590c3bda136f7081b70e98250d43360f0", "seq": 5}
{"data": {"id": "45734c4ae4550693b59957ccfe1e13645263ce1aa0d05d3179f0ebe333cdb539", "lineage": "45734c4ae4550693b59957ccfe1e13645263ce1aa0d05d3179f0ebe333cdb539", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        rows, cols = len(grid), len(grid[0])\n        prefix_sums = [[0] * (cols + 1) for _ in range(rows + 1)]\n        \n        # Calculate prefix sums\n        for i in range(1, rows + 1):\n            for j in range(1, cols + 1):\n                prefix_sums[i][j] = grid[i-1][j-1] + prefix_sums[i-1][j] + prefix_sums[i][j-1] - prefix_sums[i-1][i-1]\n        \n        max_sum = 0\n        current_sum = 0\n        \n        # Iterate through each row\n        for i in range(rows):\n            limit = limits[i]\n            used = set()\n            \n            # Iterate through each column up to the limit\n            for j in range(cols):\n                if j in used or j > limit:\n                    break\n                current_sum += prefix_sums[i+1][j+1] - prefix_sums[i][j+1]\n                \n                # Check if the current sum exceeds the limit\n                if current_sum > limit:\n                    break\n                \n                # Update the maximum sum and used elements\n                max_sum = max(max_sum, current_sum)\n                used.add(j)\n                \n                # If the number of used elements exceeds k, remove the smallest element\n                if len(used) > k:\n                    min_element = min(used)\n                    current_sum -= prefix_sums[i+1][min_element+1] - prefix_sums[i][min_element+1]\n                    used.remove(min_element)\n                    \n        return max_sum"}, "kind": "candidate", "prev": "ec2ccf0716d0ed67bb795519fcb75e9b385c07f2916cef779c5c4d3705a8c799", "seq": 6}
