{"data": {"id": "d71ce88944c167bfc26d9adda2813c6876f2fd46c69dcc9e0ab85023861672bc", "lineage": "d71ce88944c167bfc26d9adda2813c6876f2fd46c69dcc9e0ab85023861672bc", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport collections\n\nclass Solution:\n    def maxSum(self, grid: List[List[int]], limits: List[int], k: int) -> int:\n        n, m = len(grid), len(grid[0])\n        prefix_sums = [[0 for _ in range(m)] for _ in range(n)]\n        for i in range(n):\n            for j in range(m):\n                if i == 0:\n                    prefix_sums[i][j] = grid[i][j]\n                else:\n                    prefix_sums[i][j] = prefix_sums[i-1][j] + grid[i][j]\n                \n        dp = [[0 for _ in range(k+1)] for _ in range(n)]\n        for i in range(n):\n            for j in range(m):\n                for l in range(1, k+1):\n                    if j < limits[i]:\n                        dp[i][l] = max(dp[i][l], dp[i-1][l] + prefix_sums[i][j])\n                    elif j >= limits[i]:\n                        dp[i][l] = max(dp[i][l], dp[i-1][l-1] + prefix_sums[i][j]-prefix_sums[i-1][limits[i]])\n                        \n        return dp[-1][-1]"}, "kind": "candidate", "prev": "e649c5c301d7db07f2a08ccf128ca7202fbaa1543bc93bcc23ebf7e957135b57", "seq": 16}
