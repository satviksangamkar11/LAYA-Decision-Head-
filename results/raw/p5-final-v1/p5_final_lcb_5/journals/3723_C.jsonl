{"data": {"n": 4, "prompt_sha": ["cb8153db27ec141950b0d3e2c27e78b6daa9a1c24a1b47add2e941c263274471"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "38e21d02eaae381dcda428fe177ebd1d4556c2567c8f2bb254b6a491cf2eb523", "seq": 5}
{"data": {"id": "18dd7cbca62714789b3b254108a17af880925467798d0523808defb68e927802", "lineage": "18dd7cbca62714789b3b254108a17af880925467798d0523808defb68e927802", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def sumOfGoodNumbers(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        res = 0\n        \n        for i in range(n):\n            good = True\n            \n            # Check if there's an index i-k\n            if i - k >= 0:\n                good &= nums[i] > nums[i - k]\n            \n            # Check if there's an index i+k\n            if i + k < n:\n                good &= nums[i] > nums[i + k]\n            \n            if good:\n                res += nums[i]\n                \n        return res"}, "kind": "candidate", "prev": "10d8ed1ceee74ab4cc01aa56fa9b426da132a3b258f757c06edbd1eafe7548ac", "seq": 6}
