{"data": {"id": "22e7bf5853871afa63d6c0edbba22d41870d21507005bec1614b3d925bbca901", "lineage": "22e7bf5853871afa63d6c0edbba22d41870d21507005bec1614b3d925bbca901", "origin": "sample:3", "parent": null, "source": "from typing import *\nclass Solution:\n    def sumOfGoodNumbers(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        prefix_sum = [0] * (n + 1)\n        for i in range(1, n + 1):\n            prefix_sum[i] = prefix_sum[i-1] + nums[i-1]\n        \n        total_sum = 0\n        for i in range(k, n - k + 1):\n            left_index = max(i - k, 0)\n            right_index = min(i + k, n - 1)\n            total_sum += prefix_sum[right_index + 1] - prefix_sum[left_index]\n        \n        return total_sum"}, "kind": "candidate", "prev": "ff50553da27c1bb58759c5026395942f244b6dd4e51b87bb09858958454198d6", "seq": 17}
