{"data": {"id": "5ea34d0bc60fe7eef681ff62e1d94b56257ccd8da6f18d5f457c0559843d44bc", "lineage": "5ea34d0bc60fe7eef681ff62e1d94b56257ccd8da6f18d5f457c0559843d44bc", "origin": "sample:3", "parent": null, "source": "def max_sum_sequence(N, A):\n    # Initialize variables to store the maximum sum and the current sum\n    max_sum = 0\n    current_sum = 0\n    \n    # Iterate through the array\n    for num in A:\n        # Update the current sum by adding the current number\n        current_sum += num\n        \n        # If the current sum becomes negative, reset it to zero\n        if current_sum < 0:\n            current_sum = 0\n        \n        # Update the maximum sum if the current sum is greater\n        if current_sum > max_sum:\n            max_sum = current_sum\n    \n    return max_sum\n\n# Read input\nN = int(input())\nA = list(map(int, input().split()))\n\n# Call the function and print the result\nprint(max_sum_sequence(N, A))"}, "kind": "candidate", "prev": "ce361dfd7ec28843cc750191fab5b9d2675aedbb3449703726b1ccde664e1eb0", "seq": 18}
