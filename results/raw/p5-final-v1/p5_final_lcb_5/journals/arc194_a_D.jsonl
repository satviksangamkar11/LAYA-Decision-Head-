{"data": {"id": "78eee099b753c9a095f351312c387c3f52a005ab2c12a7e826c1d78ad6a946e3", "lineage": "b5846157f9e18a36904599b619410551a114ae742cb3f32cd4e6233fe70097b8", "origin": "repair:b5846157f9e18a36904599b619410551a114ae742cb3f32cd4e6233fe70097b8", "parent": "b5846157f9e18a36904599b619410551a114ae742cb3f32cd4e6233fe70097b8", "source": "import sys\n\ndef max_sum_after_operations(N, A):\n    total_sum = sum(A)\n    if N % 2 == 1:\n        # If N is odd, we can't delete the last element, so we take the first element instead\n        return total_sum - A[0]\n    else:\n        return total_sum // 2\n\nif __name__ == \"__main__\":\n    N = int(sys.stdin.readline())\n    A = list(map(int, sys.stdin.readline().split()))\n    \n    print(max_sum_after_operations(N, A))"}, "kind": "candidate", "prev": "4d4d028170e18c4ece04311d5c39b17da9a30675a561ff4abdeb27984e45c43e", "seq": 38}
