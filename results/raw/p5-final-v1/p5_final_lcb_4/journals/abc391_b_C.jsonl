{"data": {"id": "607cad278b9bc901581c13b4231d2121164b345d05a9528861380cf2b780ff44", "lineage": "607cad278b9bc901581c13b4231d2121164b345d05a9528861380cf2b780ff44", "origin": "sample:1", "parent": null, "source": "def find_subgrid(S, T):\n    N, M = len(S), len(T)\n    \n    for a in range(N - M + 1):\n        for b in range(N - M + 1):\n            if all(S[a+i-1][b+j-1] == T[i][j] for i in range(M) for j in range(M)):\n                return a + 1, b + 1\n    \n    raise ValueError(\"No matching subgrid found\")\n\n# Example usage\nS = [\n    \".#.\",\n    \"..#\",\n    \"##.\"\n]\nT = [\n    \"#.\",\n    \"##\"\n]\n\nprint(find_subgrid(S, T))  # Output: (2, 2)"}, "kind": "candidate", "prev": "435bc50f05eecb83f6b78cb033763549f57880462b8aedae19c19aa8c58d99b9", "seq": 6}
