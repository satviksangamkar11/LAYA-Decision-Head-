{"data": {"id": "93fb98c0d3d86aa67ba97fd22e23619f04085fb471de5d412f850e546a3ec65b", "lineage": "93fb98c0d3d86aa67ba97fd22e23619f04085fb471de5d412f850e546a3ec65b", "origin": "sample:2", "parent": null, "source": "import math\n\ndef count_good_integers(N):\n    count = 0\n    for i in range(1, int(math.sqrt(N)) + 1):\n        if N % (i * i) == 0:\n            j = N // (i * i)\n            count += (j + 1) * (j + 2) // 2\n    return count\n\n# Example usage:\nN = int(input())\nprint(count_good_integers(N))"}, "kind": "candidate", "prev": "08473a4e5b0e79dd0943392752b8a4e635b5132d575909ac4dc73a8a0a00becc", "seq": 12}
