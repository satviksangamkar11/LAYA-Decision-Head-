{"data": {"id": "6e0329c4d7b9212defdcafea2a5d9f95ff3ef53772bef029575614a7299f023f", "lineage": "00f3d12eb895ae30f3abbf1f6701819ef1b5b6a2adf7516ffac37a1ac0832f02", "origin": "repair:00f3d12eb895ae30f3abbf1f6701819ef1b5b6a2adf7516ffac37a1ac0832f02", "parent": "00f3d12eb895ae30f3abbf1f6701819ef1b5b6a2adf7516ffac37a1ac0832f02", "source": "import math\n\ndef count_good_integers(N):\n    # Initialize the count of good integers\n    count = 0\n    \n    # Iterate through possible values of a\n    for a in range(1, int(math.log2(N)) + 1):\n        if N % (2 ** a) == 0:\n            b = N // (2 ** a)\n            if b >= 1 and int(b * b * 2) <= N:\n                count += 1\n    \n    return count\n\n# Read the input value\nN = int(input())\n\n# Print the result\nprint(count_good_integers(N))"}, "kind": "candidate", "prev": "74b0688a1de00f0291b610857f0800f89a656b1650e0018146c6a9550922f238", "seq": 33}
