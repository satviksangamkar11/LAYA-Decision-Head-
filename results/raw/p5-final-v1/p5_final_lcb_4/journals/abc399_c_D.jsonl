{"data": {"evidence": {"artifact_hash": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "candidate_id": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0008", "independence": "independent", "produced_at": "t8", "receipt_hash": "66f0f7e2758687a15029f60c627ccb30b85c74ece94d029875f36f05f8caf22d", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "d75fce457d4165a92bf1501836f4efe668346c1411a6fc41e470c0fcdbc4b751", "seq": 16}
{"data": {"answer_label": "BLOCKED", "candidate_id": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "fails": 3, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED", "R5": "FAILED"}, "trusted_passes": 0, "validated_passes": 0}, "kind": "label", "prev": "5824767178b4491fa2b3680ab694b84d145801f330c30c75f47a2671c4c0edc9", "seq": 17}
{"data": {"id": "24da01b441cd9590306e17d7c4cc2c08b1444c0869ef79fc8befa8270eae3e65", "lineage": "24da01b441cd9590306e17d7c4cc2c08b1444c0869ef79fc8befa8270eae3e65", "origin": "sample:3", "parent": null, "source": "def main():\n    import sys\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    N = data[0]\n    M = data[1]\n    \n    # Build adjacency list representation of the graph\n    adj_list = [[] for _ in range(N + 1)]\n    for i in range(M):\n        u, v = data[i * 2], data[i * 2 + 1]\n        adj_list[u].append(v)\n        adj_list[v].append(u)\n    \n    # Use Tarjan's algorithm to find strongly connected components (SCCs)\n    def tarjan(node, parent):\n        nonlocal time, sccs, stack, visited\n        time += 1\n        node.lowlink = node.discovery = time\n        stack.append(node)\n        visited[node] = True\n        \n        for neighbor in adj_list[node]:\n            if not visited[neighbor]:\n                tarjan(neighbor, node)\n                node.lowlink = min(node.lowlink, neighbor.lowlink)\n            elif neighbor != parent:\n                node.lowlink = min(node.lowlink, neighbor.discovery)\n        \n        if node.lowlink == node.discovery:\n            scc = []\n            while stack:\n                vertex = stack.pop()\n                scc.append(vertex)\n                visited[vertex] = False\n                if vertex == node:\n                    break\n            sccs.append(scc)\n    \n    time = 0\n    sccs = []\n    stack = []\n    visited = [False] * (N + 1)\n    \n    for i in range(1, N + 1):\n        if not visited[i]:\n            tarjan(i, None)\n    \n    # Calculate the number of cycles in the graph\n    num_cycles = len(sccs) - 1\n    \n    print(num_cycles)\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "abd226d9ff08021448ecfd19b25ba8b820712017d754447183e78b9ba9ad5e61", "seq": 18}
