{"data": {"id": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "lineage": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "origin": "sample:2", "parent": null, "source": "import sys\nfrom collections import defaultdict\n\ndef main():\n    n, m = map(int, sys.stdin.readline().split())\n    adj_list = defaultdict(list)\n    \n    for _ in range(m):\n        u, v = map(int, sys.stdin.readline().split())\n        adj_list[u].append(v)\n        adj_list[v].append(u)\n    \n    visited = set()\n    def dfs(node):\n        if node in visited:\n            return False\n        visited.add(node)\n        for neighbor in adj_list[node]:\n            if not dfs(neighbor):\n                return False\n        return True\n    \n    components = 0\n    for node in range(1, n + 1):\n        if node not in visited and not dfs(node):\n            components += 1\n    \n    print(components - 1)\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "d0fdd5e39a1464bac8ae2777bc53fb4670ef87f5577bc0addc330c0291d2f3e4", "seq": 12}
