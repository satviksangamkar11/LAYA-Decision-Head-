{"data": {"id": "184514220a45fc1594b87a6751895e5b374f2f83d548feb31986dc61963e02d9", "lineage": "4d6659ae46cd1ab8f2d6c7d423e32e997a1026bbe3824afde763068932dc772e", "origin": "repair:4d6659ae46cd1ab8f2d6c7d423e32e997a1026bbe3824afde763068932dc772e", "parent": "4d6659ae46cd1ab8f2d6c7d423e32e997a1026bbe3824afde763068932dc772e", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\n        n = len(fruits)\n        count = Counter(fruits)\n        total_fruits = sum(count.values())\n        max_capacity = sum(baskets[:len(count)])\n        \n        if max_capacity < total_fruits:\n            return -1\n        \n        start = 0\n        end = 0\n        max_fruit_count = 0\n        unplaced_fruits = 0\n        \n        while end < n:\n            current_fruit = fruits[end]\n            count[current_fruit] -= 1\n            \n            if count[current_fruit] == 0:\n                del count[current_fruit]\n            \n            max_fruit_count = max(max_fruit_count, count[current_fruit])\n            \n            while max_fruit_count > baskets[start]:\n                count[fruits[start]] += 1\n                max_fruit_count = max(max_fruit_count, count[fruits[start]])\n                \n                start += 1\n                \n            end += 1\n            \n            # If the current fruit cannot be placed, decrement the total number of fruits\n            if max_fruit_count > baskets[start]:\n                total_fruits -= 1\n        \n        return total_fruits"}, "kind": "candidate", "prev": "7b43b101abbdb40408fc12e8cd7b26d55330c77208f2955548cb948735372a19", "seq": 34}
