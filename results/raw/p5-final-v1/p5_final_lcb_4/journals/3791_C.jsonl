{"data": {"id": "4d6659ae46cd1ab8f2d6c7d423e32e997a1026bbe3824afde763068932dc772e", "lineage": "4d6659ae46cd1ab8f2d6c7d423e32e997a1026bbe3824afde763068932dc772e", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\n        n = len(fruits)\n        count = Counter(fruits)\n        total_fruits = sum(count.values())\n        max_capacity = sum(baskets[:len(count)])\n        \n        if max_capacity < total_fruits:\n            return -1\n        \n        start = 0\n        end = 0\n        max_fruit_count = 0\n        unplaced_fruits = 0\n        \n        while end < n:\n            current_fruit = fruits[end]\n            count[current_fruit] -= 1\n            \n            if count[current_fruit] == 0:\n                del count[current_fruit]\n            \n            max_fruit_count = max(max_fruit_count, count[current_fruit])\n            \n            while max_fruit_count > baskets[start]:\n                count[fruits[start]] += 1\n                max_fruit_count = max(max_fruit_count, count[fruits[start]])\n                \n                start += 1\n                \n            end += 1\n            \n            unplaced_fruits = total_fruits - sum(count.values())\n        \n        return unplaced_fruits"}, "kind": "candidate", "prev": "409e55b2ecf58999b037b9b8ef50f3ba79aa2a6243072a99abfd7421f1598a4f", "seq": 6}
