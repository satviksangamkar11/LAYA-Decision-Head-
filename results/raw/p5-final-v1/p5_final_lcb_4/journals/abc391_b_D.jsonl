{"data": {"id": "74f3c161ec3e969d05eedc36cbd8aa7eee41541816ffce2657a50a8dc6e2c44d", "lineage": "74f3c161ec3e969d05eedc36cbd8aa7eee41541816ffce2657a50a8dc6e2c44d", "origin": "sample:4", "parent": null, "source": "def find_subgrid(S, T):\n    N, M = len(S), len(T)\n    \n    for a in range(N - M + 1):\n        for b in range(N - M + 1):\n            match = True\n            for i in range(M):\n                for j in range(M):\n                    if S[a+i-1][b+j-1] != T[i][j]:\n                        match = False\n                        break\n                if not match:\n                    break\n            if match:\n                return a + 1, b + 1\n    \n    return None, None\n\n# Example usage\nif __name__ == \"__main__\":\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    N, M = int(data[0]), int(data[1])\n    S = [input()[1:-1].split() for _ in range(N)]\n    T = [input()[1:-1].split() for _ in range(M)]\n    \n    a, b = find_subgrid(S, T)\n    print(a, b)"}, "kind": "candidate", "prev": "adbe0f33544a6024ee9f5b7c07bcba76acefb818f75a1569b694ecfb51dd192b", "seq": 21}
