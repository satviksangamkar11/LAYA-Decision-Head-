{"data": {"id": "0e456c7b5fe31527c1bfb9b2421907735af106e324844be66dbfb4403da0e4e6", "lineage": "0e456c7b5fe31527c1bfb9b2421907735af106e324844be66dbfb4403da0e4e6", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport bisect\n\nclass Solution:\n    def separateSquares(self, squares: List[List[int]]) -> float:\n        # Sort squares by their bottom-left y-coordinate\n        squares.sort(key=lambda x: x[1])\n        \n        # Initialize variables\n        total_area_above = 0\n        total_area_below = 0\n        min_y = float('inf')\n        \n        # Iterate through each square\n        for i in range(len(squares)):\n            # Calculate the area of the current square\n            area = squares[i][2]**2\n            \n            # Update the total area above and below the current line\n            total_area_above += area\n            total_area_below -= area\n            \n            # Find the number of squares below the current line\n            num_squares_below = bisect.bisect_right(squares, [squares[i][0], squares[i][1] - 1, 0])\n            \n            # Calculate the total area below the current line\n            if num_squares_below > 0:\n                total_area_below += sum([squares[j][2]**2 for j in range(num_squares_below)])\n            \n            # Update the minimum y-coordinate\n            min_y = min(min_y, squares[i][1] - (total_area_above / (num_squares_below + 1)))\n        \n        return min_y"}, "kind": "candidate", "prev": "f7c15b1c53876714f9abce0d68331e4031606ea316093420ecc9637920e256fe", "seq": 16}
