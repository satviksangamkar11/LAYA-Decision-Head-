{"data": {"id": "50bd1909cdc4e3ddc4efd4a1d9f5be43c79a8b3ca210f176443d7c250207703d", "lineage": "50bd1909cdc4e3ddc4efd4a1d9f5be43c79a8b3ca210f176443d7c250207703d", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def separateSquares(self, squares: List[List[int]]) -> float:\n        # Sort squares based on their rightmost x-coordinates\n        squares.sort(key=lambda s: s[0] + s[2])\n        \n        # Initialize variables to keep track of the current sum of areas\n        cur_sum = 0\n        max_y = -float('inf')\n        \n        # Iterate through each square\n        for x, y, l in squares:\n            # Update the current sum of areas\n            cur_sum += l**2\n            \n            # Check if the current sum is greater than the maximum seen so far\n            if cur_sum > max_y:\n                max_y = cur_sum\n        \n        # Calculate the average y-coordinate of the horizontal line\n        return max_y / len(squares)"}, "kind": "candidate", "prev": "2f111433994a780f210b079559dc4e822b30a1125889bdaebf15acd6a01f32a1", "seq": 6}
