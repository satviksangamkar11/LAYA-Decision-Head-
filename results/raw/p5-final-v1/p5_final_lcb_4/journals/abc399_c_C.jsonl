{"data": {"evidence": {"artifact_hash": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "candidate_id": "86ca10ddc3682c6c8d0fea763d658cfa1c109c07ea93be013ab08d7dc0ac42b8", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0008", "independence": "independent", "produced_at": "t8", "receipt_hash": "66f0f7e2758687a15029f60c627ccb30b85c74ece94d029875f36f05f8caf22d", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "b7c5242575c3658272c962ed29d9ad52bc9a110aceece017d1d5d5b96353fee0", "seq": 16}
