{"data": {"id": "24da01b441cd9590306e17d7c4cc2c08b1444c0869ef79fc8befa8270eae3e65", "lineage": "24da01b441cd9590306e17d7c4cc2c08b1444c0869ef79fc8befa8270eae3e65", "origin": "sample:3", "parent": null, "source": "def main():\n    import sys\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    N = data[0]\n    M = data[1]\n    \n    # Build adjacency list representation of the graph\n    adj_list = [[] for _ in range(N + 1)]\n    for i in range(M):\n        u, v = data[i * 2], data[i * 2 + 1]\n        adj_list[u].append(v)\n        adj_list[v].append(u)\n    \n    # Use Tarjan's algorithm to find strongly connected components (SCCs)\n    def tarjan(node, parent):\n        nonlocal time, sccs, stack, visited\n        time += 1\n        node.lowlink = node.discovery = time\n        stack.append(node)\n        visited[node] = True\n        \n        for neighbor in adj_list[node]:\n            if not visited[neighbor]:\n                tarjan(neighbor, node)\n                node.lowlink = min(node.lowlink, neighbor.lowlink)\n            elif neighbor != parent:\n                node.lowlink = min(node.lowlink, neighbor.discovery)\n        \n        if node.lowlink == node.discovery:\n            scc = []\n            while stack:\n                vertex = stack.pop()\n                scc.append(vertex)\n                visited[vertex] = False\n                if vertex == node:\n                    break\n            sccs.append(scc)\n    \n    time = 0\n    sccs = []\n    stack = []\n    visited = [False] * (N + 1)\n    \n    for i in range(1, N + 1):\n        if not visited[i]:\n            tarjan(i, None)\n    \n    # Calculate the number of cycles in the graph\n    num_cycles = len(sccs) - 1\n    \n    print(num_cycles)\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "57d55df2a34de4823574239e96d54b9ce98bccb5a4627ad2ce0fb85db9def075", "seq": 18}
