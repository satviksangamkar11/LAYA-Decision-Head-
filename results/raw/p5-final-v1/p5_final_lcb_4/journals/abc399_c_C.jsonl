{"data": {"id": "aa53ab864a8d10f0ca2805e92b6f72cde224db103c4b6a14676fe43b84311f4e", "lineage": "6899b25dbf5a0f8e6a97b0706eb33abe64e704bb722920dce94c04b476b6de07", "origin": "repair:6899b25dbf5a0f8e6a97b0706eb33abe64e704bb722920dce94c04b476b6de07", "parent": "6899b25dbf5a0f8e6a97b0706eb33abe64e704bb722920dce94c04b476b6de07", "source": "def min_edges_to_forest(n, m, edges):\n    # Initialize a list to keep track of the parent of each vertex\n    parent = list(range(n + 1))\n    \n    def find(x):\n        if parent[x] != x:\n            parent[x] = find(parent[x])\n        return parent[x]\n    \n    def union(x, y):\n        root_x = find(x)\n        root_y = find(y)\n        if root_x == root_y:\n            return False\n        parent[root_x] = root_y\n        return True\n    \n    # Process each edge\n    for u, v in edges:\n        if not union(u, v):\n            return 1\n    \n    # Count the number of connected components\n    num_components = sum(parent[i] == i for i in range(1, n + 1))\n    return n - num_components\n\n# Read input\nn, m = map(int, input().split())\nedges = [tuple(map(int, input().split())) for _ in range(m)]\n\n# Print the result\nprint(min_edges_to_forest(n, m, edges))"}, "kind": "candidate", "prev": "eda96d8bdca8222a729daa481cc40069f7238f40f61d59e7ea55f2641dee8332", "seq": 33}
