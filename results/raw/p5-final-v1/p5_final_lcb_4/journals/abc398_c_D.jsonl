{"data": {"answer_label": "BLOCKED", "candidate_id": "08b4d15cdc4aa04359fc3a9b386a9a7a1bab491f21b1c6ba207f6faad1785b8b", "fails": 1, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "VERIFIED"}, "trusted_passes": 1, "validated_passes": 0}, "kind": "label", "prev": "b04eeee6155d42ee79bab9efce2b944133080bc5d9a85128d9e92d47bd8ac5d0", "seq": 20}
{"data": {"id": "ff161cfb48d01d4ca5ff2d9403d2b48303d0da62367ba2a7b3d62fc1d77f188c", "lineage": "ff161cfb48d01d4ca5ff2d9403d2b48303d0da62367ba2a7b3d62fc1d77f188c", "origin": "sample:4", "parent": null, "source": "def find_largest_unique_integer(N, A):\n    # Create a dictionary to count occurrences of each number\n    num_count = {}\n    \n    # Count the occurrences of each number in A\n    for num in A:\n        if num in num_count:\n            num_count[num] += 1\n        else:\n            num_count[num] = 1\n    \n    # Find the maximum value in num_count\n    max_value = max(num_count.values())\n    \n    # Check if any number appears more than once\n    if max_value > 1:\n        return -1\n    \n    # Find the numbers that appear exactly once\n    unique_numbers = [num for num, count in num_count.items() if count == 1]\n    \n    # Return the largest unique number\n    return max(unique_numbers)\n\n# Read input from stdin\nN = int(input())\nA = list(map(int, input().split()))\n\n# Find the largest unique integer\nresult = find_largest_unique_integer(N, A)\n\n# Write the result to stdout\nprint(result)"}, "kind": "candidate", "prev": "5948d9c6a407437d7fed2a597bdd01ac912bd4151bcea175309d3644d18c66b0", "seq": 21}
