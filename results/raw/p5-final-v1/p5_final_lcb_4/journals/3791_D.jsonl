{"data": {"id": "9cfca51812a493a1e708c0e7b13fd4e92e3882ae3b1da0a014c4b224ed3749a6", "lineage": "9cfca51812a493a1e708c0e7b13fd4e92e3882ae3b1da0a014c4b224ed3749a6", "origin": "sample:3", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\n        if len(fruits) > len(baskets):\n            return len(fruits) - len(baskets)\n        \n        l, r, total_fruit = 0, 0, 0\n        basket_dict = {}\n        \n        while r < len(fruits):\n            basket_dict[fruits[r]] = basket_dict.get(fruits[r], 0) + 1\n            total_fruit += fruits[r]\n            \n            while len(basket_dict) > len(baskets):\n                basket_dict[fruits[l]] -= 1\n                if basket_dict[fruits[l]] == 0:\n                    del basket_dict[fruits[l]]\n                total_fruit -= fruits[l]\n                l += 1\n            \n            r += 1\n        \n        return len(fruits) - total_fruit"}, "kind": "candidate", "prev": "2891e90b58952f265037310af9fc5eb41d6a8326877698d6e2bdf73e4ecb70f2", "seq": 16}
