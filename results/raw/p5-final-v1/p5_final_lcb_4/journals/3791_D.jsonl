{"data": {"id": "93662a1c910e616de9b4b1add664997752a7dfdd250c9101151834365fcf85c6", "lineage": "93662a1c910e616de9b4b1add664997752a7dfdd250c9101151834365fcf85c6", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\n        # Initialize counters for fruits and baskets\n        f_count = Counter(fruits)\n        b_count = Counter(baskets)\n        \n        # Find the maximum frequency of any single fruit\n        max_freq_fruit = max(f_count.values())\n        \n        # Calculate the minimum number of baskets needed\n        min_baskets_needed = max_freq_fruit + 1\n        \n        # Calculate the number of unplaced fruits\n        unplaced_fruits = sum(f_count.values()) - min_baskets_needed * len(set(fruits))\n        \n        return unplaced_fruits"}, "kind": "candidate", "prev": "024017eb472912e19cb13c763785761cd742724adaa2ab55fb47cc7a8eaa134f", "seq": 21}
