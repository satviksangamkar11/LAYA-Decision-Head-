{"data": {"id": "ef834b97cd934d5ab5c52f525888b3ac8f696c3eded4a23a47e7b1993eb66f1b", "lineage": "ef834b97cd934d5ab5c52f525888b3ac8f696c3eded4a23a47e7b1993eb66f1b", "origin": "sample:2", "parent": null, "source": "from typing import List\n\nclass Solution:\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\n        # Initialize variables to keep track of the current window size, maximum frequency,\n        # and the total count of fruits remaining\n        window_size = 0\n        max_freq = 0\n        total_remaining = 0\n        \n        # Iterate through the array using a sliding window approach\n        for end in range(len(fruits)):\n            # Add the current fruit to the window\n            window_size += 1\n            \n            # Update the maximum frequency of the current window\n            max_freq = max(max_freq, fruits[end])\n            \n            # If the window size exceeds the capacity of a single basket, move the left pointer\n            while window_size > sum(baskets):\n                window_size -= 1\n                total_remaining += fruits[start]\n                start += 1\n                \n        # The total remaining fruits are those that cannot be placed in any basket\n        return total_remaining"}, "kind": "candidate", "prev": "20515dabe93d74fc8dffc4f645088d3e184b601b5d2d030d407a17fa4d938590", "seq": 11}
