{"data": {"id": "1961177dc1e739e86ce4a6f613b98b7f6a847cc01318933cfc71f8bd58ca2c0a", "lineage": "3d4f412d6dc268eec5d19cffe5e0450702c68eb1f7fe6e5437186348830591ca", "origin": "repair:3d4f412d6dc268eec5d19cffe5e0450702c68eb1f7fe6e5437186348830591ca", "parent": "3d4f412d6dc268eec5d19cffe5e0450702c68eb1f7fe6e5437186348830591ca", "source": "from typing import *\nimport collections\n\nclass Solution:\n    def numberOfComponents(self, properties: List[List[int]], k: int) -> int:\n        g = collections.defaultdict(set)\n        \n        for i in range(len(properties)):\n            for j in range(i+1, len(properties)):\n                if self.intersect(sorted(properties[i]), sorted(properties[j])) >= k:\n                    g[i].add(j)\n                    g[j].add(i)\n                    \n        visited = set()\n        count = 0\n        \n        for i in range(len(g)):\n            if i not in visited:\n                self.dfs(g, i, visited)\n                count += 1\n                \n        return count\n    \n    def dfs(self, g, u, visited):\n        visited.add(u)\n        for v in g[u]:\n            if v not in visited:\n                self.dfs(g, v, visited)\n                \n    def intersect(self, a, b):\n        return len(set(a).intersection(b))"}, "kind": "candidate", "prev": "28ad60ba23ceecdcce0f2c01e235d1955b370e5fd6c1bfe2f877b8b1d34385f8", "seq": 33}
