{"data": {"id": "385b26c7c7b8a440fe36e498a62dd6ed9eb78b5746ad3495ba9c42b7ef04eb47", "lineage": "385b26c7c7b8a440fe36e498a62dd6ed9eb78b5746ad3495ba9c42b7ef04eb47", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numberOfComponents(self, properties: List[List[int]], k: int) -> int:\n        graph = defaultdict(list)\n        for i in range(len(properties)):\n            for j in range(i + 1, len(properties)):\n                if self.intersect(properties[i], properties[j]) >= k:\n                    graph[i].append(j)\n                    graph[j].append(i)\n        \n        visited = set()\n        count = 0\n        for i in range(len(graph)):\n            if i not in visited:\n                dfs(graph, visited, i)\n                count += 1\n        \n        return count\n    \n    def intersect(self, a, b):\n        intersection = set(a).intersection(set(b))\n        return len(intersection)\n    \n    def dfs(self, graph, visited, node):\n        visited.add(node)\n        for neighbor in graph[node]:\n            if neighbor not in visited:\n                self.dfs(graph, visited, neighbor)"}, "kind": "candidate", "prev": "59b5a5c7ea452e8c169b082c72675dbe500581c67e0980dde26ff79a75451acd", "seq": 12}
