{"data": {"id": "05d291753ee1f81722449fc52167870f154fc47acedb0f524e80f71d5812234d", "lineage": "05d291753ee1f81722449fc52167870f154fc47acedb0f524e80f71d5812234d", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numberOfComponents(self, properties: List[List[int]], k: int) -> int:\n        # Create a dictionary to store the adjacency list for each property\n        adj_list = defaultdict(list)\n        \n        # Iterate through each property\n        for prop in properties:\n            # Check if the intersection of current property with another property is greater than or equal to k\n            for other_prop in properties:\n                if prop != other_prop and len(set(prop).intersection(other_prop)) >= k:\n                    # Add an edge from the current property to the other property\n                    adj_list[prop].append(other_prop)\n                    adj_list[other_prop].append(prop)\n        \n        # Initialize a set to keep track of visited nodes\n        visited = set()\n        \n        # Initialize a counter for connected components\n        count = 0\n        \n        # Perform DFS on each unvisited node\n        for node in adj_list:\n            if node not in visited:\n                dfs(node, adj_list, visited)\n                count += 1\n        \n        return count\n    \n    def dfs(self, node, adj_list, visited):\n        # Mark the current node as visited\n        visited.add(node)\n        \n        # Recursively visit all adjacent nodes\n        for neighbor in adj_list[node]:\n            if neighbor not in visited:\n                self.dfs(neighbor, adj_list, visited)"}, "kind": "candidate", "prev": "7070d47ef0a6ab3468b7ed9d32b3bcd6cd5fdb0ff37eac1b404feb58428ccb97", "seq": 24}
