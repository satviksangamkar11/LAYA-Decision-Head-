{"data": {"id": "d0989b82b926bc71ef1c3557274f189b8507b94b1f16a5ec498f1276d8f10851", "lineage": "d0989b82b926bc71ef1c3557274f189b8507b94b1f16a5ec498f1276d8f10851", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minCost(self, nums: List[int]) -> int:\n        if len(nums) == 0:\n            return 0\n        \n        # Sort the list to make it easier to handle the operations\n        nums.sort()\n        \n        total_cost = 0\n        \n        # Perform the operations based on the sorted list\n        for i in range(len(nums)):\n            if i < 2:\n                total_cost += nums[i]\n            else:\n                total_cost += max(nums[i-2], nums[i-1])\n        \n        return total_cost"}, "kind": "candidate", "prev": "76b1aaff3ef15fa8242e07d6281085aa7bee648896eac59af34cfcaba5684754", "seq": 21}
