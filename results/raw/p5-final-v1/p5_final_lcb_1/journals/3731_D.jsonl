{"data": {"id": "ffae8cc0352a63e711e75255efc6bd40cec15e859092fbc3452df68244cb7d7f", "lineage": "ffae8cc0352a63e711e75255efc6bd40cec15e859092fbc3452df68244cb7d7f", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def subarraySum(self, nums: List[int]) -> int:\n        n = len(nums)\n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            prefix_sum[i + 1] = prefix_sum[i] + nums[i]\n        \n        total_sum = 0\n        for i in range(n):\n            total_sum += prefix_sum[i + 1] - prefix_sum[max(0, i - nums[i])]\n        \n        return total_sum"}, "kind": "candidate", "prev": "27f42b055f9283bebd755526985fb0c2d0a3502b83098804e02da27ee55735a8", "seq": 11}
