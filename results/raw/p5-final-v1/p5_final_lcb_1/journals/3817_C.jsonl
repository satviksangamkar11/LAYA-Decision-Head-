{"data": {"id": "6497197cd13b8d10523900043355ec9983f46ab91545f4c93fc6f133c73cda66", "lineage": "6497197cd13b8d10523900043355ec9983f46ab91545f4c93fc6f133c73cda66", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport collections\n\nclass Solution:\n    def maxContainers(self, n: int, w: int, maxWeight: int) -> int:\n        # Initialize a counter for the number of containers\n        cnt = 0\n        \n        # Iterate over possible weights for the containers\n        for i in range(1, min(n * w + 1, maxWeight + 1)):\n            # Check if the current weight can be divided into n equal parts\n            if maxWeight % i == 0:\n                cnt += 1\n                \n        return cnt"}, "kind": "candidate", "prev": "8d6a051ef0e0472c0204bfd8330d29145440d92b2900b2378b41ec25aba5de62", "seq": 16}
