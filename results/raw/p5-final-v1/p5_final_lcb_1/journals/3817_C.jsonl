{"data": {"id": "704a09dc74274c3c0d22218087806f02bc9e85355c978d9b4aa4a615d11b4893", "lineage": "704a09dc74274c3c0d22218087806f02bc9e85355c978d9b4aa4a615d11b4893", "origin": "sample:2", "parent": null, "source": "class Solution:\n    def maxContainers(self, n: int, w: int, maxWeight: int) -> int:\n        # Initialize variables\n        result = 0\n        current_weight = 0\n        \n        # Iterate over possible combinations of containers\n        for i in range(1, n + 1):\n            # Check if adding another container would exceed the maximum weight\n            if current_weight + i * w > maxWeight:\n                break\n            # If adding the container doesn't exceed the weight limit, add it\n            current_weight += i * w\n            result += 1\n        \n        return result"}, "kind": "candidate", "prev": "7595f5eb3f6b3702775e1c733549d60c2c43f9f3f2a58b3dc3fdf980cebe6d39", "seq": 11}
