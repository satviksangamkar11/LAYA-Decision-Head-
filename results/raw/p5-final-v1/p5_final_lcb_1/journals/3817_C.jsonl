{"data": {"id": "141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "lineage": "141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxContainers(self, n: int, w: int, maxWeight: int) -> int:\n        dp = [[0] * (w + 1) for _ in range(n + 1)]\n        \n        # Base case: If there are no containers or no weight limit, return 0\n        if n == 0 or w == 0:\n            return 0\n        \n        # Fill the DP table\n        for i in range(1, n + 1):\n            for j in range(1, w + 1):\n                if j < i * w:\n                    dp[i][j] = dp[i - 1][j]\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i - 1][j - i * w] + i)\n        \n        return dp[n][w]"}, "kind": "candidate", "prev": "4363679933abac0ea337591646c645c1ec2616cca2b8674e26fb4003c77286d4", "seq": 21}
