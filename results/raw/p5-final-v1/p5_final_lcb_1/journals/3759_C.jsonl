{"data": {"id": "7c7d855c4bfb1827bd7a7d3734084e83a15c7d64c1dd17d1b8c63ed9e70a1ae7", "lineage": "7c7d855c4bfb1827bd7a7d3734084e83a15c7d64c1dd17d1b8c63ed9e70a1ae7", "origin": "sample:4", "parent": null, "source": "from typing import *\nimport heapq\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        # Initialize a min-heap to keep track of the top k values in nums2\n        heap = []\n        # Dictionary to store the count of elements in nums1\n        cnt = Counter(nums1)\n        \n        res = []\n        for num in nums1:\n            # If the current element is already in the result, skip it\n            if num in res:\n                continue\n            \n            # Add the difference between the current element and the smallest element in the heap\n            res.append(num - heap[0])\n            \n            # If the heap size exceeds k, remove the smallest element\n            if len(heap) > k:\n                heapq.heappop(heap)\n                \n            # Add the current element to the heap\n            heapq.heappush(heap, num - cnt[num])\n            \n            # If the current element has a frequency greater than 1, add its value to the heap\n            if cnt[num] > 1:\n                heapq.heappush(heap, num - (cnt[num] - 1))\n        \n        return res"}, "kind": "candidate", "prev": "105ab0d8e5e3a22e17f700aaaa55ed2096fe4debcc2d56e0c99fa37768367da2", "seq": 21}
