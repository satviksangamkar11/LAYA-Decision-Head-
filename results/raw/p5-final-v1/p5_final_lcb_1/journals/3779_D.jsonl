{"data": {"id": "547e9ef90b5812bc2852b167f3308e1d6851bef7f4fe673b49de728b64d99632", "lineage": "547e9ef90b5812bc2852b167f3308e1d6851bef7f4fe673b49de728b64d99632", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxWeight(self, pizzas: List[int]) -> int:\n        n = len(pizzas)\n        prefix_sum = [0] * (n + 1)\n        for i in range(1, n + 1):\n            prefix_sum[i] = prefix_sum[i - 1] + pizzas[i - 1]\n\n        dp = [[0] * 4 for _ in range(n // 4)]\n        for i in range(n // 4):\n            dp[i][0] = prefix_sum[n] - prefix_sum[i + 1]\n\n        for i in range(n // 4):\n            for j in range(i + 1, min(i + 4, n)):\n                if i % 2 == 0:\n                    dp[i][1] = max(dp[i][1], dp[i][0] + prefix_sum[j])\n                else:\n                    dp[i][1] = max(dp[i][1], dp[i][0] + prefix_sum[j] + pizzas[j])\n\n        return max(dp[-1])"}, "kind": "candidate", "prev": "17307f6ff7a81f72ccbe843ce9104e83a0be6629272a352cbcee2ec1297cac62", "seq": 11}
