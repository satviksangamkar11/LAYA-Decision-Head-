{"data": {"id": "2aceeed94e0abd75b30bd931424e30429cbccd45210f62cbb916d2a2ddb32466", "lineage": "2aceeed94e0abd75b30bd931424e30429cbccd45210f62cbb916d2a2ddb32466", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def maxContainers(self, n: int, w: int, maxWeight: int) -> int:\n        # Initialize the result counter\n        res = 0\n        \n        # Iterate over possible weights for the first container\n        for i in range(1, w + 1):\n            # Calculate the remaining weight after adding the current container\n            remaining_weight = maxWeight - i\n            \n            # Check if the remaining weight is sufficient to load the rest of the containers\n            if remaining_weight >= 0:\n                # Calculate the number of additional containers that can be loaded\n                additional_containers = min(n - 1, remaining_weight // i)\n                \n                # Update the result counter\n                res += additional_containers\n        \n        return res"}, "kind": "candidate", "prev": "4248f8f837c71cf0df3e3d4c636a993722633f2f560ff11231937de5b346d74f", "seq": 6}
