{"data": {"id": "8ee5b78ce9eb36072af190118ff70534f1878ac3d9408f641d3f1e2aa6fa616e", "lineage": "141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "origin": "repair:141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "parent": "141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "source": "class Solution:\n    def maxContainers(self, n: int, w: int, maxWeight: int) -> int:\n        # Initialize a DP table where dp[i][j] represents the maximum number of containers that can be loaded in i rows with a weight of j\n        dp = [[0] * (w + 1) for _ in range(n + 1)]\n        \n        # Base case: If there are no containers or no weight limit, return 0\n        if n == 0 or w == 0:\n            return 0\n        \n        # Fill the DP table\n        for i in range(1, n + 1):\n            for j in range(1, w + 1):\n                if j < i * w:\n                    dp[i][j] = dp[i - 1][j]\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i - 1][j - i * w] + i)\n        \n        return dp[n][w]"}, "kind": "candidate", "prev": "ec0c850a22605258e8c9fb5f3966949abbfebf27e50971d7f3a4d9f0193ba860", "seq": 29}
