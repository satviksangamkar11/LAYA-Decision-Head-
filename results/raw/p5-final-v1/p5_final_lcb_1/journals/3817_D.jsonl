{"data": {"answer_label": "BLOCKED", "candidate_id": "6497197cd13b8d10523900043355ec9983f46ab91545f4c93fc6f133c73cda66", "fails": 2, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED"}, "trusted_passes": 0, "validated_passes": 0}, "kind": "label", "prev": "2d95d697aec249b5f834643a024a501205182245b4355846bfcd7ed5934804d1", "seq": 20}
{"data": {"id": "141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "lineage": "141ad948a70f74edc03b0a4acb5784a6dc6d19a93edd70e816dcd12d01c07448", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxContainers(self, n: int, w: int, maxWeight: int) -> int:\n        dp = [[0] * (w + 1) for _ in range(n + 1)]\n        \n        # Base case: If there are no containers or no weight limit, return 0\n        if n == 0 or w == 0:\n            return 0\n        \n        # Fill the DP table\n        for i in range(1, n + 1):\n            for j in range(1, w + 1):\n                if j < i * w:\n                    dp[i][j] = dp[i - 1][j]\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i - 1][j - i * w] + i)\n        \n        return dp[n][w]"}, "kind": "candidate", "prev": "3e9392796809b3ab2fb47b39adf2a7e900ba6ee94ba729537583d419e9bf6114", "seq": 21}
