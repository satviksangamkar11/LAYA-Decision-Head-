{"data": {"id": "afc011886d07429e480d5c9cf77d3a05fc09e95a944f71a1ad17bc8048d52a6b", "lineage": "afc011886d07429e480d5c9cf77d3a05fc09e95a944f71a1ad17bc8048d52a6b", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def reverseDegree(self, s: str) -> int:\n        reverse_alphabet = {chr(i): i for i in range(97, 123)}\n        result = 0\n        \n        for index, char in enumerate(s):\n            result += reverse_alphabet[char] * (index + 1)\n            \n        return result"}, "kind": "candidate", "prev": "13c257d22482c6f2713a4ef42cf6762442219c6922afee7fce16eabb25d5ed65", "seq": 6}
