{"data": {"id": "83e6cb1f28f3130521807439b3fde815bb56933657b7611f174415a55554be43", "lineage": "83e6cb1f28f3130521807439b3fde815bb56933657b7611f174415a55554be43", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        # Create a dictionary to store the maximum value that can be reached from each index\n        max_values = {}\n        \n        # Iterate over the bounds list\n        for u, v in bounds:\n            # Update the maximum value for each index\n            if u not in max_values or v > max_values[u]:\n                max_values[u] = v\n        \n        # Initialize the result variable\n        res = 0\n        \n        # Iterate over the original list\n        for i in range(1, len(original)):\n            # Check if the difference between the current and previous elements is valid\n            if abs(original[i] - original[i - 1]) > max_values.get(original[i - 1], 0):\n                return 0\n            \n            # Increment the result variable\n            res += 1\n        \n        # Return the result variable\n        return res"}, "kind": "candidate", "prev": "63bedb0bfb7f6319f6cb739fbf01fcef83739d4849a9aca5e3fa898e5a29f6be", "seq": 24}
