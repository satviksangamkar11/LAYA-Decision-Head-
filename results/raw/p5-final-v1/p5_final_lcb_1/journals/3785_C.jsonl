{"data": {"id": "2b414a189ae7195a7f8d0243e9a3750163c1f18e60a26fb946d350d7cbc73d76", "lineage": "2b414a189ae7195a7f8d0243e9a3750163c1f18e60a26fb946d350d7cbc73d76", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        n = len(original)\n        dp = [1] * n\n        \n        # Initialize the first element\n        if bounds[0][0] <= original[0] <= bounds[0][1]:\n            dp[0] = 1\n            \n        # Iterate through the rest of the elements\n        for i in range(1, n):\n            if bounds[i][0] <= original[i] <= bounds[i][1]:\n                if i > 0:\n                    dp[i] = dp[i-1]\n                else:\n                    dp[i] = 1\n                \n                for j in range(i):\n                    if bounds[j][0] <= original[i] - original[j-1] <= bounds[j][1]:\n                        dp[i] += dp[j]\n                        \n        return dp[-1]"}, "kind": "candidate", "prev": "fd33125db06072c487bf178ed0e78008851b4be9274e2635d76c1d3617f7bd6d", "seq": 12}
