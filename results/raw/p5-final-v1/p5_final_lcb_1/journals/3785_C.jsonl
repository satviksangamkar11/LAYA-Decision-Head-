{"data": {"id": "b0472ef53ce03c3ed00b50712ebc7c0c6ffe69df74463c33e5d85683aa99e3d7", "lineage": "2b414a189ae7195a7f8d0243e9a3750163c1f18e60a26fb946d350d7cbc73d76", "origin": "repair:2b414a189ae7195a7f8d0243e9a3750163c1f18e60a26fb946d350d7cbc73d76", "parent": "2b414a189ae7195a7f8d0243e9a3750163c1f18e60a26fb946d350d7cbc73d76", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        n = len(original)\n        dp = [1] * n\n        \n        # Initialize the first element\n        if bounds[0][0] <= original[0] <= bounds[0][1]:\n            dp[0] = 1\n            \n        # Iterate through the rest of the elements\n        for i in range(1, n):\n            if bounds[i][0] <= original[i] <= bounds[i][1]:\n                if i > 0:\n                    dp[i] = dp[i-1]\n                else:\n                    dp[i] = 1\n                \n                for j in range(i):\n                    if bounds[j][0] <= original[i] - original[j-1] <= bounds[j][1]:\n                        dp[i] += dp[j]\n                        \n        # Handle large differences using long integers\n        for i in range(n):\n            dp[i] = dp[i] % (10**9 + 7)\n            \n        return dp[-1]"}, "kind": "candidate", "prev": "85fe9b0b24cf80e251852a2d8e3c5bc2d2040a6045a1debcf4e820942e0af05a", "seq": 38}
