{"data": {"id": "c53298a6ef737582ac8e4af9bd121f5330a987365d853d42a46a292f5d10a609", "lineage": "c53298a6ef737582ac8e4af9bd121f5330a987365d853d42a46a292f5d10a609", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int) -> int:\n        counter = Counter(nums)\n        freq_map = defaultdict(int)\n        max_freq = 0\n        \n        for num, count in counter.items():\n            if num + k not in freq_map:\n                freq_map[num + k] = 0\n            freq_map[num + k] += count\n            \n            while sum(freq_map.values()) > k:\n                left_num = list(freq_map.keys())[0]\n                freq_map[left_num] -= counter[left_num]\n                if freq_map[left_num] == 0:\n                    del freq_map[left_num]\n            \n            max_freq = max(max_freq, len(freq_map))\n        \n        return max_freq"}, "kind": "candidate", "prev": "840087fbedab93c6312c3891da8c6855ad8840a28d73f0f3500425e301b096fd", "seq": 6}
