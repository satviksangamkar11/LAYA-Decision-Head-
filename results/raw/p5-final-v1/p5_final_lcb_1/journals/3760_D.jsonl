{"data": {"id": "685d25edc7f64600055013bdc3df30166b831072b0e5dd0191d8a708279534ab", "lineage": "685d25edc7f64600055013bdc3df30166b831072b0e5dd0191d8a708279534ab", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\n        result = [-1] * len(groups)\n        element_map = defaultdict(list)\n        \n        # Group elements by their divisibility conditions\n        for i in range(len(elements)):\n            element_map[elements[i]].append(i)\n        \n        # Assign elements to groups\n        for i, group_size in enumerate(groups):\n            for element_index in element_map[group_size]:\n                if result[i] == -1:\n                    result[i] = element_index\n                    break\n        \n        return result"}, "kind": "candidate", "prev": "596a97a42a7c78176e4a591a8ae3a4b9821cb828018530fb7ea5ab4e964ddbfa", "seq": 12}
