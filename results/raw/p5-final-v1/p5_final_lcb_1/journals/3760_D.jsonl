{"data": {"id": "99a74b65820183ab39b702cab1e34ce15e944bbd2179c3bb2ce1ba342db5cc73", "lineage": "99a74b65820183ab39b702cab1e34ce15e944bbd2179c3bb2ce1ba342db5cc73", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\n        ans = [-1]*len(groups)\n        d = defaultdict(list)\n        for i in range(len(elements)):\n            d[elements[i]].append(i)\n        \n        for i in range(len(groups)):\n            for e in groups[i]:\n                if e in d:\n                    ans[i] = min(d[e])\n                    break\n        \n        return ans"}, "kind": "candidate", "prev": "66590febb1e12d044c38a1dcb5e321cd31a28548e8517011e2e1ef091c1a4050", "seq": 6}
