{"data": {"id": "7cb7c58c567a7af79be8b375143366dbab8ea5c99e13fa10378fcfd6ac521805", "lineage": "7cb7c58c567a7af79be8b375143366dbab8ea5c99e13fa10378fcfd6ac521805", "origin": "sample:3", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\n        assigned = [-1] * len(groups)\n        element_to_group = defaultdict(list)\n        \n        # Map elements to their corresponding groups\n        for i, g in enumerate(groups):\n            for e in elements:\n                if g % e == 0:\n                    element_to_group[e].append(i)\n        \n        # Assign elements to groups\n        for e, gs in element_to_group.items():\n            if gs:\n                min_index = min(gs)\n                assigned[min_index] = gs.index(min_index)\n        \n        return assigned"}, "kind": "candidate", "prev": "6d5fe4707d1745abe5a6373128407e083b051f86a062f03675ab9987095ae3dd", "seq": 18}
