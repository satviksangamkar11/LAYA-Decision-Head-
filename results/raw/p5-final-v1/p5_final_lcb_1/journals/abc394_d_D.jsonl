{"data": {"id": "daf93a01210345e3b78fee1207fac7b8bd9878cddc0887c75966293d750cdda7", "lineage": "daf93a01210345e3b78fee1207fac7b8bd9878cddc0887c75966293d750cdda7", "origin": "sample:1", "parent": null, "source": "def is_colorful_bracket_sequence(s):\n    stack = []\n    \n    for char in s:\n        if char in '([{':\n            stack.append(char)\n        elif char == ')':\n            if not stack or stack[-1] != '(':\n                return False\n            stack.pop()\n        elif char == ']':\n            if not stack or stack[-1] != '[':\n                return False\n            stack.pop()\n        elif char == '>':\n            if not stack or stack[-1] != '<':\n                return False\n            stack.pop()\n    \n    return len(stack) == 0\n\n# Example usage:\ns = input().strip()\nif is_colorful_bracket_sequence(s):\n    print(\"Yes\")\nelse:\n    print(\"No\")"}, "kind": "candidate", "prev": "7840dd60be8f4fdad40d90889598d2061302204da3dd92dd1c32110f37f53f09", "seq": 6}
