{"data": {"id": "fed317f41052e844fce447435e48fafbc5888d63663af3bde2d91e00ee6cf875", "lineage": "fed317f41052e844fce447435e48fafbc5888d63663af3bde2d91e00ee6cf875", "origin": "sample:1", "parent": null, "source": "def simulate_stones(N, A):\n    stones = A[:]\n    for _ in range(N):\n        for i in range(1, N):\n            if stones[i] >= 1:\n                stones[i - 1] += 1\n                stones[i] -= 1\n    return stones\n\n# Example usage\nN = int(input())\nstones = list(map(int, input().split()))\nprint(' '.join(map(str, simulate_stones(N, stones))))"}, "kind": "candidate", "prev": "77131c521fe1b6ce5f12eb769581e8557b348491e4464329e49c143452caacd3", "seq": 6}
