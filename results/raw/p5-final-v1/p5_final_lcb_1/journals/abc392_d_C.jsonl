{"data": {"n": 4, "prompt_sha": ["9271abb8396b8a19c394b679d2bd75db02850ef17257ab7529955761dc315d1d"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "a9624e58d7d8bd954c3fd66bdfc30d1f8c4630fafa34078a087e59ec705a4223", "seq": 5}
{"data": {"id": "2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "lineage": "2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "origin": "sample:1", "parent": null, "source": "def max_dice_probability(n, k_list, a_list):\n    # Initialize a dictionary to store the frequency of each number on each die\n    freq_dict = {}\n    \n    # Calculate the total number of possible outcomes for each die\n    total_outcomes = sum(k_list)\n    \n    # Iterate over each die and calculate the frequency of each number\n    for i in range(n):\n        for j in range(k_list[i]):\n            num = a_list[i][j]\n            if num in freq_dict:\n                freq_dict[num] += 1\n            else:\n                freq_dict[num] = 1\n    \n    # Calculate the maximum probability\n    max_prob = 0\n    for num in freq_dict:\n        prob = freq_dict[num] / total_outcomes\n        if prob > max_prob:\n            max_prob = prob\n    \n    return max_prob\n\n# Read input\nn = int(input())\nk_list = []\na_list = []\nfor _ in range(n):\n    k = int(input())\n    a = list(map(int, input().split()))\n    k_list.append(k)\n    a_list.append(a)\n\n# Print output\nprint(max_dice_probability(n, k_list, a_list))"}, "kind": "candidate", "prev": "e07272ade8a5f2688441265412a0212598ba5c9cd4a8f68f31c37a7fc6905c39", "seq": 6}
