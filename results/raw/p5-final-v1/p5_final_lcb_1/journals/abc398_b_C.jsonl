{"data": {"id": "9f24a983ba81106c6354e60cb5ef5bf3598184d13db434e17e96b94c1c0bc5a2", "lineage": "9f24a983ba81106c6354e60cb5ef5bf3598184d13db434e17e96b94c1c0bc5a2", "origin": "sample:3", "parent": null, "source": "def check_full_house(cards):\n    # Count occurrences of each number\n    counts = {}\n    for card in cards:\n        if card in counts:\n            counts[card] += 1\n        else:\n            counts[card] = 1\n    \n    # Check for exactly two numbers with count 3 and one number with count 2\n    return any(count == 3 for count in counts.values()) and sum(count == 2 for count in counts.values()) == 1\n\n# Read input\ncards = list(map(int, input().split()))\n\n# Check if a full house exists\nresult = \"Yes\" if check_full_house(cards) else \"No\"\nprint(result)"}, "kind": "candidate", "prev": "53a028569a5a0e686376462042ae60c43ca75e5e5940c15543831ca32577c14f", "seq": 14}
