{"data": {"id": "f08a61283c69f56683b1c55dfc466e9e848b0a6d7e7b9687046cf60450dbadcf", "lineage": "2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "origin": "repair:2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "parent": "2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "source": "def max_dice_probability(n, k_list, a_list):\n    # Initialize a dictionary to store the frequency of each number on each die\n    freq_dict = {}\n    \n    # Calculate the total number of possible outcomes for each die\n    total_outcomes = sum(k_list)\n    \n    # Iterate over each die and calculate the frequency of each number\n    for i in range(n):\n        for j in range(k_list[i]):\n            num = int(a_list[i][j])  # Corrected line: convert string to integer\n            if num in freq_dict:\n                freq_dict[num] += 1\n            else:\n                freq_dict[num] = 1\n    \n    # Calculate the maximum probability\n    max_prob = 0\n    for num in freq_dict:\n        prob = freq_dict[num] / total_outcomes\n        if prob > max_prob:\n            max_prob = prob\n    \n    return max_prob\n\n# Read input\nn = int(input())\nk_list = []\na_list = []\nfor _ in range(n):\n    k = int(input())  # Corrected line: convert string to integer\n    a = list(map(str, input().split()))  # Convert each element to string before splitting\n    k_list.append(k)\n    a_list.append(a)\n\n# Print output\nprint(max_dice_probability(n, k_list, a_list))"}, "kind": "candidate", "prev": "019b6094692e171731dd2de3f0155794c5248588ef3e8b7faf531ec5ae514369", "seq": 29}
