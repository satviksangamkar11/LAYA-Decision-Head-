{"data": {"evidence": {"artifact_hash": "ce5734c7f0810a6d7e12bc4466ddbcaa9fdf6256d5dc42821b242dc6798977d9", "candidate_id": "ce5734c7f0810a6d7e12bc4466ddbcaa9fdf6256d5dc42821b242dc6798977d9", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0009", "independence": "independent", "produced_at": "t9", "receipt_hash": "55f8b44d6cc392c26f1eb01b899d2535268d37359583a863933b87cadffbc39a", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "0b66a5fe11c32ec9e0c6ff19d5fbfedf60ced1a0ad9b3b936fc00ec58437b10b", "seq": 19}
