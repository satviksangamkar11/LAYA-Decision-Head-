{"data": {"n": 4, "prompt_sha": ["9271abb8396b8a19c394b679d2bd75db02850ef17257ab7529955761dc315d1d"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "f9b7a743272bae231ba424e1609c603323b4f7c25863735fca314f5685f0f841", "seq": 5}
{"data": {"id": "2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "lineage": "2689ac16464a5d9942d62760f8d94fe99a251ab36a5207924f0aefb002df47e3", "origin": "sample:1", "parent": null, "source": "def max_dice_probability(n, k_list, a_list):\n    # Initialize a dictionary to store the frequency of each number on each die\n    freq_dict = {}\n    \n    # Calculate the total number of possible outcomes for each die\n    total_outcomes = sum(k_list)\n    \n    # Iterate over each die and calculate the frequency of each number\n    for i in range(n):\n        for j in range(k_list[i]):\n            num = a_list[i][j]\n            if num in freq_dict:\n                freq_dict[num] += 1\n            else:\n                freq_dict[num] = 1\n    \n    # Calculate the maximum probability\n    max_prob = 0\n    for num in freq_dict:\n        prob = freq_dict[num] / total_outcomes\n        if prob > max_prob:\n            max_prob = prob\n    \n    return max_prob\n\n# Read input\nn = int(input())\nk_list = []\na_list = []\nfor _ in range(n):\n    k = int(input())\n    a = list(map(int, input().split()))\n    k_list.append(k)\n    a_list.append(a)\n\n# Print output\nprint(max_dice_probability(n, k_list, a_list))"}, "kind": "candidate", "prev": "3d4cafb3da033d2875b607124ad360111a9ba07ef8958fbdb8456a3e9dc215b0", "seq": 6}
