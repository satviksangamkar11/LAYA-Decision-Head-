{"data": {"id": "d59f38e0d75ccd63f2cb7405f95b104439d413884e20c81847a41cce647da923", "lineage": "d59f38e0d75ccd63f2cb7405f95b104439d413884e20c81847a41cce647da923", "origin": "sample:2", "parent": null, "source": "import sys\nfrom collections import Counter\n\ndef main():\n    n = int(sys.stdin.readline())\n    dice_counts = [Counter() for _ in range(n)]\n    \n    for _ in range(n):\n        k, *faces = map(int, sys.stdin.readline().split())\n        dice_counts[_].update(faces)\n    \n    max_prob = 0\n    \n    for i in range(n):\n        for j in range(i+1, n):\n            common_faces = dice_counts[i] & dice_counts[j]\n            total_faces = len(common_faces)\n            max_prob = max(max_prob, total_faces / (k * k))\n    \n    print(max_prob)\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "fe9258dc6ca349d1fe7d29c76237f29de1501c3c2919e3e5e93b62557988b396", "seq": 11}
