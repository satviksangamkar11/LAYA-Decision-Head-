{"data": {"id": "99368754319fa427e83deecc63fc7091c0d3c83bf7671b7cead269a79c10b029", "lineage": "99368754319fa427e83deecc63fc7091c0d3c83bf7671b7cead269a79c10b029", "origin": "sample:4", "parent": null, "source": "def calculate_max_same_probability(N, dice_faces):\n    max_prob = 0.0\n    for i in range(N):\n        for j in range(i+1, N):\n            common_faces = set(dice_faces[i]) & set(dice_faces[j])\n            total_faces = len(dice_faces[i]) * len(dice_faces[j])\n            prob = len(common_faces) / total_faces\n            if prob > max_prob:\n                max_prob = prob\n    return round(max_prob, 8)\n\n# Read input\nN = int(input())\ndice_faces = []\nfor _ in range(N):\n    K = int(input())\n    dice_faces.append(list(map(int, input().split())))\n\n# Calculate and print the result\nprint(calculate_max_same_probability(N, dice_faces))"}, "kind": "candidate", "prev": "2d5dd5162e4f99001bef7bf254f1a0116a229caf1ac7d7eb15fd033df187c0d2", "seq": 21}
