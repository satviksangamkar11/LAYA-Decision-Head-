{"data": {"id": "61d8d4a05f6bb5748eac4c46b2896ea7d7659e636d87bda307097f2b93ad1288", "lineage": "61d8d4a05f6bb5748eac4c46b2896ea7d7659e636d87bda307097f2b93ad1288", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int) -> int:\n        freq_map = defaultdict(int)\n        current_sum = 0\n        \n        left = 0\n        max_freq = 0\n        \n        for right in range(len(nums)):\n            current_sum += nums[right]\n            \n            while current_sum > k + right - left:\n                current_sum -= nums[left]\n                left += 1\n            \n            max_freq = max(max_freq, right - left + 1)\n        \n        return max_freq"}, "kind": "candidate", "prev": "00c381715cec435880508ff00de75308f087081cd97573371ae72e615823ebe7", "seq": 11}
