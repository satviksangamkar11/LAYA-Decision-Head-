{"data": {"id": "f78d8b0af392ae5713cb1017790c5c724b2bc9fd8f55299e27ec542626bbed57", "lineage": "61d8d4a05f6bb5748eac4c46b2896ea7d7659e636d87bda307097f2b93ad1288", "origin": "repair:61d8d4a05f6bb5748eac4c46b2896ea7d7659e636d87bda307097f2b93ad1288", "parent": "61d8d4a05f6bb5748eac4c46b2896ea7d7659e636d87bda307097f2b93ad1288", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxFrequency(self, nums: List[int], k: int) -> int:\n        freq_map = defaultdict(int)\n        current_sum = 0\n        left = 0\n        max_freq = 0\n        \n        for right in range(len(nums)):\n            current_sum += nums[right]\n            \n            while current_sum > k + right - left:\n                current_sum -= nums[left]\n                left += 1\n            \n            freq_map[nums[right]] += 1\n            max_freq = max(max_freq, freq_map[nums[right]])\n        \n        return max_freq"}, "kind": "candidate", "prev": "7fe8d947d95de9771ec565f68346532f665d827565f3059f9ec06c2347ad804f", "seq": 29}
