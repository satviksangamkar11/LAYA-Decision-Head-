{"data": {"id": "5041240aea15f0c6ceecfc90797a2970eab035f2aa3a745b005f7e12c62ca307", "lineage": "5041240aea15f0c6ceecfc90797a2970eab035f2aa3a745b005f7e12c62ca307", "origin": "sample:2", "parent": null, "source": "import sys\n\ndef main():\n    N = int(sys.stdin.readline())\n    stones = list(map(int, sys.stdin.readline().split()))\n\n    # Initialize the number of stones each alien has at time 0\n    stones_at_time = [stone for stone in stones]\n\n    # Simulate the process of becoming adults and giving stones\n    for _ in range(N):\n        # Calculate the number of stones given away\n        stones_given_away = sum(stones)\n        \n        # Update the number of stones each alien has at the next time step\n        for i in range(len(stones)):\n            if stones[i] >= 1:\n                stones[i] -= 1\n                stones_given_away += 1\n        \n        # Add the stones given away to the current time step's stones\n        for i in range(len(stones)):\n            stones_at_time[i] += stones_given_away\n    \n    # Write the result to stdout\n    print(' '.join(map(str, stones_at_time)))\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "397c03e40586ab89f7cadfe1cb85bcde748d5a4c648859fa878c5d65ff8c7b2b", "seq": 12}
