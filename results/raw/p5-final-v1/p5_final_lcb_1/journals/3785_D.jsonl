{"data": {"id": "ad6f0c3e2a1d3600c5a6a2249bec54aa6417621a5a0c1292241cb50f00f70135", "lineage": "ad6f0c3e2a1d3600c5a6a2249bec54aa6417621a5a0c1292241cb50f00f70135", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countArrays(self, original: List[int], bounds: List[List[int]]) -> int:\n        n = len(original)\n        if n == 1:\n            return 1\n        \n        # Sort the bounds by the start value\n        bounds.sort(key=lambda x: x[0])\n        \n        # Initialize variables\n        dp = [1] * n\n        prev_bound = None\n        \n        # Iterate through each element in the original array\n        for i in range(1, n):\n            # Find the rightmost bound that includes the current element\n            j = bisect_right(bounds, (original[i], float('inf')))\n            \n            # Update the DP array based on the previous bound\n            if prev_bound:\n                dp[i] += dp[j-1]\n            else:\n                dp[i] = 1\n            \n            # Update the previous bound\n            prev_bound = bounds[j-1]\n        \n        return dp[-1]"}, "kind": "candidate", "prev": "cf23d7af8a8a95367249a5a1ad0eae9a907ee814ab4198cb3daadbd05364e409", "seq": 6}
