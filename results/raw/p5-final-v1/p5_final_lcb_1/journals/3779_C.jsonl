{"data": {"id": "251d944081b1de7c64c162dfeb400ea3f782e4e0fa79f54cce9a22c552fca42d", "lineage": "251d944081b1de7c64c162dfeb400ea3f782e4e0fa79f54cce9a22c552fca42d", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport math\n\nclass Solution:\n    def maxWeight(self, pizzas: List[int]) -> int:\n        pizzas.sort(reverse=True)\n        dp = [0] * len(pizzas)\n        for i in range(len(pizzas)):\n            if i % 4 == 0:\n                dp[i] = sum(pizzas[:i+1])\n            else:\n                dp[i] = dp[i-1] + pizzas[i]\n        return dp[-1]"}, "kind": "candidate", "prev": "68236f32074532b7952775bd43826a3d3269ad413279dbb7ceb0bcd7ec9c4c11", "seq": 16}
