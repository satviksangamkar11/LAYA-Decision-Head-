{"data": {"id": "013f082c3d8575a85d0d7f5c511afc0d1e250b9a06cf33cd1238e6ffcfca2d64", "lineage": "013f082c3d8575a85d0d7f5c511afc0d1e250b9a06cf33cd1238e6ffcfca2d64", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxWeight(self, pizzas: List[int]) -> int:\n        n = len(pizzas)\n        dp = [[0] * (n // 4 + 1) for _ in range(n)]\n        \n        # Base case: if there's no pizza, we don't gain any weight\n        for j in range(1, n // 4 + 1):\n            dp[0][j] = 0\n        \n        # Fill the DP table\n        for i in range(1, n):\n            for j in range(1, min(i // 4 + 1, n // 4 + 1)):\n                for k in range(j, min(i // 4 + 1, n // 4 + 1)):\n                    dp[i][j] = max(dp[i][j], dp[i - 1][k] + pizzas[i - 1])\n                    if i % 2 == 0:\n                        dp[i][j] = max(dp[i][j], dp[i - 1][j - 1] + pizzas[i - 1])\n                    else:\n                        dp[i][j] = max(dp[i][j], dp[i - 1][j - 1] + pizzas[i - 1])\n        \n        return dp[n - 1][n // 4]"}, "kind": "candidate", "prev": "7a82798f9086f7ac9a4d639094f0c53945e6fb04e8e894610dbe386bae18d269", "seq": 21}
