{"data": {"id": "daf93a01210345e3b78fee1207fac7b8bd9878cddc0887c75966293d750cdda7", "lineage": "daf93a01210345e3b78fee1207fac7b8bd9878cddc0887c75966293d750cdda7", "origin": "sample:1", "parent": null, "source": "def is_colorful_bracket_sequence(s):\n    stack = []\n    \n    for char in s:\n        if char in '([{':\n            stack.append(char)\n        elif char == ')':\n            if not stack or stack[-1] != '(':\n                return False\n            stack.pop()\n        elif char == ']':\n            if not stack or stack[-1] != '[':\n                return False\n            stack.pop()\n        elif char == '>':\n            if not stack or stack[-1] != '<':\n                return False\n            stack.pop()\n    \n    return len(stack) == 0\n\n# Example usage:\ns = input().strip()\nif is_colorful_bracket_sequence(s):\n    print(\"Yes\")\nelse:\n    print(\"No\")"}, "kind": "candidate", "prev": "cdfcc022a08ad444741fd05306850abd651eef62ab826274eafb4ef68b085240", "seq": 6}
