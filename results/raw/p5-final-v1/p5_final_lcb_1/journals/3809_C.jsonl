{"data": {"id": "cd3cffd3ea1c767106b63c7b28780401e45a8aad300e0b9d40487b6d2933e07d", "lineage": "cd3cffd3ea1c767106b63c7b28780401e45a8aad300e0b9d40487b6d2933e07d", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def numberOfComponents(self, properties: List[List[int]], k: int) -> int:\n        parent = list(range(len(properties)))\n        size = [1]*len(properties)\n        \n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n        \n        def union(x,y):\n            root_x = find(x)\n            root_y = find(y)\n            \n            if root_x == root_y:\n                return\n            \n            if size[root_x] > size[root_y]:\n                root_x, root_y = root_y, root_x\n                \n            parent[root_y] = root_x\n            size[root_x] += size[root_y]\n        \n        for prop in properties:\n            for other_prop in properties:\n                if prop != other_prop and intersect(prop,other_prop)>=k:\n                    union(prop[0],other_prop[0])\n                    \n        return len(set(find(i) for i in range(len(properties))))\n    \ndef intersect(a,b):\n    return len(set(a)&set(b))"}, "kind": "candidate", "prev": "2ffd805c648b5a9f14423e7a03861024060b413b49b490b2363a34fe3b57b4f6", "seq": 6}
