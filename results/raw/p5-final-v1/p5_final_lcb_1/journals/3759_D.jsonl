{"data": {"id": "f2732030d84485b03b2df8833c39c0df5639fe4782b01725c121ee717ebfda53", "lineage": "3022dcac485b6861ac61ddc862d844c3297f8ce5aa4a859d10d215ca61f54e17", "origin": "repair:3022dcac485b6861ac61ddc862d844c3297f8ce5aa4a859d10d215ca61f54e17", "parent": "3022dcac485b6861ac61ddc862d844c3297f8ce5aa4a859d10d215ca61f54e17", "source": "from typing import *\nimport heapq\n\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        res = []\n        heap1 = []\n        heap2 = []\n        \n        # Push the first k elements of nums1 into the min-heap\n        for i in range(k):\n            heapq.heappush(heap1, (-nums1[i], nums2[i]))\n        \n        # Iterate through the remaining elements of nums1\n        for i in range(k, len(nums1)):\n            heapq.heappush(heap1, (-nums1[i], nums2[i]))\n            \n            # Pop the smallest element from heap1\n            _, val = heapq.heappop(heap1)\n            res.append(val)\n            \n            # Push the next k elements of nums2 into the max-heap\n            for j in range(i - k + 1, i + 1):\n                if j < len(nums2) and nums2[j] > res[-1]:\n                    heapq.heappush(heap2, (-nums2[j], nums2[j]))\n            \n            # If the max-heap has more elements than k, pop the smallest one\n            while len(heap2) > k:\n                _, val = heapq.heappop(heap2)\n                res.append(val)\n        \n        return res"}, "kind": "candidate", "prev": "242bc6975e8f9ecc6995a3b895cceddc95d037a3f7746887438a243aef55f9f0", "seq": 34}
