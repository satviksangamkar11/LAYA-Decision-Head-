{"data": {"id": "0b924fb1392c6130ad70371c93a0507b7291ade7b86b5b6ef0f611746c31241c", "lineage": "0b924fb1392c6130ad70371c93a0507b7291ade7b86b5b6ef0f611746c31241c", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport heapq\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        max_heap = []\n        res = []\n        for i in range(len(nums1)):\n            # Add elements of nums2 to the heap\n            heapq.heappush(max_heap, (-nums2[i], i))\n            \n            # Pop the top element from the heap if it's not in the current window\n            while len(max_heap) > k:\n                _, idx = heapq.heappop(max_heap)\n                if idx >= i:\n                    break\n            \n            # If the heap is not empty, calculate the maximum sum\n            if max_heap:\n                res.append(-max_heap[0][0])\n            else:\n                res.append(0)\n        \n        return res"}, "kind": "candidate", "prev": "c1f444029cc08912111584c1545ca433d57491030c56339e70458e7956c94938", "seq": 16}
