{"data": {"id": "7a5f8828c9ebb900cf65d67a9242058c7b7f20f29f6da6e12aa00ae031dec080", "lineage": "7a5f8828c9ebb900cf65d67a9242058c7b7f20f29f6da6e12aa00ae031dec080", "origin": "sample:2", "parent": null, "source": "from typing import *\nimport heapq\n\nclass Solution:\n    def findMaxSum(self, nums1: List[int], nums2: List[int], k: int) -> List[int]:\n        n = len(nums1)\n        # Initialize the heap with the first element of nums1 and its corresponding index in nums2\n        h = [(nums1[0], i) for i in range(n)]\n        heapq.heapify(h)\n        res = []\n        \n        # Iterate through the remaining elements in nums1\n        for i in range(1, n):\n            while h and h[0][0] < nums1[i]:\n                val, idx = heapq.heappop(h)\n                res.append(val * nums2[idx])\n            \n            if not h or len(res) >= k:\n                break\n            \n            # If there are still elements in nums1, add the next smallest value from nums2 to the heap\n            heapq.heappush(h, (nums1[i], i))\n        \n        # If there are still elements left in the heap, add them to the result\n        while h:\n            val, idx = heapq.heappop(h)\n            res.append(val * nums2[idx])\n        \n        return res[:k]"}, "kind": "candidate", "prev": "f6fcbc66cd9f94ec77d0a6852cfb0339df0192e1a5a7fa0d598e741391a5028c", "seq": 11}
