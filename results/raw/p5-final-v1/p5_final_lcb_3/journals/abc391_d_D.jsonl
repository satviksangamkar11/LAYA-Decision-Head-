{"data": {"id": "b14fe4795bf1f937acf81fcc601631b58255bd26ce2c11287f3ae84bdfad6cce", "lineage": "b14fe4795bf1f937acf81fcc601631b58255bd26ce2c11287f3ae84bdfad6cce", "origin": "sample:2", "parent": null, "source": "import sys\nfrom collections import defaultdict\n\ndef main():\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    N, W = data[0], data[1]\n    data = data[2:]\n    \n    # Build adjacency list for the graph\n    graph = defaultdict(list)\n    for x, y in zip(data[::2], data[1::2]):\n        graph[y].append(x)\n    \n    # Build the matrix to represent the grid\n    grid = [[False] * W for _ in range(N)]\n    for i in range(N):\n        for j in range(W):\n            grid[i][j] = True\n    \n    # Process the queries\n    Q = data[-1]\n    queries = [data[i:i+2] for i in range(0, 2 * Q, 2)]\n    \n    for T, A in queries:\n        T -= 1\n        if T >= N - 1:\n            print(\"Yes\")\n        elif T < N - 1 and T % 2 == 0:\n            print(\"Yes\")\n        else:\n            print(\"No\")\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "9c5ceac014d1e84468003502d4c85dbe9b8a22e88f56125b7f6ec973395b22e9", "seq": 11}
