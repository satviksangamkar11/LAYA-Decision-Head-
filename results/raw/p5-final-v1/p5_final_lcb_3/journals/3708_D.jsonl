{"data": {"id": "9f5a68f764a09d4567226b4401b158c5a8878f4c4b3ed018823a558994d9ac96", "lineage": "9f5a68f764a09d4567226b4401b158c5a8878f4c4b3ed018823a558994d9ac96", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\n        res = []\n        n, m = len(grid), len(grid[0])\n        \n        for i in range(n):\n            if i % 2 == 0:\n                # Traverse from left to right\n                for j in range(m):\n                    res.append(grid[i][j])\n            else:\n                # Traverse from right to left\n                for j in range(m-1, -1, -1):\n                    res.append(grid[i][j])\n        \n        return res"}, "kind": "candidate", "prev": "c72a5768426ed650a3295000e1f625ecf4d7c4485196e54107d7eeb6ad30e6b5", "seq": 24}
