{"data": {"id": "869b3f0f98deaea201f256dddc34a70819d206c8a9c0253aa1432fdb7f7664e8", "lineage": "869b3f0f98deaea201f256dddc34a70819d206c8a9c0253aa1432fdb7f7664e8", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\n        if not grid or not grid[0]: return []\n        res = []\n        row, col = len(grid), len(grid[0])\n        i, j = 0, 0\n        \n        while i < row and j < col:\n            res.append(grid[i][j])\n            \n            # Right traversal\n            if j + 1 < col and i % 2 == 0:\n                j += 1\n            else:\n                i += 1\n            \n            # Left traversal\n            if j - 1 >= 0 and i % 2 != 0:\n                j -= 1\n            else:\n                i += 1\n                \n        return res"}, "kind": "candidate", "prev": "99b805154a735af861bf549a7ef51df86d16f82fdfa1ef734e0f36c82ad9f371", "seq": 12}
