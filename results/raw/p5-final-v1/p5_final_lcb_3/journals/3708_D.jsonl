{"data": {"id": "c392c0526eb52030acac11d1654be2072fe40b68df11367b1175bcddc269836f", "lineage": "869b3f0f98deaea201f256dddc34a70819d206c8a9c0253aa1432fdb7f7664e8", "origin": "repair:869b3f0f98deaea201f256dddc34a70819d206c8a9c0253aa1432fdb7f7664e8", "parent": "869b3f0f98deaea201f256dddc34a70819d206c8a9c0253aa1432fdb7f7664e8", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\n        if not grid or not grid[0]: return []\n        res = []\n        row, col = len(grid), len(grid[0])\n        i, j = 0, 0\n        \n        while i < row and j < col:\n            res.append(grid[i][j])\n            \n            # Right traversal\n            if j + 1 < col and i % 2 == 0:\n                j += 1\n            elif j - 1 >= 0 and i % 2 != 0:\n                j -= 1\n            else:\n                # Change direction when reaching the boundary\n                if i % 2 == 0:\n                    i += 1\n                else:\n                    i -= 1\n                    \n        return res"}, "kind": "candidate", "prev": "28ca250c4829bd00fc6cd0a37274eae69427045ee8b458f40be8b06f8e71d02a", "seq": 44}
