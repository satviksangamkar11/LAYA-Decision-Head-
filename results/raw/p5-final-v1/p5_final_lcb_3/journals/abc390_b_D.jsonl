{"data": {"id": "9a1366c1d99e60ae2a7b5972f5619c3567cb01222231d6ba839f014976895fd2", "lineage": "9a1366c1d99e60ae2a7b5972f5619c3567cb01222231d6ba839f014976895fd2", "origin": "sample:4", "parent": null, "source": "def is_geometric_progression(A):\n    if len(A) < 2:\n        return \"Yes\"\n    \n    ratio = A[1] / A[0]\n    for i in range(2, len(A)):\n        if A[i] != ratio * A[i - 1]:\n            return \"No\"\n    \n    return \"Yes\"\n\n# Example usage\nN = int(input())\nA = list(map(int, input().split()))\n\nprint(is_geometric_progression(A))"}, "kind": "candidate", "prev": "910a99b460a5730adb45bd894a2a91110d579d75aee52ca485e441d822ccb192", "seq": 26}
