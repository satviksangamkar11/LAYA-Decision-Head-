{"data": {"id": "936458f95a38542d19475d9f5f8ed49ff76859ea9948eac62adf84c533ba7463", "lineage": "936458f95a38542d19475d9f5f8ed49ff76859ea9948eac62adf84c533ba7463", "origin": "sample:1", "parent": null, "source": "def check_geometric_progression(sequence):\n    if len(sequence) < 2:\n        return \"Yes\"  # A sequence with less than 2 elements is trivially a geometric progression\n    \n    common_ratio = sequence[1] / sequence[0]\n    \n    for i in range(2, len(sequence)):\n        if sequence[i] / sequence[i - 1] != common_ratio:\n            return \"No\"\n    \n    return \"Yes\"\n\n# Example usage\ninput_sequence = list(map(int, input().split()))\nprint(check_geometric_progression(input_sequence))"}, "kind": "candidate", "prev": "7fb936b70ee3090a478986a45730f6c75ca50ba36f58c96f51b78a58f5b4024d", "seq": 6}
