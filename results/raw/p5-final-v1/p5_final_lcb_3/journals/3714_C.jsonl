{"data": {"n": 4, "prompt_sha": ["1a6cd5d717fc8927c0a7bd9cfce131a048885c5ef349e99476824e68e3fb6fe5"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "e360818714b3822b8832d1b1efeb09c0e30c666ccd0acd1c98bf0001448d3cdb", "seq": 5}
{"data": {"id": "b27c26b651520d2faa9ee1ac0c2e35cf293d6f5dcc9a3871466bdb1bd7131473", "lineage": "b27c26b651520d2faa9ee1ac0c2e35cf293d6f5dcc9a3871466bdb1bd7131473", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        if k == n:\n            return sum(nums) % (10**9+7)\n        \n        # Sort the numbers in ascending order\n        nums.sort()\n        \n        # Calculate the sum of the first k elements\n        s = sum(nums[:k])\n        \n        # Calculate the sum of the last k elements\n        s += sum(nums[n-k:])\n        \n        # Return the sum modulo 10^9 + 7\n        return s % (10**9+7)"}, "kind": "candidate", "prev": "aa840fe227fc63cc91cd159fe5fde9c9df700358a09b4b6f65a6b391b5cb271a", "seq": 6}
