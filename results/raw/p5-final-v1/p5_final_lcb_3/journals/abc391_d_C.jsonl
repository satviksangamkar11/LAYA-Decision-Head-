{"data": {"id": "3bce3b141a59209645f8e12c082ac30d94603892a5db2aa9aa669bcaf86e0576", "lineage": "3bce3b141a59209645f8e12c082ac30d94603892a5db2aa9aa669bcaf86e0576", "origin": "sample:1", "parent": null, "source": "def check_block_exists(N, W, X, Y, Q, T, A):\n    # Create a list to represent the grid\n    grid = [[0] * W for _ in range(N)]\n    \n    # Place the blocks initially\n    for x, y in zip(X, Y):\n        grid[y - 1][x - 1] = 1\n    \n    # Move the blocks\n    for t in range(1, 10**101):\n        if all(grid[-1]):\n            break\n        \n        for y in range(N - 2, -1, -1):\n            for x in range(W):\n                if grid[y][x] == 1 and (y == N - 2 or grid[y + 1][x] == 0):\n                    grid[y][x] = 0\n    \n    # Check if block A exists at time T+0.5\n    return 'Yes' if grid[T % N][A - 1] else 'No'\n\n# Read input\nN, W = map(int, input().split())\nX = [int(x) for x in input().split()]\nY = [int(y) for y in input().split()]\nQ = int(input())\n\n# Process each query\nfor _ in range(Q):\n    T, A = map(int, input().split())\n    print(check_block_exists(N, W, X, Y, Q, T, A))"}, "kind": "candidate", "prev": "804642dd708395865e0f7bfc19e4d3385e462d9f2daf9b329ef3b17ae9ea5e19", "seq": 6}
