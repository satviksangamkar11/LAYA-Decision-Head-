{"data": {"id": "9343e05cb847633fb36fff213cd27dc81814f2138a7ea95b5371a6442c3d0354", "lineage": "9343e05cb847633fb36fff213cd27dc81814f2138a7ea95b5371a6442c3d0354", "origin": "sample:3", "parent": null, "source": "def main():\n    import sys\n    input = sys.stdin.read\n    data = list(map(int, input().split()))\n    N, W = data[0], data[1]\n    data = data[2:]\n    blocks = [(data[i], data[i + 1]) for i in range(0, len(data), 2)]\n    \n    Q = data[-1]\n    data = data[:-1]\n    queries = []\n    for i in range(Q):\n        queries.append((data[i * 2], data[i * 2 + 1]))\n    \n    result = []\n    for T, A in queries:\n        T += 0.5\n        if T >= 10**100:\n            result.append(\"Yes\")\n        else:\n            # Simulate the movement of blocks\n            for _ in range(T):\n                for block in blocks:\n                    x, y = block\n                    if y == 1 or any(blocks[j][1] == y - 1 for j in range(len(blocks))):\n                        continue\n                    blocks[j][1] -= 1\n                if any(block[1] == 0 for block in blocks):\n                    blocks = [block for block in blocks if block[1] != 0]\n            \n            result.append(\"Yes\" if A in blocks else \"No\")\n    \n    print(\"\\n\".join(result))\n\nif __name__ == \"__main__\":\n    main()"}, "kind": "candidate", "prev": "d4417e3fa6bf09027e6f269cfa1998914506ae9038cccb27966869a69b24b245", "seq": 16}
