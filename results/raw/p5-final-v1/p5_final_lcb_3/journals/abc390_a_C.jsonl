{"data": {"id": "0838d02882f4599593d53f39410f9f99e33ee77d8a712b1ef09138362458ce12", "lineage": "0838d02882f4599593d53f39410f9f99e33ee77d8a712b1ef09138362458ce12", "origin": "sample:4", "parent": null, "source": "def can_sort_by_one_swap(A):\n    n = len(A)\n    for i in range(n - 1):\n        if A[i] > A[i + 1]:\n            # Find the index of the next element that should be swapped with A[i]\n            j = i + 1\n            while j < n and A[j] <= A[i]:\n                j += 1\n            \n            # If no such element is found, return False\n            if j == n:\n                return False\n            \n            # Swap A[i] and A[j]\n            A[i], A[j] = A[j], A[i]\n            \n            # Check if the array is now sorted\n            if A == sorted(A):\n                return True\n    \n    return False\n\n# Read input\nA = list(map(int, input().split()))\n\n# Print output\nprint(\"Yes\" if can_sort_by_one_swap(A) else \"No\")"}, "kind": "candidate", "prev": "3e321bd8d471a8fcc1dbfff9b6df3acff1f1c323253578bf7b6a4ed8fd57a858", "seq": 28}
