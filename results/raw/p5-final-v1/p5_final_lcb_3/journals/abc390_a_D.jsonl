{"data": {"id": "261a8c2dbf5b3a05432c04003088f413737648aad3d0e5c676f6904f4a2fb583", "lineage": "261a8c2dbf5b3a05432c04003088f413737648aad3d0e5c676f6904f4a2fb583", "origin": "sample:1", "parent": null, "source": "def check_sortability(A):\n    # Check if the list is already sorted\n    if A == sorted(A):\n        return \"No\"\n    \n    # Find the first pair where the current element is greater than the next element\n    for i in range(len(A) - 1):\n        if A[i] > A[i + 1]:\n            # Check if swapping this pair would sort the list\n            if A[:i] + [A[i + 1], A[i]] + A[i + 2:] == sorted(A):\n                return \"Yes\"\n            else:\n                return \"No\"\n    \n    # If no such pair is found, the list cannot be sorted by one swap\n    return \"No\"\n\n# Read input\ninput_sequence = list(map(int, input().split()))\n\n# Check and print the result\nprint(check_sortability(input_sequence))"}, "kind": "candidate", "prev": "dc7b976482f418a37b7f987a59be0728fa4f9f3fb1bd6f99a47bfaa4379451c0", "seq": 6}
