{"data": {"id": "7a404a5cfd122fa43f9dbad79e4f116df1e7fbf4e8712cb38247111e61874469", "lineage": "7a404a5cfd122fa43f9dbad79e4f116df1e7fbf4e8712cb38247111e61874469", "origin": "sample:3", "parent": null, "source": "def check_sortable(A):\n    # Check if the list is already sorted\n    if A == sorted(A):\n        return \"Yes\"\n    \n    # Try to swap adjacent elements to see if sorting is possible\n    for i in range(len(A) - 1):\n        temp = A[i]\n        A[i] = A[i + 1]\n        A[i + 1] = temp\n        \n        # Check if the list is now sorted\n        if A == sorted(A):\n            return \"Yes\"\n        \n        # If no sorting is possible after swapping, restore the original element\n        A[i] = temp\n        A[i + 1] = temp\n    \n    # If no sorting is possible even after trying all swaps, return \"No\"\n    return \"No\"\n\n# Read input\nA = list(map(int, input().split()))\n\n# Print result\nprint(check_sortable(A))"}, "kind": "candidate", "prev": "29fb2d886b00b19ea53000caa363ca94128d30feee8c0ce5cb79147c8cdd2d76", "seq": 21}
