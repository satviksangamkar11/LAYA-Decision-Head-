{"data": {"id": "4e06be5ef8f919376f4d6122de2d9684a9cd08770539f0e4b7762be213caceec", "lineage": "4e06be5ef8f919376f4d6122de2d9684a9cd08770539f0e4b7762be213caceec", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport math\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        nums.sort()\n        mod = 10**9 + 7\n        \n        if k == len(nums):\n            return sum(nums)\n        \n        res = (nums[-1] * k) % mod + (nums[0] * (len(nums) - k)) % mod\n        return res % mod"}, "kind": "candidate", "prev": "a52842a2a65a8b21f6fb5716a43d1bcd73c186c9f5c003cc0a3b52ca0521604c", "seq": 18}
