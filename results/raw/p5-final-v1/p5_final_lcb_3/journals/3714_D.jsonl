{"data": {"id": "977636f34984fc7c0eaaeee1125c3f269a97c852d6f9b6ee749253ef13500913", "lineage": "4e06be5ef8f919376f4d6122de2d9684a9cd08770539f0e4b7762be213caceec", "origin": "repair:4e06be5ef8f919376f4d6122de2d9684a9cd08770539f0e4b7762be213caceec", "parent": "4e06be5ef8f919376f4d6122de2d9684a9cd08770539f0e4b7762be213caceec", "source": "from typing import *\nimport math\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        nums.sort()\n        mod = 10**9 + 7\n        \n        # Calculate the contribution of the minimum element\n        min_contribution = (nums[0] * k) % mod\n        \n        # Calculate the contribution of the maximum element\n        max_contribution = (nums[-1] * (len(nums) - k)) % mod\n        \n        # Sum up the contributions\n        result = (min_contribution + max_contribution) % mod\n        return result"}, "kind": "candidate", "prev": "e462ab4c2db0b523a69eaca1ca6bd4f961b8f326a26e2483b17402782b968fa1", "seq": 33}
