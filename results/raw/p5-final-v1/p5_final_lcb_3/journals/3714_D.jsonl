{"data": {"id": "c7540c0ba81e6a8207c67b3ea4179573c9d45b5f474097f9298dd0cd4f9358e6", "lineage": "c7540c0ba81e6a8207c67b3ea4179573c9d45b5f474097f9298dd0cd4f9358e6", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        # Sort the list in ascending order\n        nums.sort()\n        # Calculate the sum of the first k elements and the last k elements\n        ans = sum(nums[:k]) + sum(nums[-k:])\n        # Return the result modulo 10^9 + 7\n        return ans % (10**9 + 7)"}, "kind": "candidate", "prev": "0ce8027f1db3b43f71ec927e0f4508325b6d0df879b8707fc718f2722b58735b", "seq": 24}
