{"data": {"id": "c121b32dc745aaf268fca2785fb173530dd3f0f93106913d5d42565104600832", "lineage": "c121b32dc745aaf268fca2785fb173530dd3f0f93106913d5d42565104600832", "origin": "sample:2", "parent": null, "source": "from typing import *\nMOD = 10**9 + 7\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        if n == k:\n            return sum(nums) % MOD\n        \n        # Sort the numbers in ascending order\n        nums.sort()\n        \n        # Calculate the sum of the first k smallest elements\n        ans = sum(nums[:k]) % MOD\n        \n        # Calculate the sum of the last k largest elements\n        ans += sum(nums[n-k:]) % MOD\n        \n        return ans"}, "kind": "candidate", "prev": "60408285d404b8602b7ca271336f0ceffea4516da42aa4d20e43880972462076", "seq": 12}
