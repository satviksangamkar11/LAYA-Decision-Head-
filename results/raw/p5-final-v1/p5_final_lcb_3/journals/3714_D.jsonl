{"data": {"id": "29850bb805310dc6302dcba1bb18cda027d49f1101c587c1089524e59fc93139", "lineage": "b27c26b651520d2faa9ee1ac0c2e35cf293d6f5dcc9a3871466bdb1bd7131473", "origin": "repair:b27c26b651520d2faa9ee1ac0c2e35cf293d6f5dcc9a3871466bdb1bd7131473", "parent": "b27c26b651520d2faa9ee1ac0c2e35cf293d6f5dcc9a3871466bdb1bd7131473", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minMaxSums(self, nums: List[int], k: int) -> int:\n        n = len(nums)\n        if k == n:\n            return sum(nums) % (10**9+7)\n        \n        # Sort the numbers in ascending order\n        nums.sort()\n        \n        # Calculate the sum of the first k elements\n        s1 = sum(nums[:k])\n        \n        # Calculate the sum of the last k elements\n        s2 = sum(nums[-k:])\n        \n        # Calculate the sum of the middle elements\n        if k < n - k:\n            mid_sum = sum(nums[k:-k])\n        else:\n            mid_sum = sum(nums[k:]) + sum(nums[:k-n+k])\n        \n        # Return the sum modulo 10^9 + 7\n        return (s1 + s2 + mid_sum) % (10**9+7)"}, "kind": "candidate", "prev": "4507e3d171f8ab093c2b16ec081c2b61a48cb28575dbb3e01114e94ca1618324", "seq": 44}
