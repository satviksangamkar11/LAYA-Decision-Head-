{"data": {"id": "e1c284d8ef3b3d432d23ba7c423d7a72dda9caf35a969f99bbe483acdfcd8ae3", "lineage": "18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "origin": "repair:18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "parent": "18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "source": "from typing import *\n\nclass Solution:\n    def minCosts(self, cost: List[int]) -> List[int]:\n        # Initialize the dp array with the same length as the input array\n        dp = [0] * len(cost)\n        \n        # Base cases\n        if len(cost) > 1:\n            dp[-1] = cost[-1]\n            dp[-2] = cost[-2] + dp[-1]\n        else:\n            return cost\n        \n        # Fill the dp array from the second last position to the first position\n        for i in range(len(cost)-3, -1, -1):\n            dp[i] = min(dp[i+1] + cost[i], dp[i+2] + cost[i])\n        \n        # Return the first element of the dp array\n        return dp[0]"}, "kind": "candidate", "prev": "fa956e4b216da0c6d5116eb387162fbf6bee9856c8f0d10d9b2f918b66386d2a", "seq": 29}
