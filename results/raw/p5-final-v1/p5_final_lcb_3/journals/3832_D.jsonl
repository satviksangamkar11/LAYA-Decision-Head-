{"data": {"id": "18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "lineage": "18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "origin": "sample:3", "parent": null, "source": "from typing import *\nclass Solution:\n    def minCosts(self, cost: List[int]) -> List[int]:\n        dp = [0] * len(cost)\n        if len(cost) > 1:\n            dp[-1] = cost[-1]\n            dp[-2] = cost[-2] + dp[-1]\n        else:\n            return cost\n        \n        for i in range(len(cost)-3, -1, -1):\n            dp[i] = cost[i] + min(dp[i+2], dp[i+1])\n            \n        return dp"}, "kind": "candidate", "prev": "a91de0d476e3d208b2fd153b1385531b11c237d1009dc1965174b59e501266b0", "seq": 16}
