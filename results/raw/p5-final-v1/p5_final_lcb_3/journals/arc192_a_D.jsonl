{"data": {"id": "6eb053942d8a58694039878dbd0d219676511df6f56a83f6aa20c15326694b8b", "lineage": "6eb053942d8a58694039878dbd0d219676511df6f56a83f6aa20c15326694b8b", "origin": "sample:3", "parent": null, "source": "def check_good_string(N, A):\n    # Check if all elements in A are 1\n    if all(a == 1 for a in A):\n        return \"Yes\"\n    \n    # Check if the sequence A can be transformed into a good string\n    for i in range(1, N):\n        if A[i] == 0 and A[i-1] == 1 and A[i+1] == 1:\n            return \"Yes\"\n    \n    return \"No\"\n\n# Read input\nN = int(input())\nA = list(map(int, input().split()))\n\n# Check and print the result\nprint(check_good_string(N, A))"}, "kind": "candidate", "prev": "79ad4d65e31943d151cc190863ecf1564b3d4cb3751f8190a1c184aab7cf7dcc", "seq": 20}
