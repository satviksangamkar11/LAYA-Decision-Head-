{"data": {"id": "e76baf94b64aaa1f4bb65678243802bcc061ad56fe7aea21528ce760d887352b", "lineage": "e76baf94b64aaa1f4bb65678243802bcc061ad56fe7aea21528ce760d887352b", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minCosts(self, cost: List[int]) -> List[int]:\n        if not cost:\n            return []\n        \n        # Initialize the result list with the last element's cost\n        res = [cost[-1]]\n        \n        # Iterate backwards through the cost list starting from the second-to-last element\n        for i in range(len(cost) - 2, -1, -1):\n            # Calculate the cost to swap with the next person or free\n            swap_cost = cost[i] + min(res[-1], res[-2])\n            \n            # Append the minimum cost to the result list\n            res.append(swap_cost)\n        \n        # Reverse the result list to get the correct order\n        res.reverse()\n        \n        return res"}, "kind": "candidate", "prev": "274d2286ad6495104c1b89c4ed946a0a23424396b02a1009b40a69b86c35f683", "seq": 6}
