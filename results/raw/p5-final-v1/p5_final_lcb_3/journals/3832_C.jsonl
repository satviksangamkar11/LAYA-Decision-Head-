{"data": {"id": "18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "lineage": "18721645125829c38785c6d07f1057dcb74102c98ad4fd15191ec51afb1d9565", "origin": "sample:3", "parent": null, "source": "from typing import *\nclass Solution:\n    def minCosts(self, cost: List[int]) -> List[int]:\n        dp = [0] * len(cost)\n        if len(cost) > 1:\n            dp[-1] = cost[-1]\n            dp[-2] = cost[-2] + dp[-1]\n        else:\n            return cost\n        \n        for i in range(len(cost)-3, -1, -1):\n            dp[i] = cost[i] + min(dp[i+2], dp[i+1])\n            \n        return dp"}, "kind": "candidate", "prev": "e62c51f1fbe4b244f9835c9b6be1a888b3c1bdb565343136f250e4acf3059f43", "seq": 16}
