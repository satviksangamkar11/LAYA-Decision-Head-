{"data": {"id": "3370d84bd0c12660a8bf3a1d3f4e3981c5a4803dc4057c0966d6642f299fbdde", "lineage": "3370d84bd0c12660a8bf3a1d3f4e3981c5a4803dc4057c0966d6642f299fbdde", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minCosts(self, cost: List[int]) -> List[int]:\n        # Initialize the result list with the last element's cost\n        res = [cost[-1]]\n        \n        # Iterate through the cost array starting from the second-to-last element\n        for i in range(len(cost)-2, -1, -1):\n            # Calculate the minimum cost by either swapping with the next person or keeping the current person's cost\n            res.append(min(cost[i+1], cost[i+2]) + res[-1])\n        \n        return res[::-1]"}, "kind": "candidate", "prev": "a36d17ea4290a52cc522533a41ab31141d9d439cfc23539ca01e548e81144487", "seq": 11}
