{"data": {"id": "00717fd11e68f9b9661d4eeb8fe7b58300378cc41075f73cc433ed57b17d2931", "lineage": "00717fd11e68f9b9661d4eeb8fe7b58300378cc41075f73cc433ed57b17d2931", "origin": "sample:2", "parent": null, "source": "import math\n\ndef find_factorial_root(x):\n    # Start with an initial guess for N\n    n = int(math.sqrt(x))\n    \n    # Use binary search to find the exact value of N\n    while True:\n        product = math.factorial(n)\n        if product == x:\n            return n\n        elif product < x:\n            n += 1\n        else:\n            n -= 1\n\n# Read input\nx = int(input())\n\n# Find the factorial root\nresult = find_factorial_root(x)\n\n# Print the result\nprint(result)"}, "kind": "candidate", "prev": "49f04cd539413df0635e23dffc0ab3a7c56bab28fea3be2e35bcbe093916780c", "seq": 12}
