{"data": {"id": "3be37bed5641fe06e927260b42fd5d04e207618d72ab90380be769e2e3c27edc", "lineage": "3be37bed5641fe06e927260b42fd5d04e207618d72ab90380be769e2e3c27edc", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\n        ans = []\n        m, n = len(grid), len(grid[0])\n        i, j = 0, 0\n        \n        while i < m and j < n:\n            ans.append(grid[i][j])\n            \n            # Move right if possible\n            if j + 1 < n and not (i % 2 == 0 and j + 1 == n):\n                j += 1\n            else:\n                # If cannot move right, move down\n                i += 1\n            \n            # Move left if possible\n            if j - 1 >= 0 and not (i % 2 == 0 and j - 1 == 0):\n                j -= 1\n            else:\n                # If cannot move left, move down\n                i += 1\n        \n        return ans"}, "kind": "candidate", "prev": "d57cba373875a68635dbf058943dcdb317e1d520b67c8457b57a6fe99b4b258b", "seq": 6}
