{"data": {"id": "e349686637f8e7df3cc3726a1db7fd633be67ad84ad38ef0329a2a0ff53e177c", "lineage": "3be37bed5641fe06e927260b42fd5d04e207618d72ab90380be769e2e3c27edc", "origin": "repair:3be37bed5641fe06e927260b42fd5d04e207618d72ab90380be769e2e3c27edc", "parent": "3be37bed5641fe06e927260b42fd5d04e207618d72ab90380be769e2e3c27edc", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\n        ans = []\n        m, n = len(grid), len(grid[0])\n        i, j = 0, 0\n        \n        while i < m and j < n:\n            ans.append(grid[i][j])\n            \n            # Move right if possible\n            if j + 1 < n and (i % 2 == 0 or j + 1 != n):\n                j += 1\n            else:\n                # If cannot move right, move down\n                i += 1\n            \n            # Move left if possible\n            if j - 1 >= 0 and (i % 2 == 1 or j - 1 != 0):\n                j -= 1\n            else:\n                # If cannot move left, move down\n                i += 1\n        \n        return ans"}, "kind": "candidate", "prev": "752a508762b09bd356115c3f73400b411465c16e4e47a025a7cae0aee3055943", "seq": 33}
