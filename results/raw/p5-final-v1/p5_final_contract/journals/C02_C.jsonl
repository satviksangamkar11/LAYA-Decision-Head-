{"data": {"id": "6c06469f9f36125ff3574cc5190cc26a062d170aa976408e4bb46d4e196b18f0", "lineage": "6c06469f9f36125ff3574cc5190cc26a062d170aa976408e4bb46d4e196b18f0", "origin": "sample:4", "parent": null, "source": "from typing import *\nimport collections\n\nclass Solution:\n    def solve(self, data: Dict[str, str]) -> Union[int, str]:\n        # Edge cases\n        if not data['s']:\n            return 0\n        \n        # Brute-force approach\n        max_depth = 0\n        current_depth = 0\n        for char in data['s']:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        if current_depth != 0:\n            return -1\n        \n        # Efficient solution\n        stack = []\n        max_depth = 0\n        for char in data['s']:\n            if char == '(':\n                stack.append(char)\n                max_depth = max(max_depth, len(stack))\n            elif char == ')':\n                stack.pop()\n        \n        if len(stack) > 0:\n            return -1\n        \n        return max_depth"}, "kind": "candidate", "prev": "c620a3f0bf5fcd2946959c6c8a6f3848b08635d5f32eefc708f7ac651b430470", "seq": 30}
