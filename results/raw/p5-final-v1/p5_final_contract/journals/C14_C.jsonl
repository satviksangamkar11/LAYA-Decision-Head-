{"data": {"id": "1d525a164e8625bd0251abed4feed428c12a4e843be4e736117a7d9780103639", "lineage": "1d525a164e8625bd0251abed4feed428c12a4e843be4e736117a7d9780103639", "origin": "sample:3", "parent": null, "source": "def solve(data):\n    nums = data[\"nums\"]\n    target = data[\"target\"]\n\n    # Edge cases: empty array or single element array with target smaller than or equal to the element\n    if not nums or target <= nums[0]:\n        return 0\n    \n    # Edge case: single element array with target larger than the element\n    elif target > nums[-1]:\n        return len(nums)\n    \n    # Binary search to find the insertion point\n    left, right = 0, len(nums) - 1\n    while left < right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        elif nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n    \n    # If loop exits without finding target, left will be at the correct position for insertion\n    return left"}, "kind": "candidate", "prev": "cc74b1544fabfdd5eec969c65f93350e5a0b7860de4baaac71b4d5a0a1d4b3ef", "seq": 22}
