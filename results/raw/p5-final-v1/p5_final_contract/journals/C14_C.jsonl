{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 274, "char_start": 0, "quote": "Input {\"nums\": strictly increasing integer list, \"target\": integer}. Return the index of target if present, otherwise the index where it would be inserted to keep the order. The result i satisfies 0<=i<=len(nums), nums[i-1]<target if i>0, and target<=nums[i] if i<len(nums).", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 328, "char_start": 286, "quote": "Input:\n{\"nums\": [], \"target\": 5}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 392, "char_start": 340, "quote": "Input:\n{\"nums\": [1, 3, 5, 6], \"target\": 5}\nOutput:\n2", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 456, "char_start": 404, "quote": "Input:\n{\"nums\": [1, 3, 5, 6], \"target\": 2}\nOutput:\n1", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 520, "char_start": 468, "quote": "Input:\n{\"nums\": [1, 3, 5, 6], \"target\": 7}\nOutput:\n4", "type": "request_span"}, "status": "act