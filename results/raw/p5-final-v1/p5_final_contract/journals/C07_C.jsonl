{"data": {"id": "f89a46551447ea36df41969e495504b4c4310edbd32a30e26597624010cb9793", "lineage": "f89a46551447ea36df41969e495504b4c4310edbd32a30e26597624010cb9793", "origin": "sample:3", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> str:\n    if not data['words']:\n        return \"\"\n    \n    # Find the shortest word to determine the possible length of the prefix\n    min_word = min(data['words'], key=len)\n    \n    for i in range(len(min_word)):\n        # Check if all words have the same character at this position\n        if not all(word[i] == min_word[i] for word in data['words']):\n            return min_word[:i]\n    \n    return min_word"}, "kind": "candidate", "prev": "86bd7ace41204a69efb9c61c59874791b57a5550f7c5e3f86fb7a1785608e6e3", "seq": 22}
