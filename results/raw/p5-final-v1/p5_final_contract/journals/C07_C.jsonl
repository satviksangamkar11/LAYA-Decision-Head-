{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 157, "char_start": 0, "quote": "Input {\"words\": nonempty list of lowercase words (a word may be empty)}. Return the longest common prefix of all words. The result is a prefix of every word.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 226, "char_start": 169, "quote": "Input:\n{\"words\": [\"flower\", \"flow\", \"flight\"]}\nOutput:\nfl", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 283, "char_start": 238, "quote": "Input:\n{\"words\": [\"dog\", \"racecar\"]}\nOutput:\n", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 328, "char_start": 295, "quote": "Input:\n{\"words\": [\"a\"]}\nOutput:\na", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 378, "char_start": 340, "quote": "Input:\n{\"words\": [\"\", \"abc\"]}\nOutput:\n", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "03998b541cc3b5