{"data": {"id": "9c1a3e9c8b226450b4563842df5b827ce7ffa8d6f9a22cf5f38b3c54fe640029", "lineage": "9c1a3e9c8b226450b4563842df5b827ce7ffa8d6f9a22cf5f38b3c54fe640029", "origin": "sample:4", "parent": null, "source": "from typing import *\nimport collections\n\nclass Solution:\n    def solve(self, data):\n        nums = data['nums']\n        \n        # Edge case: empty list\n        if not nums:\n            return []\n        \n        # Find the first element from the end that is smaller than its successor\n        i = len(nums) - 2\n        while i >= 0 and nums[i] >= nums[i + 1]:\n            i -= 1\n        \n        # If no such element exists, the list is sorted in descending order, so we reverse it\n        if i == -1:\n            return sorted(nums)\n        \n        # Find the smallest element from the end that is larger than nums[i]\n        j = len(nums) - 1\n        while nums[j] <= nums[i]:\n            j -= 1\n        \n        # Swap nums[i] and nums[j]\n        nums[i], nums[j] = nums[j], nums[i]\n        \n        # Reverse the elements from nums[i+1] to the end\n        nums[i+1:] = reversed(nums[i+1:])\n        \n        return nums"}, "kind": "candidate", "prev": "d1474ca6ea9be901482563aca169fcc1f5b6a08ddc9c2651e6913984cf4d6974", "seq": 30}
