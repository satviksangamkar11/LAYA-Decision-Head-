{"data": {"id": "6ce0742b2e56ae333963f2decbce7d37a5d851ddbfe67dfda988b47977443907", "lineage": "6ce0742b2e56ae333963f2decbce7d37a5d851ddbfe67dfda988b47977443907", "origin": "sample:2", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> List[int]:\n    nums = data['nums']\n    \n    # Find the first element from the right that is smaller than the element immediately before it\n    i = len(nums) - 2\n    while i >= 0 and nums[i] >= nums[i + 1]:\n        i -= 1\n    \n    if i == -1:\n        # If no such element exists, reverse the entire array to get the smallest permutation\n        nums.reverse()\n        return nums\n    \n    # Find the smallest element from the right that is larger than nums[i]\n    j = len(nums) - 1\n    while nums[j] <= nums[i]:\n        j -= 1\n    \n    # Swap nums[i] with nums[j]\n    nums[i], nums[j] = nums[j], nums[i]\n    \n    # Reverse the subarray from index i+1 to the end\n    nums[i + 1:] = reversed(nums[i + 1:])\n    \n    return nums"}, "kind": "candidate", "prev": "36b8693a6d70bbc7790cac00205e33f9f33d29dfe31e1d492f97d45940693c7b", "seq": 14}
