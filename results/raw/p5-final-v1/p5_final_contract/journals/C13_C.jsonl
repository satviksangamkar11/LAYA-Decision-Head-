{"data": {"id": "b239133155ef4511b8d83e344e09513ef2744a0a7f15b0dce0c656d9110d0857", "lineage": "b239133155ef4511b8d83e344e09513ef2744a0a7f15b0dce0c656d9110d0857", "origin": "sample:1", "parent": null, "source": "def solve(data):\n    nums = data['nums']\n    n = len(nums)\n    \n    # Find the first element from right to left that is smaller than its successor\n    i = n - 2\n    while i >= 0 and nums[i] >= nums[i + 1]:\n        i -= 1\n    \n    if i == -1:\n        # If no such element exists, reverse the entire array\n        return sorted(nums)\n    \n    # Find the smallest element from right to left that is greater than nums[i]\n    j = n - 1\n    while nums[j] <= nums[i]:\n        j -= 1\n    \n    # Swap nums[i] and nums[j]\n    nums[i], nums[j] = nums[j], nums[i]\n    \n    # Reverse the elements from i+1 to n-1\n    nums[i + 1:] = reversed(nums[i + 1:])\n    \n    return nums"}, "kind": "candidate", "prev": "15050e58dc8c1e81bb8bee2347953ed22cd191b3e42ea542b65c3d78b13e4814", "seq": 6}
