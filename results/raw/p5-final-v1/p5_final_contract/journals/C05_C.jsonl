{"data": {"id": "3792922cb513847893e92a13c1a8106291d168515e047475cf516f42e346bb7e", "lineage": "3792922cb513847893e92a13c1a8106291d168515e047475cf516f42e346bb7e", "origin": "sample:1", "parent": null, "source": "def solve(data):\n    nums = data['nums']\n    target = data['target']\n\n    # Create a dictionary to store the difference between each number and the target\n    diff_dict = {}\n\n    for i, num in enumerate(nums):\n        diff = target - num\n        if diff in diff_dict:\n            return [diff_dict[diff], i]\n        else:\n            diff_dict[num] = i\n\n    return []"}, "kind": "candidate", "prev": "f17f9d66446da8c8a329cabea3f37503b07be53e9e656297165405a7dc97d0e4", "seq": 6}
