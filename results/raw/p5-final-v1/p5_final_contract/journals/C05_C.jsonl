{"data": {"id": "3a90ae14a946981d33b5b4a1f39743706cd7b248a40071a1f86d667cd922d6f9", "lineage": "3a90ae14a946981d33b5b4a1f39743706cd7b248a40071a1f86d667cd922d6f9", "origin": "sample:2", "parent": null, "source": "from typing import List\n\ndef solve(data: dict) -> List[int]:\n    nums = data['nums']\n    target = data['target']\n\n    # Sort the array to make it easier to find pairs\n    nums.sort()\n\n    left, right = 0, len(nums) - 1\n\n    while left < right:\n        current_sum = nums[left] + nums[right]\n\n        if current_sum == target:\n            return [left, right]\n        elif current_sum < target:\n            left += 1\n        else:\n            right -= 1\n\n    return []"}, "kind": "candidate", "prev": "1a546889e1de869bfeb09fb16fc2c48d21a50856789a8e81e95dc9aa5c35ac40", "seq": 14}
