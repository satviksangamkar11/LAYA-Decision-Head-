{"data": {"id": "dae2014506d1f84d4310bf57d6e2469b106f7b736fd3b5b2613ebc8639431bfb", "lineage": "dae2014506d1f84d4310bf57d6e2469b106f7b736fd3b5b2613ebc8639431bfb", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countPartitions(self, nums: List[int]) -> int:\n        total_sum = sum(nums)\n        if total_sum % 2 != 0:\n            return 0\n        \n        odd_count = sum(1 for num in nums if num % 2 != 0)\n        even_count = len(nums) - odd_count\n        \n        # If there's more than one odd number, we can always form pairs of odd numbers to get an even difference\n        if odd_count > 1:\n            return (even_count * (even_count - 1)) // 2\n        \n        # If there's only one odd number, it must pair with another odd number to get an even difference\n        return even_count"}, "kind": "candidate", "prev": "a653ac0798228bc240902aef841382e01f314c23c7f6f1ba29b548122958cb7c", "seq": 24}
