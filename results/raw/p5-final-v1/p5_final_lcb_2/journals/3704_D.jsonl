{"data": {"answer_label": "BLOCKED", "candidate_id": "20f86f28e3946a612a1a6130414d4594c121df1b4b7072bab43303467cd3d180", "fails": 2, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "VERIFIED", "R5": "FAILED"}, "trusted_passes": 1, "validated_passes": 0}, "kind": "label", "prev": "eab7f258f89b6720eff67664913b7a77d3da80b6399c1f2ad17add1e136e82c5", "seq": 11}
{"data": {"id": "8217ffe84d8c29d0ced88edf9e50bef38fc533a30a1dfc3c283b2dd8a58e09a0", "lineage": "8217ffe84d8c29d0ced88edf9e50bef38fc533a30a1dfc3c283b2dd8a58e09a0", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countPartitions(self, nums: List[int]) -> int:\n        n = len(nums)\n        prefix_sum = [0] * (n + 1)\n        for i in range(1, n + 1):\n            prefix_sum[i] = prefix_sum[i-1] + nums[i-1]\n\n        even_count = 0\n        odd_count = 0\n\n        # Iterate through each possible partition point\n        for i in range(n):\n            left_sum = prefix_sum[i]\n            right_sum = prefix_sum[n] - left_sum\n\n            # Check if the difference between left and right sums is even\n            if (left_sum % 2 == 0) != (right_sum % 2 == 0):\n                even_count += 1\n\n        return even_count"}, "kind": "candidate", "prev": "f4688c947881cb55c64dcccf42ea7bc1b6568d5029fdbbb6ddaf3b91427b0bca", "seq": 12}
