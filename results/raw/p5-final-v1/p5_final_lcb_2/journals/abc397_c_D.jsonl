{"data": {"id": "befecbdfe3a55659fd6795c0f0a6deb2bda4ebcacaf3dffb49753ef6844171ce", "lineage": "2b5eaa443cbe359b200bf7e29be7974573f8b42d3fa07416198ffdf9aa5cf21a", "origin": "repair:2b5eaa443cbe359b200bf7e29be7974573f8b42d3fa07416198ffdf9aa5cf21a", "parent": "2b5eaa443cbe359b200bf7e29be7974573f8b42d3fa07416198ffdf9aa5cf21a", "source": "def max_distinct_sum(N, A):\n    distinct_counts = [set() for _ in range(N)]\n    distinct_counts[0].add(A[0])\n    \n    max_sum = 0\n    \n    for i in range(1, N):\n        distinct_counts[i] = distinct_counts[i-1]\n        if A[i] not in distinct_counts[i]:\n            distinct_counts[i].add(A[i])\n        \n        # Calculate the sum of distinct elements in each subarray\n        left_count = len(distinct_counts[i-1])\n        right_count = len(distinct_counts[N-i])\n        current_sum = left_count + right_count\n        \n        # Update the maximum sum\n        max_sum = max(max_sum, current_sum)\n    \n    return max_sum\n\n# Read input\nN = int(input())\nA = list(map(int, input().split()))\n\n# Print output\nprint(max_distinct_sum(N, A))"}, "kind": "candidate", "prev": "bb1c2344ffc0131f4a674d58ce625d039d6dbf28da6879e66eebf955baf4a676", "seq": 29}
