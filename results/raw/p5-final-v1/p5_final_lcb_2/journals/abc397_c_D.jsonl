{"data": {"id": "78988c7217c0752cd9aeb0610950296a419e9bbdd5eeeee0bf6618725c680c7b", "lineage": "78988c7217c0752cd9aeb0610950296a419e9bbdd5eeeee0bf6618725c680c7b", "origin": "sample:2", "parent": null, "source": "import sys\nfrom collections import Counter\n\ndef max_distinct_count(N, A):\n    # Initialize variables\n    max_sum = 0\n    current_sum = 0\n    current_count = Counter()\n    \n    # Iterate through the array\n    for i in range(1, N):\n        # Add the current element to the current count\n        current_count[A[i]] += 1\n        \n        # Update the current sum\n        current_sum += len(current_count)\n        \n        # Update the maximum sum if necessary\n        max_sum = max(max_sum, current_sum)\n    \n    return max_sum\n\n# Read input\nN = int(sys.stdin.readline())\nA = list(map(int, sys.stdin.readline().split()))\n\n# Print the result\nprint(max_distinct_count(N, A))"}, "kind": "candidate", "prev": "1fa0f3ec0199d27156357fb0917fa8f6a3c7568892218a136615507583e43d30", "seq": 11}
