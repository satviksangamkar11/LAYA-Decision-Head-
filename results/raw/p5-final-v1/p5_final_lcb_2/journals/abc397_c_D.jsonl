{"data": {"id": "2b5eaa443cbe359b200bf7e29be7974573f8b42d3fa07416198ffdf9aa5cf21a", "lineage": "2b5eaa443cbe359b200bf7e29be7974573f8b42d3fa07416198ffdf9aa5cf21a", "origin": "sample:3", "parent": null, "source": "def max_distinct_sum(N, A):\n    distinct_counts = [set() for _ in range(N)]\n    distinct_counts[0].add(A[0])\n    \n    for i in range(1, N):\n        distinct_counts[i] = distinct_counts[i-1]\n        if A[i] not in distinct_counts[i]:\n            distinct_counts[i].add(A[i])\n    \n    return max(len(distinct_counts[i]) + len(distinct_counts[j]) for i in range(N-1) for j in range(i+1))\n\n# Read input\nN = int(input())\nA = list(map(int, input().split()))\n\n# Print output\nprint(max_distinct_sum(N, A))"}, "kind": "candidate", "prev": "854c64957845bf5e36c7003c646d05b12d3e3c958d0710950791d9fb28f005f2", "seq": 16}
