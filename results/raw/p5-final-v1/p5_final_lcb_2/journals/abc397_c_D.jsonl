{"data": {"id": "fe58d7f8a932d5a04c56650ce4da02a0c7e6776dea74e08fc117a3cab27c0294", "lineage": "fe58d7f8a932d5a04c56650ce4da02a0c7e6776dea74e08fc117a3cab27c0294", "origin": "sample:4", "parent": null, "source": "def max_distinct_sum(N, A):\n    distinct_counts = [set() for _ in range(N)]\n    \n    # Count distinct elements in each prefix\n    for i in range(1, N):\n        distinct_counts[i] = distinct_counts[i-1].union({A[i]})\n    \n    # Calculate the sum of distinct counts for each suffix\n    suffix_counts = [0] * N\n    for i in range(N-2, -1, -1):\n        suffix_counts[i] = suffix_counts[i+1] + len(distinct_counts[i])\n    \n    # Find the maximum sum of distinct counts for each i\n    max_sum = 0\n    for i in range(1, N-1):\n        max_sum = max(max_sum, suffix_counts[i-1] + len(distinct_counts[i]))\n    \n    return max_sum\n\n# Example usage\nN = int(input())\nA = list(map(int, input().split()))\nprint(max_distinct_sum(N, A))"}, "kind": "candidate", "prev": "7e2ca908db54baa0c60dcfb2d717b09197d360d79050327828cc823db5e99bcd", "seq": 21}
