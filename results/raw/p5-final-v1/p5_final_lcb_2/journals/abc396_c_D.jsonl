{"data": {"id": "12528b6a278d5dea6dff22aea8dab657d53785d546062fd23f78278b504b0091", "lineage": "12528b6a278d5dea6dff22aea8dab657d53785d546062fd23f78278b504b0091", "origin": "sample:2", "parent": null, "source": "import sys\n\ndef max_black_white_sum(N, M, B, W):\n    # Sort the lists of black and white balls in descending order of value\n    B.sort(reverse=True)\n    W.sort(reverse=True)\n    \n    # Initialize variables to keep track of the sum of black and white balls\n    black_sum = 0\n    white_sum = 0\n    \n    # Iterate through the sorted lists of black and white balls\n    for i in range(min(N, M)):\n        # Add the value of the current black and white balls to their respective sums\n        black_sum += B[i]\n        white_sum += W[i]\n    \n    # Return the maximum sum of the chosen balls\n    return max(black_sum, white_sum)\n\nif __name__ == \"__main__\":\n    # Read the input from stdin\n    N, M = map(int, sys.stdin.readline().split())\n    B = list(map(int, sys.stdin.readline().split()))\n    W = list(map(int, sys.stdin.readline().split()))\n    \n    # Call the function to find the maximum sum of the chosen balls\n    result = max_black_white_sum(N, M, B, W)\n    \n    # Write the answer to stdout\n    print(result)"}, "kind": "candidate", "prev": "ca3969d498b27fc9c03e39c5deb95ec152a804005da3435193ca284db181f0ea", "seq": 12}
