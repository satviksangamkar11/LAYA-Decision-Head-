{"data": {"id": "a1269c88ca7da5aa61ad7ea58d01ab7f3d5494aca9939713250806e15aa119c2", "lineage": "a1269c88ca7da5aa61ad7ea58d01ab7f3d5494aca9939713250806e15aa119c2", "origin": "sample:3", "parent": null, "source": "def max_value_sum(N, M, B, W):\n    # Sort both lists of balls in ascending order\n    B.sort()\n    W.sort()\n\n    # Initialize variables\n    total_sum = 0\n    black_count = 0\n    white_count = 0\n\n    # Iterate through the sorted lists\n    while black_count < N and white_count < M:\n        # If there are more black balls than white balls, choose one white ball\n        if black_count > white_count:\n            total_sum += W[white_count]\n            white_count += 1\n        # Otherwise, choose one black ball\n        else:\n            total_sum += B[black_count]\n            black_count += 1\n\n    # Return the total sum of the chosen balls\n    return total_sum\n\n# Read input\nN, M = map(int, input().split())\nB = list(map(int, input().split()))\nW = list(map(int, input().split()))\n\n# Print the result\nprint(max_value_sum(N, M, B, W))"}, "kind": "candidate", "prev": "7bb4c27fdd7f4b11680320256d223f72d4642c5f0bff76d562e9913d21d86a95", "seq": 18}
