{"data": {"id": "d0d77c4a5719b0830b55c0b7e18594fc0ba587a5d45d0b611313489a4930d392", "lineage": "d0d77c4a5719b0830b55c0b7e18594fc0ba587a5d45d0b611313489a4930d392", "origin": "sample:4", "parent": null, "source": "def max_black_white_sum(N, M, B, W):\n    # Sort both lists in ascending order\n    B.sort()\n    W.sort()\n\n    # Initialize variables to keep track of the maximum sum and the current sum\n    max_sum = 0\n    current_sum = 0\n\n    # Iterate through the sorted lists\n    for b, w in zip(B, W):\n        # Add the smaller value to the current sum\n        current_sum += min(b, w)\n        # Update the maximum sum if the current sum is greater\n        max_sum = max(max_sum, current_sum)\n\n    return max_sum\n\n# Read input from stdin\nN, M = map(int, input().split())\nB = list(map(int, input().split()))\nW = list(map(int, input().split()))\n\n# Print the result to stdout\nprint(max_black_white_sum(N, M, B, W))"}, "kind": "candidate", "prev": "679c42acd5b00328525e2663f1254cd9c9ac64cb0e876d40491b3b2de645a023", "seq": 24}
