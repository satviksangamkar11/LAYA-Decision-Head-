{"data": {"id": "236b60b5e6294e5a79a124919432582ca2e9031b1794782522ea87d32c9f3f07", "lineage": "20f86f28e3946a612a1a6130414d4594c121df1b4b7072bab43303467cd3d180", "origin": "repair:20f86f28e3946a612a1a6130414d4594c121df1b4b7072bab43303467cd3d180", "parent": "20f86f28e3946a612a1a6130414d4594c121df1b4b7072bab43303467cd3d180", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countPartitions(self, nums: List[int]) -> int:\n        total_sum = sum(nums)\n        if total_sum % 2 != 0:\n            return 0\n        \n        # Count the frequency of sums modulo 2 for the prefix sums\n        mod_counts = Counter()\n        current_sum = 0\n        result = 0\n        \n        for num in nums:\n            current_sum += num\n            # Calculate the required sum to balance the current sum\n            required_sum = (total_sum - current_sum) // 2\n            # Check if the required sum has been seen before\n            if required_sum in mod_counts:\n                result += mod_counts[required_sum]\n            # Update the count of the current sum modulo 2\n            mod_counts[current_sum % 2] += 1\n        \n        return result"}, "kind": "candidate", "prev": "81fb8fafbbc2e814ca51f3fc437762ce381ecd50f9e115cfc2bf0aab3e333eea", "seq": 33}
