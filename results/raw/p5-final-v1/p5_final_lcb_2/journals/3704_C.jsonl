{"data": {"id": "ec0d1179402de988b9bdd648fe4e37d3d8910ae5d95964dc7106c4b25442f6d7", "lineage": "ec0d1179402de988b9bdd648fe4e37d3d8910ae5d95964dc7106c4b25442f6d7", "origin": "sample:3", "parent": null, "source": "from typing import *\nclass Solution:\n    def countPartitions(self, nums: List[int]) -> int:\n        # Initialize variables to keep track of even and odd sums\n        even_sum = 0\n        odd_sum = 0\n        \n        # Iterate through the array to calculate the total sum and odd/even sums\n        for num in nums:\n            if num % 2 == 0:\n                even_sum += num\n            else:\n                odd_sum += num\n        \n        # The number of valid partitions is half the number of pairs of numbers with different parity\n        return len(nums) // 2 * min(even_sum, odd_sum)"}, "kind": "candidate", "prev": "0584cc9f7df9e0c321f0e1e719eb50d6cbc714becc6408349b7bd214e7d1f17d", "seq": 18}
