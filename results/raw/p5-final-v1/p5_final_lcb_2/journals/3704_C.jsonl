{"data": {"n": 4, "prompt_sha": ["cb23c516e0193b8d801f6c4ad14cbec0500c1369ed9def5174237432f4566811"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "4d3a431b5dd99666bef7d3945c9e9b18986b178b303597a1a748200c2af92653", "seq": 5}
{"data": {"id": "20f86f28e3946a612a1a6130414d4594c121df1b4b7072bab43303467cd3d180", "lineage": "20f86f28e3946a612a1a6130414d4594c121df1b4b7072bab43303467cd3d180", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def countPartitions(self, nums: List[int]) -> int:\n        total_sum = sum(nums)\n        if total_sum % 2 != 0:\n            return 0\n        \n        # Count the frequency of sums modulo 2 for the prefix sums\n        mod_counts = Counter()\n        current_sum = 0\n        result = 0\n        \n        for num in nums:\n            current_sum += num\n            # If the current sum modulo 2 is 0, we need to find a previous sum that also has a sum modulo 2 of 0\n            if current_sum % 2 == 0:\n                result += mod_counts[current_sum // 2]\n            # Update the count of the current sum modulo 2\n            mod_counts[current_sum % 2] += 1\n        \n        return result"}, "kind": "candidate", "prev": "a91b590c79cf051c14d745d5f63b1d8aaafb93be03817d8a738712a2f0736c3f", "seq": 6}
