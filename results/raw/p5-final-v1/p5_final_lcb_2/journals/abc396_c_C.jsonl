{"data": {"id": "cf511c0e54193ac6c1ddbd9bb130e3c8921d47c437b4aea79d74b1e5c4afdd95", "lineage": "cf511c0e54193ac6c1ddbd9bb130e3c8921d47c437b4aea79d74b1e5c4afdd95", "origin": "sample:1", "parent": null, "source": "def max_value_sum(N, M, B, W):\n    # Sort both lists in descending order\n    B.sort(reverse=True)\n    W.sort(reverse=True)\n    \n    total_sum = 0\n    \n    # Iterate through the sorted lists\n    for b, w in zip(B, W):\n        # Add the smaller value to the total sum\n        if b >= w:\n            total_sum += b\n        else:\n            break\n    \n    return total_sum\n\n# Read input\nN, M = map(int, input().split())\nB = list(map(int, input().split()))\nW = list(map(int, input().split()))\n\n# Calculate and print the result\nprint(max_value_sum(N, M, B, W))"}, "kind": "candidate", "prev": "53c1b2b6c89c687076b5350c8d7a683b19bd0843b71228c0cdd9fa8632ec62ba", "seq": 6}
