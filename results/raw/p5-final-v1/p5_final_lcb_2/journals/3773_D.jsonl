{"data": {"id": "7241c14b46b305c8e29b700fa9d7c80a6c43e832166799ededdf861356b391d9", "lineage": "7241c14b46b305c8e29b700fa9d7c80a6c43e832166799ededdf861356b391d9", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def minimumPairRemoval(self, nums: List[int]) -> int:\n        n = len(nums)\n        dp = [[float('inf')] * (n + 1) for _ in range(n + 1)]\n        dp[0][0] = 0\n        \n        for i in range(1, n + 1):\n            for j in range(i + 1):\n                if j == 0:\n                    dp[i][j] = min(dp[i - 1][j], abs(nums[i - 1]))\n                else:\n                    dp[i][j] = min(dp[i - 1][j], dp[i - 1][j - 1] + abs(nums[i - 1] - nums[j - 1]))\n        \n        return dp[n][n]"}, "kind": "candidate", "prev": "2d7fa19951a816d085b8787a45ac3d6cc3b6fbdbaf5e454fb3a188ec7b96e02d", "seq": 21}
