{"data": {"n": 4, "prompt_sha": ["4781e355090b6d1a1abd19a009284b222b38c1ab6f807b864018dea441ba0bc0"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "b7e30886e2e1c50ac4bb5ea5938205649e461a249a7e481467110c7dc3d9960f", "seq": 5}
{"data": {"id": "dfdc6d771d98d954c7e51884fbe226e140c01b04e3f2f44f72a5c09ac7fa0556", "lineage": "dfdc6d771d98d954c7e51884fbe226e140c01b04e3f2f44f72a5c09ac7fa0556", "origin": "sample:1", "parent": null, "source": "def is_snake_number(n):\n    digits = [int(digit) for digit in str(n)]\n    return digits[0] > max(digits[1:]) and len(set(digits)) == len(digits)\n\ndef count_snake_numbers(L, R):\n    count = 0\n    for num in range(L, R + 1):\n        if is_snake_number(num):\n            count += 1\n    return count\n\nL, R = map(int, input().split())\nprint(count_snake_numbers(L, R))"}, "kind": "candidate", "prev": "8636286fce9cb698b5225a54fc2d468dbc0670b41997e2ec9f0ec28df3daaf69", "seq": 6}
