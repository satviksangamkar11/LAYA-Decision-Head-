{"data": {"id": "77da329f37fc858daa9e07c5ec7b171c59c44e4a0476be8a2bc1ae8a663a0060", "lineage": "77da329f37fc858daa9e07c5ec7b171c59c44e4a0476be8a2bc1ae8a663a0060", "origin": "sample:4", "parent": null, "source": "def count_snake_numbers(L, R):\n    count = 0\n    for num in range(L, R + 1):\n        str_num = str(num)\n        if len(str_num) == 1:\n            continue\n        is_snake = True\n        max_digit = int(str_num[0])\n        for digit in str_num[1:]:\n            if digit >= max_digit:\n                is_snake = False\n                break\n            max_digit = max(max_digit, int(digit))\n        if is_snake:\n            count += 1\n    return count\n\n# Example usage:\nL, R = map(int, input().split())\nprint(count_snake_numbers(L, R))"}, "kind": "candidate", "prev": "ec96ca88bc4b17d4dcf68a11d3cbb75f196026fd9ea6dedb8ff5acc818e9762e", "seq": 24}
