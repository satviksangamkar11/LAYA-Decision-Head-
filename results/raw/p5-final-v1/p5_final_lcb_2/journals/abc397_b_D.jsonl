{"data": {"id": "258a7c68dc4bc80468b876ab3a55061d251a4c2bb409ffb08fa4f1ddc5df5b5b", "lineage": "258a7c68dc4bc80468b876ab3a55061d251a4c2bb409ffb08fa4f1ddc5df5b5b", "origin": "sample:2", "parent": null, "source": "def min_insertions(s):\n    odd_count = sum(1 for char in s if (s.index(char) + 1) % 2 != 0)\n    even_count = len(s) - odd_count\n    return max(even_count, odd_count)\n\n# Test cases\nprint(min_insertions(\"ioi\"))  # Output: 1\nprint(min_insertions(\"iioo\")) # Output: 2\nprint(min_insertions(\"io\"))   # Output: 0"}, "kind": "candidate", "prev": "6230ec51479995edbe9335af4a6a77946096e2c1f71cdbe0faf11ef8fb4de15e", "seq": 12}
