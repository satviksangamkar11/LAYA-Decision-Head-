{"data": {"id": "a33c153050f48cacfdda352f19760ab18202a448fa10823559f8b0ab3e58e5be", "lineage": "a33c153050f48cacfdda352f19760ab18202a448fa10823559f8b0ab3e58e5be", "origin": "sample:4", "parent": null, "source": "def min_insertions(S):\n    n = len(S)\n    if n % 2 == 0:\n        return 0\n    \n    # Check if the string can be made even by inserting characters\n    for i in range(n - 1, -1, -1):\n        if S[i] != S[i + 1]:\n            return i + 1\n    \n    # If no such position exists, insert characters at both ends\n    return n\n\n# Example usage\nprint(min_insertions(\"ioi\"))  # Output: 1\nprint(min_insertions(\"iioo\")) # Output: 2\nprint(min_insertions(\"io\"))   # Output: 0"}, "kind": "candidate", "prev": "f6c5011c08edcf62c63c5ee6ae45bba4471b144b9098d6c954f6b3f32200287b", "seq": 24}
