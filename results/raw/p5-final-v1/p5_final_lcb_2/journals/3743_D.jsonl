{"data": {"id": "354045d1c30f8f9e24877e3892d41ebd8ecd147990925cc9a8e57dc1013a2a1a", "lineage": "354045d1c30f8f9e24877e3892d41ebd8ecd147990925cc9a8e57dc1013a2a1a", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport heapq\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        # Sort the start and end times of the meetings\n        events = sorted(zip(startTime, endTime))\n        \n        # Initialize variables for tracking the current available time and the total free time\n        cur_time = 0\n        total_free_time = 0\n        \n        # Iterate through the sorted events\n        for start, end in events:\n            # If there are more than k meetings remaining, move the start time of the next meeting forward\n            if k > 0 and cur_time < start:\n                cur_time = start + eventTime\n                k -= 1\n            \n            # Update the current available time to the end time of the current meeting\n            cur_time = max(cur_time, end)\n            \n            # Calculate the free time between the previous end time and the current start time\n            if k == 0:\n                total_free_time += cur_time - start\n        \n        return total_free_time"}, "kind": "candidate", "prev": "414b390686fa82af41989e3aca361c12c9b9383893057ff7972255aace9548a6", "seq": 18}
