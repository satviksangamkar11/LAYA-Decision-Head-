{"data": {"id": "b7d19ce5416a4f16b1d8d262d8da4890b37c3adc4f07bda0172ab2ea5df01781", "lineage": "b7d19ce5416a4f16b1d8d262d8da4890b37c3adc4f07bda0172ab2ea5df01781", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        # Sort the meetings based on start time\n        events = sorted(zip(startTime, endTime))\n        \n        # Initialize variables\n        free_time = 0\n        current_free_time = 0\n        \n        for start, end in events:\n            # If there are more than k overlapping meetings, find the one with the smallest end time\n            if current_free_time + eventTime > end:\n                if k > 0:\n                    k -= 1\n                    current_free_time = end\n                else:\n                    break\n            # Update the current free time\n            current_free_time = max(current_free_time, end)\n        \n        return free_time"}, "kind": "candidate", "prev": "16c5ada332117dd60530b48b52035e5e447ecba3d2e117073e8063d1e3642f87", "seq": 24}
