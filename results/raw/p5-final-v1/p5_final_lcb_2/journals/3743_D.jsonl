{"data": {"id": "d109fe8b63094ef1ef5d5c4a531fccbc30513623a12fe893ea234a91b11268f1", "lineage": "d109fe8b63094ef1ef5d5c4a531fccbc30513623a12fe893ea234a91b11268f1", "origin": "sample:2", "parent": null, "source": "from typing import List\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        # Sort the start and end times\n        sorted_start_times = sorted(startTime)\n        sorted_end_times = sorted(endTime)\n        \n        # Initialize variables\n        free_time = 0\n        current_free_time = 0\n        \n        # Iterate through the sorted start times\n        for start, end in zip(sorted_start_times, sorted_end_times):\n            if start > eventTime:\n                # If the start time exceeds the event time, we cannot schedule any more meetings\n                break\n            current_free_time += end - start\n            # Check if we have used up all available meetings\n            if k > 0:\n                # Reduce the remaining free time by the duration of the current meeting\n                current_free_time -= min(eventTime - start, eventTime - end)\n                k -= 1\n        \n        return free_time"}, "kind": "candidate", "prev": "bc0fb2cef2b287ec5accafa9013ea6a98496e153ee508b942b05826c40ee4127", "seq": 12}
