{"data": {"n": 4, "prompt_sha": ["b81a7bc22f14bc3e8a73a2a1a4ce6d3ddf22ee77f161ec27bf4cb9efd3b6b574"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "221fee928e7a0bd8c53c293679c8b052bcb5d17feb3023c45398b456739a4fdd", "seq": 5}
{"data": {"id": "8e97328fb4441b1793c27c4b9fa865ea67a1d7f9ac7e3890eb456ef1ae8a6f1c", "lineage": "8e97328fb4441b1793c27c4b9fa865ea67a1d7f9ac7e3890eb456ef1ae8a6f1c", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        # Sort the meetings based on their start times\n        meetings = sorted(zip(startTime, endTime))\n        \n        # Initialize variables\n        available_time = eventTime\n        free_time = 0\n        \n        # Iterate through the sorted meetings\n        for start, end in meetings:\n            # If there's enough available time, adjust it\n            if available_time >= end:\n                available_time -= end - start\n            else:\n                # If there isn't enough available time, find the minimum time needed to make space\n                min_time_needed = end - start\n                # Check if we have enough rescheduling opportunities\n                if k > 0:\n                    k -= 1\n                    # Adjust available time accordingly\n                    available_time -= min_time_needed\n                    # Add the remaining available time to free time\n                    free_time += available_time\n                else:\n                    break\n        \n        return free_time"}, "kind": "candidate", "prev": "5a386ef5d392bc0982606092559a21f3d1f4d7f632b4e9bcfdfaa3a21ab62bd5", "seq": 6}
