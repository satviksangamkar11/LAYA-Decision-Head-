{"data": {"id": "d78b19a893bcf554d0c155113e0caac9ae27827c04e142bd803203c7e20a6017", "lineage": "5059ea8a1260ea664ede61d7bc7d1efe9a2ade94d6edb5d06ded9bd13c79caa2", "origin": "repair:5059ea8a1260ea664ede61d7bc7d1efe9a2ade94d6edb5d06ded9bd13c79caa2", "parent": "5059ea8a1260ea664ede61d7bc7d1efe9a2ade94d6edb5d06ded9bd13c79caa2", "source": "import math\n\ndef count_squares(R):\n    count = 0\n    # Iterate over the range of possible centers of squares\n    for i in range(-R, R + 1):\n        for j in range(-R, R + 1):\n            # Calculate the radius squared of the square centered at (i, j)\n            radius_squared = R ** 2 - (i ** 2 + j ** 2)\n            # Check if the radius squared is non-negative\n            if radius_squared >= 0:\n                # Calculate the side length of the square\n                side_length = math.sqrt(radius_squared)\n                # Count the number of squares that can fit along each axis\n                count += 2 * int(side_length) + 1\n    return count\n\nR = int(input())\nprint(count_squares(R))"}, "kind": "candidate", "prev": "e639d2d9f27e90f692e591967892329c0648779bf60f0e1bf08d8587561bebcb", "seq": 44}
