{"data": {"id": "efe00e024fa9b2987d40a402f23d04385a3f22e266df50ca888aabb82f27051f", "lineage": "8e97328fb4441b1793c27c4b9fa865ea67a1d7f9ac7e3890eb456ef1ae8a6f1c", "origin": "repair:8e97328fb4441b1793c27c4b9fa865ea67a1d7f9ac7e3890eb456ef1ae8a6f1c", "parent": "8e97328fb4441b1793c27c4b9fa865ea67a1d7f9ac7e3890eb456ef1ae8a6f1c", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxFreeTime(self, eventTime: int, k: int, startTime: List[int], endTime: List[int]) -> int:\n        # Sort the meetings based on their start times\n        meetings = sorted(zip(startTime, endTime))\n        \n        # Initialize variables\n        available_time = eventTime\n        free_time = 0\n        \n        # Iterate through the sorted meetings\n        for start, end in meetings:\n            # If there's enough available time, adjust it\n            if available_time >= end:\n                available_time -= end - start\n            else:\n                # If there isn't enough available time, find the minimum time needed to make space\n                min_time_needed = end - start\n                # Check if we have enough rescheduling opportunities\n                if k > 0:\n                    k -= 1\n                    # Adjust available time accordingly\n                    available_time -= min_time_needed\n                    # Add the remaining available time to free time\n                    free_time += available_time\n                else:\n                    # If there are no more rescheduling opportunities and there's still available time, add it to free time\n                    if available_time > 0:\n                        free_time += available_time\n                    break\n        \n        return free_time"}, "kind": "candidate", "prev": "1f9a7e6b0fea98edd3eab640fb330421d71f65702ea4c5b927b8041253b554da", "seq": 33}
