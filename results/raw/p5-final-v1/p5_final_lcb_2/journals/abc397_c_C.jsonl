{"data": {"id": "78988c7217c0752cd9aeb0610950296a419e9bbdd5eeeee0bf6618725c680c7b", "lineage": "78988c7217c0752cd9aeb0610950296a419e9bbdd5eeeee0bf6618725c680c7b", "origin": "sample:2", "parent": null, "source": "import sys\nfrom collections import Counter\n\ndef max_distinct_count(N, A):\n    # Initialize variables\n    max_sum = 0\n    current_sum = 0\n    current_count = Counter()\n    \n    # Iterate through the array\n    for i in range(1, N):\n        # Add the current element to the current count\n        current_count[A[i]] += 1\n        \n        # Update the current sum\n        current_sum += len(current_count)\n        \n        # Update the maximum sum if necessary\n        max_sum = max(max_sum, current_sum)\n    \n    return max_sum\n\n# Read input\nN = int(sys.stdin.readline())\nA = list(map(int, sys.stdin.readline().split()))\n\n# Print the result\nprint(max_distinct_count(N, A))"}, "kind": "candidate", "prev": "df02a6844a78b19facdf8e26e532043450963edb26b5efaf40dc75d78c753ca9", "seq": 11}
