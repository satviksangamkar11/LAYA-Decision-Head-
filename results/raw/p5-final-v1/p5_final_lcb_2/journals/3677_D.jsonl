{"data": {"id": "cb1496bad6bdfb3ff1e62cfba5e9b4117f4f0d2c0945e45505cebed47ec4f8fb", "lineage": "cb1496bad6bdfb3ff1e62cfba5e9b4117f4f0d2c0945e45505cebed47ec4f8fb", "origin": "sample:2", "parent": null, "source": "from typing import *\nimport collections\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        rows, cols = len(coins), len(coins[0])\n        dp = [[0] * cols for _ in range(rows)]\n        \n        # Base case: starting position\n        dp[0][0] = coins[0][0]\n        \n        # Fill the first row\n        for j in range(1, cols):\n            dp[0][j] = dp[0][j-1] + coins[0][j]\n        \n        # Fill the first column\n        for i in range(1, rows):\n            dp[i][0] = dp[i-1][0] + coins[i][0]\n        \n        # Fill the rest of the matrix\n        for i in range(1, rows):\n            for j in range(1, cols):\n                dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + coins[i][j]\n        \n        return dp[-1][-1]"}, "kind": "candidate", "prev": "56e68f02b711c011078dcf9815c4938f3bf975cd18c04cb09fffd944974a4df5", "seq": 12}
