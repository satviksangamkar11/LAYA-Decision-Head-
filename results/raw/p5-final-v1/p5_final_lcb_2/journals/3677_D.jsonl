{"data": {"n": 4, "prompt_sha": ["745553bc5941b3971b649f183b6c750b3f8286af990e68c30d8ae04e513c524b"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "8b097e2c96ae61e557a3321eca2e0a943e69ce433ad458579d6e61841fc85822", "seq": 5}
{"data": {"id": "569b1aafc3c3eb499818eccd0740b3139bc5ebc30248d17b9c9499dfdf710b26", "lineage": "569b1aafc3c3eb499818eccd0740b3139bc5ebc30248d17b9c9499dfdf710b26", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        m, n = len(coins), len(coins[0])\n        \n        # Initialize the DP table\n        dp = [[0] * n for _ in range(m)]\n        \n        # Base case: start position\n        dp[0][0] = coins[0][0]\n        \n        # Fill the first row\n        for j in range(1, n):\n            dp[0][j] = dp[0][j-1] + coins[0][j]\n        \n        # Fill the first column\n        for i in range(1, m):\n            dp[i][0] = dp[i-1][0] + coins[i][0]\n        \n        # Fill the rest of the DP table\n        for i in range(1, m):\n            for j in range(1, n):\n                # Choose the maximum between moving right or moving down\n                if coins[i][j] >= 0:\n                    dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + coins[i][j]\n                else:\n                    # If encountering a robber, consider two neutralizations\n                    dp[i][j] = max(\n                        dp[i-1][j] + coins[i][j],\n                        dp[i][j-1] + coins[i][j],\n                        dp[i-2][j] + coins[i][j],\n                        dp[i-2][j-1] + coins[i][j]\n                    )\n        \n        return dp[m-1][n-1]"}, "kind": "candidate", "prev": "5add554b174a435f202404ef5dac561f22547f9535a19409a7dcf7fd80702db2", "seq": 6}
