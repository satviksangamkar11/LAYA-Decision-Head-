{"data": {"id": "7dfe3171b8940e160eb60278f45f835070558a1ea98633e1004f192f3dbe52dc", "lineage": "7dfe3171b8940e160eb60278f45f835070558a1ea98633e1004f192f3dbe52dc", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport collections\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        m, n = len(coins), len(coins[0])\n        \n        # Initialize DP table with negative infinity\n        dp = [[float('-inf')] * n for _ in range(m)]\n        \n        # Base case: Starting from the top-left corner\n        dp[0][0] = coins[0][0]\n        \n        # Fill the first row\n        for j in range(1, n):\n            dp[0][j] = dp[0][j-1] + coins[0][j]\n        \n        # Fill the first column\n        for i in range(1, m):\n            dp[i][0] = dp[i-1][0] + coins[i][0]\n        \n        # Fill the rest of the DP table\n        for i in range(1, m):\n            for j in range(1, n):\n                # Calculate the maximum profit considering neutralizing robbers\n                dp[i][j] = max(dp[i-1][j], dp[i][j-1]) + coins[i][j]\n        \n        return dp[-1][-1]"}, "kind": "candidate", "prev": "862b24d675578d2429b9a3de41b61caa83b30ef7615724bbda1d503cf0871c98", "seq": 17}
