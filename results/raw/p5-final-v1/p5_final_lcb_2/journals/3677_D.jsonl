{"data": {"id": "252a9c0bc0702e26462239406c9f1cfd102de790bc1cde00ac3c86f091a05cb4", "lineage": "252a9c0bc0702e26462239406c9f1cfd102de790bc1cde00ac3c86f091a05cb4", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maximumAmount(self, coins: List[List[int]]) -> int:\n        m, n = len(coins), len(coins[0])\n        \n        # Initialize DP table\n        dp = [[0] * n for _ in range(m)]\n        \n        # Base case: starting position\n        dp[0][0] = coins[0][0]\n        \n        # Fill DP table\n        for i in range(1, m):\n            dp[i][0] = dp[i-1][0] + coins[i][0]\n        for j in range(1, n):\n            dp[0][j] = dp[0][j-1] + coins[0][j]\n        \n        for i in range(1, m):\n            for j in range(1, n):\n                # Calculate the maximum profit for each cell\n                left = dp[i-1][j] if i > 0 else float('-inf')\n                up = dp[i][j-1] if j > 0 else float('-inf')\n                \n                # Neutralize robbers if possible\n                if i > 1 and coins[i-2][j] >= 0:\n                    left += coins[i-2][j]\n                if j > 1 and coins[i][j-2] >= 0:\n                    up += coins[i][j-2]\n                \n                dp[i][j] = max(left, up) + coins[i][j]\n        \n        return dp[m-1][n-1]"}, "kind": "candidate", "prev": "5820f0afcd9347f456bb02c693ca981af8ba60f44e5851fdc6e354a86f929f71", "seq": 22}
