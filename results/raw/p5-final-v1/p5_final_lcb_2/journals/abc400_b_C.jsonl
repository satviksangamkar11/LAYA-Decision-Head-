{"data": {"id": "3399a14c568e2ebbafc3241007b88a8eb7d3b95420fec9d28911a8099af2b7cc", "lineage": "3399a14c568e2ebbafc3241007b88a8eb7d3b95420fec9d28911a8099af2b7cc", "origin": "sample:4", "parent": null, "source": "def calculate_sum(N, M):\n    if N <= 0 or M <= 0:\n        return \"Invalid input\"\n    \n    # Calculate the sum using the formula for the sum of a geometric series\n    result = N * (1 - N**M) // (1 - N)\n    \n    # Check if the result exceeds 10^9 and print appropriate output\n    if result > 10**9:\n        return \"inf\"\n    else:\n        return result\n\n# Read input from stdin\ninput_data = input().split()\nN = int(input_data[0])\nM = int(input_data[1])\n\n# Calculate the sum and print the result\nprint(calculate_sum(N, M))"}, "kind": "candidate", "prev": "c6d7b05e454b23e341a405cfc0c9287042b1df6e9c5a0ab037c828a169ca7b10", "seq": 28}
