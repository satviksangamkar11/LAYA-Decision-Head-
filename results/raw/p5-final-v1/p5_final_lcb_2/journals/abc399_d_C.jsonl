{"data": {"id": "144bfde5d53014a216f0ec08d2e7a151e1248071e2a1afb82b45d6503a50b78c", "lineage": "0e3b1bba1a9554dee0f9db8a9f51bf1df655a71a702a31c6b9279f39c3b9f2d3", "origin": "repair:0e3b1bba1a9554dee0f9db8a9f51bf1df655a71a702a31c6b9279f39c3b9f2d3", "parent": "0e3b1bba1a9554dee0f9db8a9f51bf1df655a71a702a31c6b9279f39c3b9f2d3", "source": "from collections import Counter\n\ndef count_valid_pairs(N, A):\n    # Create a dictionary to count occurrences of each element\n    count = Counter(A)\n    \n    # Initialize the result counter\n    result = 0\n    \n    # Iterate through the counts\n    for num, freq in count.items():\n        # If the frequency is greater than 1, we can form valid pairs\n        if freq > 1:\n            # Check if we can swap the two occurrences of num to make them adjacent\n            if num + 1 in count and count[num + 1] >= 2:\n                result += freq * (freq - 1) // 2\n            \n            # Check if we can swap the two occurrences of num to make them adjacent\n            if num - 1 in count and count[num - 1] >= 2:\n                result += freq * (freq - 1) // 2\n    \n    return result\n\n# Read the number of test cases\nT = int(input())\n\n# Process each test case\nfor _ in range(T):\n    N = int(input())\n    A = list(map(int, input().split()))\n    \n    # Count the valid pairs\n    ans = count_valid_pairs(N, A)\n    \n    # Print the result\n    print(ans)"}, "kind": "candidate", "prev": "21011b5cf840d19cb1b763795cbadc3e604e9e8b516aa1958c266432701a7f30", "seq": 22}
