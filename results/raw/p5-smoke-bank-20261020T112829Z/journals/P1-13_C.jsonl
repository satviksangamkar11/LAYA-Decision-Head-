{"data": {"id": "cf368b30c32f212e47a7632baa8e1fdec06340cac140c67271b8f40eb3b598e5", "lineage": "cf368b30c32f212e47a7632baa8e1fdec06340cac140c67271b8f40eb3b598e5", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solve(self, data: Dict[str, str]) -> int:\n        text = data[\"text\"]\n        if not text:\n            return 0\n        \n        max_length = 0\n        left = 0\n        char_set = set()\n        \n        for right in range(len(text)):\n            while text[right] in char_set:\n                char_set.remove(text[left])\n                left += 1\n            \n            char_set.add(text[right])\n            max_length = max(max_length, right - left + 1)\n        \n        return max_length"}, "kind": "candidate", "prev": "d48a88c90f75256cc98d764273268470defd42314e2736e6825a297c1b757990", "seq": 6}
