{"data": {"id": "d6b5d07ce17c3dd8d5d522d603a85a359d931bba7498d41154b5faf10f4fde9b", "lineage": "d6b5d07ce17c3dd8d5d522d603a85a359d931bba7498d41154b5faf10f4fde9b", "origin": "sample:3", "parent": null, "source": "def solve(data):\n    text = data[\"text\"]\n    if not text:\n        return 0\n    \n    left, right = 0, 0\n    max_length = 0\n    char_set = set()\n    \n    while right < len(text):\n        while text[right] in char_set:\n            char_set.remove(text[left])\n            left += 1\n        \n        char_set.add(text[right])\n        max_length = max(max_length, right - left + 1)\n        right += 1\n    \n    return max_length\n\n# Test cases\ntest_cases = [\n    {\"text\": \"\", \"expected_output\": 0},\n    {\"text\": \"abcabcbb\", \"expected_output\": 3},\n    {\"text\": \"bbbb\", \"expected_output\": 1},\n    {\"text\": \"pwwkew\", \"expected_output\": 3}\n]\n\nfor test_case in test_cases:\n    result = solve(test_case)\n    assert result == test_case[\"expected_output\"], f\"Test failed for input {test_case['text']}. Expected {test_case['expected_output']}, got {result}\"\nprint(\"All tests passed!\")"}, "kind": "candidate", "prev": "a2979df276c0f1301c5efb0e0993e08bdbb5247b90fb7619423772feca04e441", "seq": 22}
