{"data": {"id": "91ace90daebb25b2d631e4112373de757e39c2ba8287b9fe3ec22755409e957d", "lineage": "91ace90daebb25b2d631e4112373de757e39c2ba8287b9fe3ec22755409e957d", "origin": "sample:1", "parent": null, "source": "def solve(data):\n    text = data['text']\n    if not text:\n        return 0\n    \n    left, right, max_length = 0, 0, 0\n    char_set = set()\n    \n    while right < len(text):\n        if text[right] in char_set:\n            while text[left] != text[right]:\n                char_set.remove(text[left])\n                left += 1\n            left += 1\n        else:\n            char_set.add(text[right])\n            right += 1\n        max_length = max(max_length, right - left)\n    \n    return max_length"}, "kind": "candidate", "prev": "5f82870a0fb13c422177124231ae885e7d8337bd172efc785c29fd6b2702a3a2", "seq": 6}
