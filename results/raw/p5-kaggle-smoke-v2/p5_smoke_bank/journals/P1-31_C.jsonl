{"data": {"notes": [], "reqs": [{"kind": "contract", "priority": "hard", "requirement_id": "R1", "source": {"type": "task_metadata"}, "status": "active", "text": "Entry point `solve` in language python, within the stated limits.", "version": 1}, {"kind": "explicit", "priority": "hard", "requirement_id": "R2", "source": {"char_end": 126, "char_start": 0, "quote": "Input {\"a\": string, \"b\": string}. Return minimum number of unit-cost insertions, deletions and substitutions to turn a into b.", "type": "request_span"}, "status": "active", "text": "The program is correct on all legal inputs of the statement.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R3", "source": {"char_end": 173, "char_start": 138, "quote": "Input:\n{\"a\": \"\", \"b\": \"\"}\nOutput:\n0", "type": "request_span"}, "status": "active", "text": "Public example 1: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R4", "source": {"char_end": 233, "char_start": 185, "quote": "Input:\n{\"a\": \"kitten\", \"b\": \"sitting\"}\nOutput:\n3", "type": "request_span"}, "status": "active", "text": "Public example 2: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R5", "source": {"char_end": 283, "char_start": 245, "quote": "Input:\n{\"a\": \"abc\", \"b\": \"\"}\nOutput:\n3", "type": "request_span"}, "status": "active", "text": "Public example 3: output exactly the quoted output for the quoted input.", "version": 1}, {"kind": "explicit", "priority": "functional", "requirement_id": "R6", "source": {"char_end": 332, "char_start": 295, "quote": "Input:\n{\"a\": \"a\", \"b\": \"b\"}\nOutput:\n1", "type": "request_span"}, "status": "active", "text": "Public example 4: output exactly the quoted output for the quoted input.", "version": 1}], "request_sha": "950eaeeee08831fc2018421957fdb20c16fa9d3f3140705d95