{"data": {"id": "c391c2c1823c27957d47e595e417a0d7a9ebb323382f500628b57d7a68751778", "lineage": "c391c2c1823c27957d47e595e417a0d7a9ebb323382f500628b57d7a68751778", "origin": "sample:4", "parent": null, "source": "from typing import *\nimport json\n\ndef solve(data):\n    a = data[\"a\"]\n    b = data[\"b\"]\n\n    if not a or not b:\n        return len(a) + len(b)\n\n    # Initialize DP table\n    dp = [[0] * (len(b)+1) for _ in range(len(a)+1)]\n\n    # Fill DP table\n    for i in range(1, len(a)+1):\n        for j in range(1, len(b)+1):\n            if a[i-1] == b[j-1]:\n                dp[i][j] = dp[i-1][j-1]\n            else:\n                dp[i][j] = min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1]) + 1\n\n    return dp[-1][-1]\n\n# Test cases\nprint(json.dumps(solve({\"a\": \"\", \"b\": \"\"})))  # Output: 0\nprint(json.dumps(solve({\"a\": \"kitten\", \"b\": \"sitting\"})))  # Output: 3\nprint(json.dumps(solve({\"a\": \"abc\", \"b\": \"\"})))  # Output: 3\nprint(json.dumps(solve({\"a\": \"a\", \"b\": \"b\"})))  # Output: 1"}, "kind": "candidate", "prev": "2714f03a9298ca22c9fe29ee7204de87cd673cd40eca16bd26a4c41455884364", "seq": 30}
