{"data": {"id": "14499689f7a05073b071f6b2a4e005348172328bb063adb497f9d902a6791153", "lineage": "14499689f7a05073b071f6b2a4e005348172328bb063adb497f9d902a6791153", "origin": "sample:3", "parent": null, "source": "from typing import *\nimport json\n\ndef solve(data):\n    def edit_distance(a, b):\n        if not a:\n            return len(b)\n        if not b:\n            return len(a)\n        if a[0] == b[0]:\n            return edit_distance(a[1:], b[1:])\n        else:\n            return 1 + min(edit_distance(a[1:], b), edit_distance(a, b[1:]), edit_distance(a[1:], b[1:]))\n\n    return edit_distance(data[\"a\"], data[\"b\"])"}, "kind": "candidate", "prev": "c7e1297e7cd38832006f90f96996c4019911e93137f04d7a65746b3352c95565", "seq": 22}
