{"data": {"id": "d4c19fd93c56415cec8dc73458b574d42118e26e28c4f06c87f3144855081598", "lineage": "d4c19fd93c56415cec8dc73458b574d42118e26e28c4f06c87f3144855081598", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        if len(nums) < k*m:\n            return float('-inf')\n        \n        dp = [[0]*m for _ in range(k)]\n        prefix_sum = [0]\n        for i in range(len(nums)):\n            prefix_sum.append(prefix_sum[-1] + nums[i])\n            \n        for i in range(1, k+1):\n            for j in range(m):\n                if j == 0:\n                    dp[i][j] = prefix_sum[i+m-1] - prefix_sum[i-1]\n                else:\n                    dp[i][j] = max(dp[i-1][j], dp[i-1][j-1] + prefix_sum[i+m-1] - prefix_sum[i-1])\n        \n        return dp[k][m-1]"}, "kind": "candidate", "prev": "c4cba10dc3ed777b114be905c20b1c8569df248cde93726925e0e4b14f534bf4", "seq": 21}
