{"data": {"id": "298d1c71eefaa96cde68d951a39eef6d97dd5f2498263126ce6049031397bc6b", "lineage": "628583f7e682f4c51e5f393a2fc7924ab288e9e292b9d4b2a4b9a446cd7d74b5", "origin": "repair:628583f7e682f4c51e5f393a2fc7924ab288e9e292b9d4b2a4b9a446cd7d74b5", "parent": "628583f7e682f4c51e5f393a2fc7924ab288e9e292b9d4b2a4b9a446cd7d74b5", "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        if len(nums) < k * m:\n            return -inf\n        \n        # Calculate the prefix sums\n        prefix_sums = [0] * (len(nums) + 1)\n        for i in range(1, len(prefix_sums)):\n            prefix_sums[i] = prefix_sums[i - 1] + nums[i - 1]\n        \n        # Initialize variables to keep track of the maximum sum and the current sum\n        max_sum = float('-inf')\n        current_sum = 0\n        \n        # Iterate through the array to find the maximum sum of k non-overlapping subarrays\n        for i in range(k - 1, len(prefix_sums)):\n            # Check if the current subarray can be added to the previous one without violating the condition\n            if i - k + 1 > 0:\n                current_sum += prefix_sums[i - k + 1] - prefix_sums[i - k]\n            \n            # Ensure the current subarray does not overlap with the previous one\n            while i - k + 1 > 0 and i - k + 1 + m <= len(nums):\n                current_sum -= prefix_sums[i - k + 1 + m - 1] - prefix_sums[i - k + 1 - 1]\n            \n            # Update the maximum sum if necessary\n            max_sum = max(max_sum, current_sum)\n        \n        return max_sum"}, "kind": "candidate", "prev": "b5a0746cc2eaa655b2d6e1d0a0af885d211cc390afb9fa1183b56e7c593e4fbf", "seq": 29}
