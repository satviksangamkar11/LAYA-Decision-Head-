{"data": {"id": "e1e5b12587c353cca8805a4d162846ee300126b565b98147b1de7884d232b14c", "lineage": "e1e5b12587c353cca8805a4d162846ee300126b565b98147b1de7884d232b14c", "origin": "sample:2", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        # Initialize variables to store the current sum, maximum sum, and the start index of the last subarray\n        curr_sum = 0\n        max_sum = float('-inf')\n        start_index = 0\n        \n        # Iterate through the array starting from the first index\n        for i in range(len(nums)):\n            # Add the current element to the current sum\n            curr_sum += nums[i]\n            \n            # If the current sum is greater than the maximum sum found so far\n            if curr_sum > max_sum:\n                # Update the maximum sum\n                max_sum = curr_sum\n                \n                # Check if the number of elements processed so far is greater than or equal to k\n                if i - start_index + 1 >= k:\n                    # Calculate the sum of the last subarray\n                    last_subarray_sum = sum(nums[start_index:i])\n                    \n                    # If the sum of the last subarray is less than m, skip it\n                    if last_subarray_sum < m:\n                        continue\n                    \n                    # Reset the current sum to the sum of the last subarray\n                    curr_sum = last_subarray_sum\n            \n            # If the current sum exceeds the maximum sum found so far, reset the current sum to zero\n            elif curr_sum > max_sum:\n                curr_sum = 0\n        \n        return max_sum"}, "kind": "candidate", "prev": "7e4b99b4781ca024c157519ed49f0c400076b3559c9f13395bc104658cfb3f84", "seq": 11}
