{"data": {"n": 4, "prompt_sha": ["f455fb048418d2985b2ba0ffcbb1b27d334f8c772f75beb8a64b387c4a3d686d"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "c5461a20a38024d5e40d5c66a66bfe387104da820422a0da209d98b4b2915a8d", "seq": 5}
{"data": {"id": "c818d38ab36fb777d2f6450a6d4c39be17b13421b6ff58f89db569199cd1002c", "lineage": "c818d38ab36fb777d2f6450a6d4c39be17b13421b6ff58f89db569199cd1002c", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def maxSum(self, nums: List[int], k: int, m: int) -> int:\n        n = len(nums)\n        dp = [[0] * (k+1) for _ in range(n)]\n        \n        # Base case: first subarray\n        for i in range(m):\n            dp[i][1] = nums[i]\n        \n        # Fill the DP table\n        for i in range(m, n):\n            for j in range(2, k+1):\n                dp[i][j] = max(dp[i-m][j-1] + nums[i], dp[i-1][j])\n        \n        return max(dp[-1])"}, "kind": "candidate", "prev": "09a6495af5e833662796c0c7f94bc6d0035ee66ee07f656d512b30779d9f94af", "seq": 6}
