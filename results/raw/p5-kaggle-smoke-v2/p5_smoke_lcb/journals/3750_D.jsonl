{"data": {"id": "30f6a7d4112363b42e0c76dcc9abb4b5a320684a5fc023719b950f39677cf68e", "lineage": "30f6a7d4112363b42e0c76dcc9abb4b5a320684a5fc023719b950f39677cf68e", "origin": "sample:4", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        # Create a dictionary to store the indices of each number\n        num_indices = defaultdict(list)\n        for i, num in enumerate(nums):\n            num_indices[num].append(i)\n        \n        result = []\n        for q in queries:\n            # Find the leftmost occurrence of the current number\n            left_index = bisect.bisect_left(num_indices[q], q)\n            if left_index < len(num_indices[q]):\n                left_dist = abs(q - num_indices[q][left_index])\n            else:\n                left_dist = len(nums) + abs(q - num_indices[q][-1])\n            \n            # Find the rightmost occurrence of the current number\n            right_index = bisect.bisect_right(num_indices[q], q)\n            if right_index > 0:\n                right_dist = abs(q - num_indices[q][right_index - 1])\n            else:\n                right_dist = len(nums) + abs(q - num_indices[q][0])\n            \n            # Take the minimum distance\n            result.append(min(left_dist, right_dist))\n        \n        return result"}, "kind": "candidate", "prev": "8e9d7761c2682cec8990eec5ce3cdb1ae2076075671e35fc3f795cd62d839db6", "seq": 21}
