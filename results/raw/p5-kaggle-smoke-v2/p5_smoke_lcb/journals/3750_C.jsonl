{"data": {"n": 4, "prompt_sha": ["6dd5d6eec1e21cf12efe388ea14c32aca6bcf095d86876fa87d8f5786900bd1c"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "e87ef5ee741c8b058b13f1be22b59ce7b8039a17dd6ba1698df407ba3833f1d2", "seq": 5}
{"data": {"id": "a479fd87a92429df7aa7609763d53c1b2cd4fc4576afca5875eaac04db375218", "lineage": "a479fd87a92429df7aa7609763d53c1b2cd4fc4576afca5875eaac04db375218", "origin": "sample:1", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        # Dictionary to store the first occurrence of each number\n        num_to_index = {}\n        # Dictionary to store the last occurrence of each number\n        num_to_last_index = {}\n\n        # Populate the dictionaries\n        for i, num in enumerate(nums):\n            if num not in num_to_index:\n                num_to_index[num] = i\n            num_to_last_index[num] = i\n\n        # Result list to store the answers\n        ans = []\n\n        # Process each query\n        for query in queries:\n            num = nums[query]\n            # Find the closest index to the current query\n            left = max(num_to_index[num], query - n + 1)\n            right = min(num_to_last_index[num], query + n - 1)\n            # Calculate the distance and add it to the result list\n            ans.append(min(right - left + 1, n - (right - left + 1)))\n            \n        return ans"}, "kind": "candidate", "prev": "f3d577383ee5a8831db3fb9c2b2828891fbd557baaafb4820c78c617107fc758", "seq": 6}
