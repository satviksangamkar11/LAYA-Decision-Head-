{"data": {"id": "de4c8378e961ad7fbc466fbf01dfee724efda723f5d973fa141ae4e119a12596", "lineage": "de4c8378e961ad7fbc466fbf01dfee724efda723f5d973fa141ae4e119a12596", "origin": "sample:3", "parent": null, "source": "from typing import *\nfrom collections import *\n\nclass Solution:\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\n        n = len(nums)\n        ans = []\n        pos = {}\n        for i in range(n):\n            if nums[i] not in pos:\n                pos[nums[i]] = [i]\n            else:\n                pos[nums[i]].append(i)\n                \n        for q in queries:\n            if q in pos:\n                distances = []\n                for p in pos[q]:\n                    if p > q:\n                        distances.append(n-p)\n                    else:\n                        distances.append(p)\n                ans.append(min(distances))\n            else:\n                ans.append(-1)\n        return ans"}, "kind": "candidate", "prev": "f487bc9e034161001e7cb0f68623d12f6ea7680d0a0874b6f273380b1d248d1b", "seq": 16}
