{"data": {"n": 4, "prompt_sha": ["e594ba1f3ddb2639603c36ceb808cfdfc93ce0a0042fab1bdc037a96d38972dc"], "purpose": "sample", "seeds": [1, 2, 3, 4], "templates": ["lcb_generic_v1"]}, "kind": "generation_request", "prev": "f43c3b805ef0b1e529ec10f80afff6048772d4d81b945b2e9e5274b8b2871f13", "seq": 5}
{"data": {"id": "1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "lineage": "1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            if s[i] == 'N':\n                prefix_sum[i + 1] = prefix_sum[i] + 1\n            elif s[i] == 'S':\n                prefix_sum[i + 1] = prefix_sum[i] - 1\n        \n        max_dist = 0\n        min_prefix_sum = float('inf')\n        for i in range(n + 1):\n            max_dist = max(max_dist, i - min_prefix_sum)\n            if i < n and prefix_sum[i + 1] < min_prefix_sum:\n                min_prefix_sum = prefix_sum[i + 1]\n        \n        return max_dist"}, "kind": "candidate", "prev": "b17a655664ecf82832e8c740901f1cfc6bba5efac8068c401250b1c44307e7fa", "seq": 6}
