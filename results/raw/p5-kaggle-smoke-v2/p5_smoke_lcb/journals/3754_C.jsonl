{"data": {"id": "a647411ed543a7e4f85d8bb5958fb292ea9ccda3efc1ecf491a7b4d68b585883", "lineage": "a647411ed543a7e4f85d8bb5958fb292ea9ccda3efc1ecf491a7b4d68b585883", "origin": "sample:2", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        dp = [[-1 for _ in range(k+1)] for _ in range(n)]\n        dp[0][k] = 0\n        \n        for i in range(1, n):\n            for j in range(k+1):\n                if j < k:\n                    dp[i][j] = max(dp[i-1][j], dp[i-1][j+1])\n                else:\n                    dp[i][j] = max(dp[i-1][j], dp[i-1][j-k] + abs(i-j))\n                \n                if s[i] == 'N':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j]+1)\n                elif s[i] == 'S':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j]-1)\n                elif s[i] == 'E':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j]+1)\n                elif s[i] == 'W':\n                    dp[i][j] = max(dp[i][j], dp[i-1][j]-1)\n        \n        return dp[n-1][k]"}, "kind": "candidate", "prev": "03eb46b22538e79311a3dba3d845c33c491f3e5479de48b3faa0ff0aca8db8a5", "seq": 11}
