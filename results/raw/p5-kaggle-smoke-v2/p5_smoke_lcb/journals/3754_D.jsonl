{"data": {"id": "1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "lineage": "1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "origin": "sample:1", "parent": null, "source": "class Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            if s[i] == 'N':\n                prefix_sum[i + 1] = prefix_sum[i] + 1\n            elif s[i] == 'S':\n                prefix_sum[i + 1] = prefix_sum[i] - 1\n        \n        max_dist = 0\n        min_prefix_sum = float('inf')\n        for i in range(n + 1):\n            max_dist = max(max_dist, i - min_prefix_sum)\n            if i < n and prefix_sum[i + 1] < min_prefix_sum:\n                min_prefix_sum = prefix_sum[i + 1]\n        \n        return max_dist"}, "kind": "candidate", "prev": "2c68cbced3f58b0fa2ff31357360cc8b41dd3b928ba152ed39b3b33eb97c73c4", "seq": 6}
