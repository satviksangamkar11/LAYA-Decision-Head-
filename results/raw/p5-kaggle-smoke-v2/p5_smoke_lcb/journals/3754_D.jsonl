{"data": {"evidence": {"artifact_hash": "2dcae93e8f94301943ffc95333f9ae11fc04a57df676b1dad1917528bd02e455", "candidate_id": "2dcae93e8f94301943ffc95333f9ae11fc04a57df676b1dad1917528bd02e455", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0009", "independence": "independent", "produced_at": "t9", "receipt_hash": "bfdbcde4041dfc0e34fe2ff7b0c3200783a10480f56c4e028dee0aef93ed5e92", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "e0ed1bc1fc849b2f29a167e1f0554d9b3775d7edfa9e91914541bd3458cc2991", "seq": 19}
{"data": {"answer_label": "BLOCKED", "candidate_id": "2dcae93e8f94301943ffc95333f9ae11fc04a57df676b1dad1917528bd02e455", "fails": 2, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED"}, "trusted_passes": 0, "validated_passes": 0}, "kind": "label", "prev": "7a665d881d8f71b6d21e0d7518d9497ea4ac7cd6132f7dd04de2488787a28393", "seq": 20}
{"data": {"id": "9481a0d7c7645a7d06918e9230ee2609d0ec0aa4d2b99b9511c554ffedfd3384", "lineage": "9481a0d7c7645a7d06918e9230ee2609d0ec0aa4d2b99b9511c554ffedfd3384", "origin": "sample:4", "parent": null, "source": "from collections import Counter\n\nclass Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        cnt = Counter(s)\n        # Calculate the total number of moves needed without changing any character\n        total_moves = len(s) - sum(cnt.values())\n        if total_moves > k:\n            return 0\n        \n        max_dist = 0\n        for i in range(len(s)):\n            # If we have enough changes left, try to maximize the distance\n            if i + k >= len(s):\n                max_dist = max(max_dist, abs(i - len(s)) + sum(cnt.values()))\n            else:\n                # Try to minimize the distance by changing one character\n                for j in range(i, i + k + 1):\n                    new_s = s[:j] + ('N' if s[j] == 'S' else 'S') + s[j+1:]\n                    new_cnt = Counter(new_s)\n                    total_changes = len(new_s) - sum(new_cnt.values())\n                    max_dist = max(max_dist, abs(j - len(s)) + sum(new_cnt.values()))\n        \n        return max_dist"}, "kind": "candidate", "prev": "354e9ab9a4d17043011f74d5da352b391b1068aecbc13307aeb492eee8c3f0fc", "seq": 21}
