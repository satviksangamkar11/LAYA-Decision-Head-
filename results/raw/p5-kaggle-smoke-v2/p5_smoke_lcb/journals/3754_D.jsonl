{"data": {"id": "eff40bde003a0cbafce22950ec20669b4a430adc0c738341efcbd87d8cdb31ff", "lineage": "1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "origin": "repair:1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "parent": "1c1dd44e9682e3e17f0589ca4b9a1bbab30b23f0d7ecd76c12193977f6074572", "source": "from collections import defaultdict\nimport heapq\n\nclass Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        n = len(s)\n        prefix_sum = [0] * (n + 1)\n        for i in range(n):\n            if s[i] == 'N':\n                prefix_sum[i + 1] = prefix_sum[i] + 1\n            elif s[i] == 'S':\n                prefix_sum[i + 1] = prefix_sum[i] - 1\n        \n        max_dist = 0\n        min_prefix_sum = float('inf')\n        min_index = 0\n        max_index = 0\n        heap = []\n        \n        for i in range(n + 1):\n            if i < n:\n                # Push current index into the heap\n                heapq.heappush(heap, (prefix_sum[i], i))\n                # Pop the smallest element from the heap\n                _, idx = heapq.heappop(heap)\n                if idx - min_index > k:\n                    min_index = idx\n                # Update the minimum prefix sum\n                min_prefix_sum = min(min_prefix_sum, prefix_sum[idx])\n            \n            # Calculate the maximum distance\n            max_dist = max(max_dist, i - min_index)\n        \n        return max_dist"}, "kind": "candidate", "prev": "e6316faa249603a68af2bad70bccaba28c0e55ea7d485e79b2350b55beba0e92", "seq": 29}
