{"data": {"evidence": {"artifact_hash": "a647411ed543a7e4f85d8bb5958fb292ea9ccda3efc1ecf491a7b4d68b585883", "candidate_id": "a647411ed543a7e4f85d8bb5958fb292ea9ccda3efc1ecf491a7b4d68b585883", "check_id": "public_examples_v1", "check_version": "1", "environment_revision": "env-0d07bb02cec0", "evidence_id": "E0006", "independence": "independent", "produced_at": "t6", "receipt_hash": "363896c19da80f30691f6951f9e4ecea70ed843b260bac75a8fe0fbed502ba99", "requirement_id": "R2", "requirement_version": 1, "scope": "public examples only; not a proof for all legal inputs", "source": "environment_observation", "status": "fail"}, "outcome": {"check_id": "public_examples_v1", "scope": "all_inputs_row", "status": "fail"}}, "kind": "evidence", "prev": "4011cf54ee21130782f3c3b44cdda975bbb2f034d094dc4f4130258fb47e6899", "seq": 14}
{"data": {"answer_label": "BLOCKED", "candidate_id": "a647411ed543a7e4f85d8bb5958fb292ea9ccda3efc1ecf491a7b4d68b585883", "fails": 2, "rows": {"R1": "UNVERIFIED", "R2": "UNVERIFIED", "R3": "FAILED", "R4": "FAILED"}, "trusted_passes": 0, "validated_passes": 0}, "kind": "label", "prev": "f42a37c4802b3f8eba5d732b97ea81e47803fdd2efe1778c5c1123c928848a2e", "seq": 15}
{"data": {"id": "2dcae93e8f94301943ffc95333f9ae11fc04a57df676b1dad1917528bd02e455", "lineage": "2dcae93e8f94301943ffc95333f9ae11fc04a57df676b1dad1917528bd02e455", "origin": "sample:3", "parent": null, "source": "from collections import Counter\n\nclass Solution:\n    def maxDistance(self, s: str, k: int) -> int:\n        # Initialize variables to keep track of the current position and the maximum distance\n        cur_x, cur_y = 0, 0\n        max_distance = 0\n        \n        # Count the frequency of each direction\n        direction_count = Counter(s)\n        \n        # Iterate through the string\n        for i, char in enumerate(s):\n            # Update the current position based on the character\n            if char == 'N':\n                cur_y += 1\n            elif char == 'S':\n                cur_y -= 1\n            elif char == 'E':\n                cur_x += 1\n            else:\n                cur_x -= 1\n            \n            # Calculate the current Manhattan distance\n            cur_manhattan = abs(cur_x) + abs(cur_y)\n            \n            # If the current Manhattan distance exceeds the allowed number of changes, update the maximum distance\n            if cur_manhattan > max_distance:\n                max_distance = cur_manhattan\n            \n            # If the number of remaining changes is less than the required number of changes for the current direction,\n            # adjust the current position to maximize the Manhattan distance\n            if i < len(s) - 1 and direction_count[char] < k:\n                if char == 'N':\n                    cur_y -= 1\n                elif char == 'S':\n                    cur_y += 1\n                elif char == 'E':\n                    cur_x -= 1\n                else:\n                    cur_x += 1\n                max_distance = max(max_distance, abs(cur_x) + abs(cur_y))\n        \n        return max_distance"}, "kind": "candidate", "prev": "245a3d5e2c0cbe5e4d728e815ae11717224746523dfb12529a084bee79c82b20", "seq": 16}
